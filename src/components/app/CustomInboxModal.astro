---
import Button from '../ui/Button.astro';
---

<div
  id="custom-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-3.5 sm:p-4 bg-black/60 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="custom-modal-title"
>
  <div class="relative w-full max-w-md max-h-[90vh] overflow-y-auto glass-panel p-5 sm:p-6 rounded-2xl sm:rounded-3xl shadow-2xl transform scale-95 transition-transform duration-200" id="custom-modal-content">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-full bg-[#ea2804]/10 text-[#ea2804] flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
          </svg>
        </div>
        <h3 id="custom-modal-title" class="font-display text-lg font-bold text-[#202020] dark:text-[#fcfcfc]">Custom Email Address</h3>
      </div>
      <button
        id="custom-modal-close"
        type="button"
        class="w-8 h-8 rounded-full flex items-center justify-center text-[#8d8d8d] hover:text-[#202020] dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/10 transition-colors"
        aria-label="Close custom email modal"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <p class="text-xs text-[#575757] dark:text-zinc-400 mb-5">
      Choose your preferred username and domain to create a personalized temporary inbox.
    </p>

    <form id="custom-inbox-form" class="space-y-4">
      <div>
        <label for="custom-prefix-input" class="block text-xs font-semibold text-[#202020] dark:text-zinc-300 mb-1.5">
          Username
        </label>
        <div class="relative">
          <input
            type="text"
            id="custom-prefix-input"
            required
            placeholder="e.g. alex.signup"
            pattern="[a-zA-Z0-9._-]+"
            class="w-full h-11 px-4 rounded-full bg-white dark:bg-zinc-800/90 border border-black/15 dark:border-white/15 text-sm font-mono text-[#202020] dark:text-[#fcfcfc] placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-[#ea2804]/50 transition-all"
          />
        </div>
      </div>

      <div>
        <label for="custom-domain-select" class="block text-xs font-semibold text-[#202020] dark:text-zinc-300 mb-1.5">
          Domain
        </label>
        <select
          id="custom-domain-select"
          class="w-full h-11 px-4 rounded-full bg-white dark:bg-zinc-800/90 border border-black/15 dark:border-white/15 text-sm font-mono text-[#202020] dark:text-[#fcfcfc] focus:outline-none focus:ring-2 focus:ring-[#ea2804]/50 transition-all"
        >
          <option value="" disabled selected>Loading domains...</option>
        </select>
      </div>

      <div class="bg-[#f3f0e8] dark:bg-[#181820] rounded-xl p-3 text-center text-xs text-[#575757] dark:text-zinc-400">
        Preview: <span id="custom-preview-address" class="font-mono font-bold text-[#ea2804] dark:text-[#ff6a3d]">yourname@domain</span>
      </div>

      <div class="flex gap-2 pt-2">
        <Button variant="ghost" size="md" id="custom-modal-cancel" class="flex-1" type="button">
          Cancel
        </Button>
        <Button variant="primary" size="md" id="custom-modal-submit" class="flex-1" type="submit">
          Create Inbox
        </Button>
      </div>
    </form>
  </div>
</div>
