---
import GlassCard from '../ui/GlassCard.astro';
import Badge from '../ui/Badge.astro';

const steps = [
  {
    step: '01',
    title: 'Get your burner address',
    description: 'Use the auto-generated address or click "Custom" to choose your own username and domain alias.',
  },
  {
    step: '02',
    title: 'Paste into any signup form',
    description: 'Use your burner email for website signups, free trials, app testing, and gated downloads.',
  },
  {
    step: '03',
    title: 'Grab your code in seconds',
    description: 'Incoming emails appear automatically. Click the highlighted OTP code or link to copy it instantly.',
  },
  {
    step: '04',
    title: 'Walk away — zero spam',
    description: 'Once you finish verifying, delete the mailbox or let it expire. Your real inbox stays clean forever.',
  },
];
---

<section id="how-it-works" class="w-full max-w-6xl mx-auto my-16 px-4">
  <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
    <Badge variant="neutral" size="md">
      How It Works
    </Badge>
    <h2 class="font-display text-3xl md:text-4xl font-black text-[#202020] dark:text-[#fcfcfc] tracking-tight">
      How it works in 4 easy steps
    </h2>
    <p class="text-sm md:text-base text-[#575757] dark:text-zinc-400">
      No passwords, no phone numbers, and no credit cards needed.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6">
    {steps.map((s) => (
      <GlassCard variant="card" class="p-5 sm:p-6 relative group overflow-hidden border border-black/5 dark:border-white/10">
        <div class="font-mono text-3xl sm:text-4xl font-black text-[#ea2804]/20 dark:text-[#ea2804]/30 mb-3 sm:mb-4 transition-colors group-hover:text-[#ea2804]/40">
          {s.step}
        </div>
        <h3 class="font-display text-base font-bold text-[#202020] dark:text-[#fcfcfc] mb-2">
          {s.title}
        </h3>
        <p class="text-xs md:text-sm text-[#575757] dark:text-zinc-400 leading-relaxed">
          {s.description}
        </p>
      </GlassCard>
    ))}
  </div>
</section>
