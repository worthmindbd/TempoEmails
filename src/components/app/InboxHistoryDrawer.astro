---
import DialogHeader from '../ui/DialogHeader.astro';
import { useTranslation } from '../../i18n/utils';
import type { Locale } from '../../i18n/languages';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslation(locale);
---

<div
  id="history-modal"
  class="dialog-overlay opacity-0 pointer-events-none"
  role="dialog"
  aria-hidden="true"
  inert
  aria-modal="true"
  aria-labelledby="history-modal-title"
>
  <div id="history-modal-content" class="dialog-panel max-w-md scale-95">
    <DialogHeader id="history-modal-title" closeId="history-modal-close" title={t.historyDrawer.title} closeLabel={t.common.close} />
    <p class="text-sm text-muted mb-5">{t.historyDrawer.desc}</p>

    <div id="history-inboxes-list" class="space-y-1.5 max-h-72 overflow-y-auto -mx-1 px-1">
      <div class="text-center py-8 text-sm text-subtle">{t.historyDrawer.emptyTitle}</div>
    </div>

    <div class="flex justify-between items-center pt-4 mt-4 border-t hairline">
      <button
        id="clear-all-history-btn"
        type="button"
        disabled
        class="btn btn-ghost btn-sm -ms-3 text-[#c81e3a]! hover:bg-[#c81e3a]/8!"
      >
        {t.historyDrawer.clearAll}
      </button>
      <button type="button" id="history-modal-done" class="btn btn-secondary btn-sm">{t.common.close}</button>
    </div>
  </div>
</div>
