# ==============================================================================
# TempoEmails — Production Environment Variables
# ==============================================================================
# Copy this file to your production server / Dokploy environment settings.
# Variables prefixed with PUBLIC_ are exposed to client-side Astro components.
# ==============================================================================

# --- [1. SITE & SERVER CONFIGURATION] ---
# Your live production domain URL (used for canonical URLs, sitemap, and Open Graph tags)
SITE_URL=https://tempoemails.com
PUBLIC_SITE_URL=https://tempoemails.com

# Container application port (default 3012 for Docker / Dokploy)
PORT=3012
HOST=0.0.0.0
NODE_ENV=production

# --- [2. GOOGLE ADSENSE MONETIZATION] ---
# Your Google AdSense Publisher ID (format: ca-pub-XXXXXXXXXXXXXXXX)
# After approval, also update your publisher ID in public/ads.txt
PUBLIC_GOOGLE_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX

# Optional: Default Ad Unit Slot ID for inline banner ads
PUBLIC_GOOGLE_ADSENSE_SLOT_ID=

# --- [3. GOOGLE ANALYTICS & TAG MANAGER] ---
# Google Analytics 4 (GA4) Measurement ID (format: G-XXXXXXXXXX)
PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Optional: Google Tag Manager Container ID (format: GTM-XXXXXXX)
PUBLIC_GTM_ID=

# --- [4. SEARCH CONSOLE & WEBMASTER VERIFICATIONS] ---
# Google Search Console HTML meta tag verification content
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification code (msvalidate.01)
PUBLIC_BING_SITE_VERIFICATION=

# Yandex Webmaster verification code
PUBLIC_YANDEX_VERIFICATION=

# --- [5. PRIVACY-FIRST ANALYTICS ALTERNATIVES (OPTIONAL)] ---
# Plausible Analytics domain (leave blank if not using Plausible)
PUBLIC_PLAUSIBLE_DOMAIN=tempoemails.com

# Umami Analytics (leave blank if not using Umami)
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# Cloudflare Web Analytics Token (leave blank if not using Cloudflare Analytics)
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
