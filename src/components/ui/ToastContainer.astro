---
---

<div
  id="toast-container"
  class="fixed bottom-4 sm:bottom-6 inset-x-4 sm:inset-x-auto sm:end-6 z-[55] flex flex-col items-center sm:items-end gap-2 pointer-events-none sm:max-w-sm"
  aria-live="polite"
>
</div>

<script>
  const MAX_TOASTS = 4;

  function setupToaster() {
    const container = document.getElementById('toast-container');
    if (!container || (container as any).dataset.toasterBound === 'true') return;
    // Same runtime i18n payload every other vanilla component reads (Layout
    // injects it in <head>); a `define:vars` script would have to drop TS.
    const i18n = (window as any).__TEMPO_I18N__;
    const dismissLabel = i18n?.a11y?.dismissToast || 'Dismiss notification';
    (container as any).dataset.toasterBound = 'true';

    window.addEventListener('tempomail:toast', ((event: CustomEvent) => {
      const { message, type = 'success', duration = 3000 } = event.detail || {};
      if (!message) return;

      while (container.children.length >= MAX_TOASTS) {
        container.firstElementChild?.remove();
      }

      const toast = document.createElement('div');
      toast.setAttribute('role', type === 'error' ? 'alert' : 'status');
      // Always-dark pill in both themes; errors carry a red icon rather than
      // a red fill so the toast never shouts.
      toast.className =
        'pointer-events-auto transition-all duration-300 ease-out translate-y-2 opacity-0 flex items-center gap-3 ps-3.5 pe-2 py-2.5 rounded-2xl text-sm font-medium text-[#f5f2ed] bg-[#1f1c19]/95 ring-1 ring-white/10 shadow-[0_16px_40px_-12px_rgba(0,0,0,0.5)] backdrop-blur-xl max-w-full';

      const icon =
        type === 'error'
          ? '<svg class="w-[18px] h-[18px] text-[#ff6b6b] shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>'
          : '<svg class="w-[18px] h-[18px] text-[#3fbf86] shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="m8 12 3 3 5-6"/></svg>';

      const iconWrapper = document.createElement('span');
      iconWrapper.className = 'shrink-0 inline-flex';
      // Icons are static trusted markup — safe to assign via innerHTML.
      iconWrapper.innerHTML = icon;

      const messageSpan = document.createElement('span');
      messageSpan.className = 'flex-1 min-w-0 break-words';
      // SECURITY: messages may embed user-influenced data (email addresses, OTP codes).
      // Use textContent — never interpolate into innerHTML.
      messageSpan.textContent = message;

      const dismissBtn = document.createElement('button');
      dismissBtn.type = 'button';
      dismissBtn.className = 'shrink-0 grid place-items-center w-7 h-7 rounded-full opacity-60 hover:opacity-100 hover:bg-white/10 transition';
      dismissBtn.setAttribute('aria-label', dismissLabel);
      const dismissIcon = document.createElement('span');
      dismissIcon.className = 'inline-flex';
      dismissIcon.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';

      let dismissed = false;
      const dismissToast = () => {
        if (dismissed) return;
        dismissed = true;
        clearTimeout(dismissTimer);
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-2', 'opacity-0');
        setTimeout(() => toast.remove(), 300);
      };
      dismissBtn.appendChild(dismissIcon);
      dismissBtn.addEventListener('click', dismissToast);

      toast.append(iconWrapper, messageSpan, dismissBtn);
      container.appendChild(toast);

      // Trigger enter animation
      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');
      });

      // Dismiss after duration
      const dismissTimer = setTimeout(dismissToast, duration);
    }) as EventListener);
  }

  setupToaster();
  document.addEventListener('astro:page-load', setupToaster);
</script>
