---
import GlassCard from '../ui/GlassCard.astro';
import Badge from '../ui/Badge.astro';
---

<section class="w-full max-w-6xl mx-auto my-12 px-4">
  <GlassCard variant="panel" class="p-6 md:p-10 relative overflow-hidden">
    <!-- Ambient glow behind card -->
    <div class="absolute -right-20 -top-20 w-72 h-72 bg-[#ea2804]/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <!-- Left Editorial Pitch -->
      <div class="lg:col-span-6 space-y-4">
        <Badge variant="otp" size="md">
          ⚡ Smart OTP Extraction Engine
        </Badge>

        <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-black text-[#202020] dark:text-[#fcfcfc] tracking-tight leading-tight">
          Never hunt through long email bodies for your code again.
        </h2>

        <p class="text-sm md:text-base text-[#575757] dark:text-zinc-300 leading-relaxed">
          TempoEmails uses regex pattern matching to analyze incoming verification messages in real-time. Whether it is a 4-digit PIN, 6-digit confirmation code, or one-click verification link, it's extracted and displayed right at the top for 1-tap copying.
        </p>

        <div class="flex flex-wrap gap-2 pt-2">
          <div class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-full bg-black/5 dark:bg-white/10 text-[#202020] dark:text-zinc-200">
            <svg class="w-3.5 h-3.5 text-[#ea2804]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            6-Digit Auth Codes
          </div>
          <div class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-full bg-black/5 dark:bg-white/10 text-[#202020] dark:text-zinc-200">
            <svg class="w-3.5 h-3.5 text-[#ea2804]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            Activation Magic Links
          </div>
          <div class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-full bg-black/5 dark:bg-white/10 text-[#202020] dark:text-zinc-200">
            <svg class="w-3.5 h-3.5 text-[#ea2804]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            Zero Delay
          </div>
        </div>
      </div>

      <!-- Right Interactive Mock Visual Preview -->
      <div class="lg:col-span-6">
        <div class="relative rounded-2xl glass-card p-5 md:p-6 border border-[#ea2804]/20 dark:border-[#ea2804]/30 shadow-2xl space-y-4">
          <div class="flex items-center justify-between border-b border-black/5 dark:border-white/10 pb-3">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-500"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
              <span class="text-xs font-mono font-bold text-[#8d8d8d] ml-2">Inbox Preview</span>
            </div>
            <span class="text-[10px] uppercase font-mono px-2 py-0.5 rounded-full bg-[#2b9a66]/10 text-[#2b9a66] font-bold">Auto-Detected</span>
          </div>

          <!-- Highlighted banner -->
          <div class="p-3.5 sm:p-4 rounded-xl bg-gradient-to-r from-[#ea2804]/15 via-[#ff6a3d]/20 to-[#ea2804]/15 border border-[#ea2804]/40 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
            <div class="min-w-0">
              <span class="text-[10px] font-bold tracking-wider uppercase text-[#ea2804] dark:text-[#ff6a3d] block">
                Verification Code
              </span>
              <span class="font-mono text-2xl sm:text-3xl font-black tracking-widest text-[#202020] dark:text-white break-all">
                5 9 3 8 2 1
              </span>
            </div>
            <div class="w-full sm:w-auto px-3.5 py-2 rounded-full bg-[#ea2804] text-white text-xs font-bold shadow-md inline-flex items-center justify-center gap-1 shrink-0">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              1-Tap Copy
            </div>
          </div>

          <div class="space-y-2 text-xs text-[#575757] dark:text-zinc-400">
            <div class="flex justify-between font-mono text-[11px]">
              <span>From: GitHub Security</span>
              <span>Just now</span>
            </div>
            <div class="p-3 rounded-lg bg-black/5 dark:bg-white/5 font-mono text-[11px] leading-relaxed">
              "Please enter this verification code to complete your account setup. This code is valid for 10 minutes."
            </div>
          </div>
        </div>
      </div>
    </div>
  </GlassCard>
</section>
