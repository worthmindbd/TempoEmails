---
import ContentLayout from '../layouts/ContentLayout.astro';
import { SITE_CONFIG } from '../lib/config';
import { useTranslation, getLocaleFromUrl, getLocalizedPath } from '../i18n/utils';
import { getAboutPageData } from '../i18n/pages-data';
import type { Locale } from '../i18n/languages';

interface Props {
  locale?: Locale;
}

const { locale } = Astro.props;
const currentLocale = locale || getLocaleFromUrl(Astro.url);
const t = useTranslation(currentLocale);
const about = getAboutPageData(currentLocale);
const contactUrl = getLocalizedPath('/contact/', currentLocale);
---

<ContentLayout
  title={t.pages.about.title}
  description={t.pages.about.description}
  locale={currentLocale}
  keywords="about tempoemails, free temp mail service, disposable temporary email provider, 10 minute mail mission, anonymous burner email, privacy first email"
>
  <p class="text-base text-[#575757] dark:text-zinc-300 leading-relaxed mb-4">
    {about.lead}
  </p>

  <p class="text-base text-[#575757] dark:text-zinc-300 leading-relaxed mb-4">
    {about.story}
  </p>

  <blockquote class="border-l-4 border-[#ea2804] pl-4 italic text-[#575757] dark:text-zinc-400 mb-6">
    {about.quote}
  </blockquote>

  <h2 class="font-display text-2xl font-bold text-[#202020] dark:text-[#fcfcfc] mb-4 mt-8">
    {about.whyHeading}
  </h2>
  <p class="text-base text-[#575757] dark:text-zinc-300 leading-relaxed mb-4">
    {about.whyP1}
  </p>
  <p class="text-base text-[#575757] dark:text-zinc-300 leading-relaxed mb-4">
    {about.whyP2}
  </p>

  <div class="space-y-4 mb-6">
    {about.features.map((f) => (
      <div class="p-4 rounded-xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
        <h3 class="font-display text-lg font-bold text-[#202020] dark:text-[#fcfcfc] mb-1">
          {f.icon} {f.title}
        </h3>
        <p class="text-sm text-[#575757] dark:text-zinc-400">
          {f.desc}
        </p>
      </div>
    ))}
  </div>

  <h2 class="font-display text-2xl font-bold text-[#202020] dark:text-[#fcfcfc] mb-4 mt-8">
    {about.principlesHeading}
  </h2>
  <ul class="list-disc pl-6 space-y-2 text-base text-[#575757] dark:text-zinc-300 mb-6">
    {about.principles.map((p) => (
      <li>
        <strong>{p.label}:</strong> {p.desc}
      </li>
    ))}
  </ul>

  <h2 class="font-display text-2xl font-bold text-[#202020] dark:text-[#fcfcfc] mb-4 mt-8">
    {about.questionsHeading}
  </h2>
  <p class="text-base text-[#575757] dark:text-zinc-300 leading-relaxed mb-4">
    {about.questionsLead} <a href={contactUrl} class="text-[#ea2804] hover:underline font-semibold">{about.contactPageLink}</a> {currentLocale === 'en' ? 'or drop us an email at' : '—'} <a href={`mailto:${SITE_CONFIG.emails.contact}`} class="text-[#ea2804] hover:underline font-semibold">{SITE_CONFIG.emails.contact}</a>.
  </p>
</ContentLayout>
