---
import GlassCard from '../ui/GlassCard.astro';
import Badge from '../ui/Badge.astro';

const faqs = [
  {
    q: 'Can I send emails from TempoEmails?',
    a: 'No. TempoEmails is receive-only. Blocking outbound mail keeps our domains off spam blocklists, so your verification emails and activation codes arrive reliably without getting filtered.',
  },
  {
    q: 'How fast do verification emails and OTPs arrive?',
    a: 'Most incoming emails and OTP codes arrive within 2 to 5 seconds. The inbox automatically checks for new messages every 10 seconds, so you never need to refresh the page.',
  },
  {
    q: 'How long does a temporary inbox stay active?',
    a: 'Your temporary inbox stays active for your browser session. You can switch between up to 8 recent inboxes from the History drawer, or delete them anytime with one click.',
  },
  {
    q: 'Is TempoEmails completely free?',
    a: 'Yes. TempoEmails is 100% free with no limits on how many emails you can receive, no hidden fees, and no paid tiers.',
  },
  {
    q: 'Do I need to sign up or provide personal details?',
    a: 'No. You get a working disposable address the second you open the website. We never ask for your name, phone number, real email, or password.',
  },
  {
    q: 'Can I choose my own custom email username?',
    a: 'Yes. Click the "Custom" button in the address bar to pick your own username and choose from our available domain names.',
  },
];
---

<section id="faq" class="w-full max-w-4xl mx-auto my-16 px-4">
  <div class="text-center mb-10 space-y-3">
    <Badge variant="neutral" size="md">
      Frequently Asked Questions
    </Badge>
    <h2 class="font-display text-3xl md:text-4xl font-black text-[#202020] dark:text-[#fcfcfc] tracking-tight">
      Common questions & answers.
    </h2>
  </div>

  <div class="space-y-3">
    {faqs.map((faq, i) => (
      <GlassCard variant="card" class="faq-item overflow-hidden transition-all duration-200 cursor-pointer">
        <button
          type="button"
          class="faq-toggle w-full p-4 sm:p-5 text-left flex items-center justify-between gap-3 sm:gap-4 font-display text-sm sm:text-base font-bold text-[#202020] dark:text-[#fcfcfc] cursor-pointer"
          aria-expanded="false"
        >
          <span class="break-words">{faq.q}</span>
          <svg class="faq-icon w-4 h-4 sm:w-5 sm:h-5 text-[#ea2804] shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="faq-content hidden px-4 sm:px-5 pb-4 sm:pb-5 text-xs sm:text-sm text-[#575757] dark:text-zinc-300 leading-relaxed border-t border-black/5 dark:border-white/5 pt-3">
          {faq.a}
        </div>
      </GlassCard>
    ))}
  </div>
</section>

<script>
  function setupFaq() {
    const items = document.querySelectorAll('.faq-item');
    items.forEach((item) => {
      const toggle = item.querySelector('.faq-toggle');
      const content = item.querySelector('.faq-content');
      const icon = item.querySelector('.faq-icon');

      toggle?.addEventListener('click', () => {
        const isOpen = !content?.classList.contains('hidden');
        if (isOpen) {
          content?.classList.add('hidden');
          icon?.classList.remove('rotate-180');
          toggle.setAttribute('aria-expanded', 'false');
        } else {
          content?.classList.remove('hidden');
          icon?.classList.add('rotate-180');
          toggle.setAttribute('aria-expanded', 'true');
        }
      });
    });
  }

  setupFaq();
  document.addEventListener('astro:page-load', setupFaq);
</script>
