---
interface Props {
  id: string;
  closeId: string;
  title: string;
  closeLabel: string;
}

const { id, closeId, title, closeLabel } = Astro.props;
---

<div class="flex items-start justify-between gap-4 mb-2">
  <h3 id={id} class="font-display text-xl font-semibold tracking-tight text-ink pt-1">{title}</h3>
  <button id={closeId} type="button" class="btn btn-ghost w-9 h-9 p-0 -me-2 -mt-0.5" aria-label={closeLabel}>
    <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round">
      <path d="M18 6 6 18M6 6l12 12"></path>
    </svg>
  </button>
</div>
