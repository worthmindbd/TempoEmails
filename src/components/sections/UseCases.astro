---
import GlassCard from '../ui/GlassCard.astro';
import Badge from '../ui/Badge.astro';
import { useTranslation } from '../../i18n/utils';
import type { Locale } from '../../i18n/languages';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslation(locale);

const icons = [
  `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8z"/><path d="M12 6v6l4 2"/></svg>`,
  `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><polygon points="6 3 20 12 6 21 6 3"/></svg>`,
  `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>`,
  `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
];

const useCases = (t.useCases.items || []).map((item, index) => ({
  category: item.category,
  badge: item.badge,
  icon: icons[index] || icons[0],
  title: item.title,
  description: item.description,
  tags: item.tags || [],
}));
---

<section id="use-cases" class="w-full max-w-6xl mx-auto my-16 px-4">
  <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
    <Badge variant="neutral" size="md">
      {t.useCases.badge}
    </Badge>
    <h2 class="font-display text-3xl md:text-4xl font-black text-[#202020] dark:text-[#fcfcfc] tracking-tight">
      {t.useCases.title}
    </h2>
    <p class="text-sm md:text-base text-[#575757] dark:text-zinc-400">
      {t.useCases.subtitle}
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6">
    {useCases.map((u) => (
      <GlassCard variant="card" class="p-6 sm:p-7 relative group overflow-hidden border border-black/5 dark:border-white/10 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
        <div class="flex items-center justify-between gap-4 mb-4">
          <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-[#ea2804]/10 dark:bg-[#ea2804]/20 text-[#ea2804] dark:text-[#ff6a3d] flex items-center justify-center transition-transform group-hover:scale-110 shadow-xs" set:html={u.icon}>
          </div>
          <span class="text-[11px] font-mono font-bold px-3 py-1 rounded-full bg-black/5 dark:bg-white/10 text-[#575757] dark:text-zinc-300">
            {u.badge}
          </span>
        </div>

        <span class="text-[11px] font-bold uppercase tracking-wider text-[#ea2804] dark:text-[#ff6a3d] block mb-1">
          {u.category}
        </span>

        <h3 class="font-display text-lg sm:text-xl font-bold text-[#202020] dark:text-[#fcfcfc] mb-2.5">
          {u.title}
        </h3>

        <p class="text-xs sm:text-sm text-[#575757] dark:text-zinc-400 leading-relaxed mb-4">
          {u.description}
        </p>

        <div class="flex flex-wrap gap-1.5 pt-1 border-t border-black/5 dark:border-white/5">
          {u.tags.map((t) => (
            <span class="text-[10px] font-mono px-2.5 py-0.5 rounded-md bg-black/5 dark:bg-white/5 text-[#575757] dark:text-zinc-400">
              #{t}
            </span>
          ))}
        </div>
      </GlassCard>
    ))}
  </div>
</section>
