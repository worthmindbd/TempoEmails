---
---

<footer class="w-full bg-[#0e0e11] text-[#fcfcfc] border-t border-white/10 mt-20 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-white/10">
      <!-- Brand column -->
      <div class="md:col-span-5 space-y-4">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-[#ea2804] to-[#ff6a3d] flex items-center justify-center text-white font-bold">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"></path>
            </svg>
          </div>
          <span class="font-display text-xl font-black tracking-tight text-white">
            Tempo<span class="text-[#ea2804]">Mail</span>
          </span>
        </div>
        <p class="text-xs text-zinc-400 max-w-sm leading-relaxed">
          Free disposable temporary email service for instantaneous account signups, verification code extraction, and complete inbox privacy.
        </p>
        <div class="flex items-center gap-3 pt-2 text-xs font-mono text-zinc-500">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/5 border border-white/10 text-emerald-400">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            100% Free & Anonymous
          </span>
          <span>Zero Logs</span>
        </div>
      </div>

      <!-- Links Column 1 -->
      <div class="md:col-span-3 space-y-3">
        <h4 class="font-display text-sm font-bold text-white tracking-wide uppercase">
          Quick Links
        </h4>
        <ul class="space-y-2 text-xs text-zinc-400">
          <li><a href="#mailbox-manager" class="hover:text-white transition-colors">Instant Inbox</a></li>
          <li><a href="#features" class="hover:text-white transition-colors">Features & Privacy</a></li>
          <li><a href="#how-it-works" class="hover:text-white transition-colors">How It Works</a></li>
          <li><a href="#faq" class="hover:text-white transition-colors">FAQ</a></li>
        </ul>
      </div>

      <!-- Links Column 2 -->
      <div class="md:col-span-4 space-y-3">
        <h4 class="font-display text-sm font-bold text-white tracking-wide uppercase">
          Privacy & Security
        </h4>
        <p class="text-xs text-zinc-400 leading-relaxed">
          TempoMail does not store personal data, IP addresses, or permanent message stores. Emails received are disposable and purged upon disposal.
        </p>
        <div class="pt-2 text-xs font-mono text-zinc-500">
          Encrypted & Anonymous Disposable Mail
        </div>
      </div>
    </div>

    <!-- Copyright Row -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-500 font-mono">
      <div>
        © {new Date().getFullYear()} TempoMail. All rights reserved. Receive-only disposable mail.
      </div>
      <div class="flex items-center gap-4">
        <span>Privacy Protected</span>
        <span>•</span>
        <span>Spam Free</span>
      </div>
    </div>
  </div>
</footer>
