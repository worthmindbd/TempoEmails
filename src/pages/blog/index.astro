---
import Layout from '../../layouts/Layout.astro';
import { useTranslation, getLocaleFromUrl, getLocalizedPath } from '../../i18n/utils';
import type { Locale } from '../../i18n/languages';

import { getBlogArticles } from '../../i18n/blog-data';
import { SITE_CONFIG } from '../../lib/config';

interface Props {
  locale?: Locale;
}

const { locale } = Astro.props;
const currentLocale = locale || getLocaleFromUrl(Astro.url);
const t = useTranslation(currentLocale);
const homeUrl = currentLocale === 'en' ? '/' : `/${currentLocale}/`;

const siteUrl = Astro.site?.origin || SITE_CONFIG.siteUrl;
let normalizedPath = Astro.url.pathname;
if (!normalizedPath.endsWith('/')) normalizedPath = `${normalizedPath}/`;
const canonicalURL = new URL(normalizedPath, siteUrl);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t.common.home,
      item: `${canonicalURL.origin}${homeUrl}`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t.common.blog,
      item: canonicalURL.href,
    },
  ],
};

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: t.pages.blog.title,
  description: t.pages.blog.description,
  url: canonicalURL.href,
  inLanguage: currentLocale,
  publisher: {
    '@type': 'Organization',
    '@id': `${canonicalURL.origin}/#organization`,
    name: 'TempoEmails',
  },
};

// Localized blog articles data — ordered by publish date (newest first)
const articles = getBlogArticles(currentLocale);

const categories = [...new Set(articles.map(a => a.category))];

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString(currentLocale, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

function getCategoryLabel(cat: string) {
  if (cat === 'Privacy') return t.common.privacy;
  if (cat === 'Security') return t.common.security;
  if (cat === 'Guides') return t.common.guide;
  if (cat === 'Technology') return t.common.architecture;
  return cat;
}

const [lead, ...rest] = articles;
---

<Layout
  title={t.pages.blog.title}
  description={t.pages.blog.description}
  locale={currentLocale}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />

  <section class="px-5 sm:px-8 pt-12 sm:pt-20">
    <div class="max-w-6xl mx-auto">
      <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-[13px] text-subtle">
        <a href={homeUrl} class="hover:text-ink transition-colors">{t.common.home}</a>
        <svg class="w-3.5 h-3.5 opacity-50 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
        <span class="text-muted" aria-current="page">{t.common.blog}</span>
      </nav>

      <div class="mt-8 grid lg:grid-cols-[1fr_auto] items-end gap-6">
        <div class="max-w-2xl animate-rise-in">
          <h1 class="font-display font-bold text-ink tracking-[-0.045em] leading-[1] text-[clamp(2.5rem,1.5rem+4vw,4.5rem)]">
            {t.pages.blog.heading}
          </h1>
          <p class="mt-5 text-lg text-muted leading-relaxed max-w-xl">{t.pages.blog.subheading}</p>
        </div>

        <div class="blog-filters flex flex-wrap gap-2 lg:justify-end" role="group" aria-label={t.common.blog}>
          <button type="button" data-filter="all" aria-pressed="true" class="blog-filter chip h-9 px-4 text-[13px] cursor-pointer transition-colors hover:border-line-strong aria-pressed:bg-ink aria-pressed:text-canvas aria-pressed:border-ink">
            {t.common.all} <span class="font-mono opacity-60">{articles.length}</span>
          </button>
          {categories.map((cat) => (
            <button type="button" data-filter={cat} aria-pressed="false" class="blog-filter chip h-9 px-4 text-[13px] cursor-pointer transition-colors hover:border-line-strong aria-pressed:bg-ink aria-pressed:text-canvas aria-pressed:border-ink">
              {getCategoryLabel(cat)} <span class="font-mono opacity-60">{articles.filter((a) => a.category === cat).length}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Lead story -->
      {lead && (
        <a
          href={getLocalizedPath(lead.slug, currentLocale)}
          data-category={lead.category}
          class="blog-card group mt-12 surface-raised card-hover rounded-[2rem] p-2 grid md:grid-cols-[1.1fr_1fr] gap-2"
        >
          <div class="relative min-h-56 md:min-h-80 rounded-[1.6rem] overflow-hidden bg-[#16120f]" aria-hidden="true">
            <div class="absolute inset-0 bg-[radial-gradient(80%_100%_at_100%_100%,rgba(234,40,4,0.7),transparent_65%)] transition-transform duration-700 group-hover:scale-110"></div>
            <div class="absolute inset-0 bg-[radial-gradient(50%_60%_at_0%_0%,rgba(255,106,61,0.25),transparent_70%)]"></div>
            <span class="absolute bottom-5 start-6 font-display text-[7rem] leading-none font-bold tracking-tighter text-white/10">01</span>
          </div>
          <div class="p-6 sm:p-10 flex flex-col">
            <div class="flex items-center gap-2 text-sm text-subtle">
              <span class="font-medium text-accent-text">{getCategoryLabel(lead.category)}</span>
              <span aria-hidden="true">·</span>
              <time datetime={lead.date}>{formatDate(lead.date)}</time>
            </div>
            <h2 class="mt-4 font-display text-2xl sm:text-4xl font-bold tracking-tight leading-tight text-ink group-hover:text-accent-text transition-colors">{lead.title}</h2>
            <p class="mt-4 text-base text-muted leading-relaxed line-clamp-3">{lead.description}</p>
            <span class="mt-auto pt-8 inline-flex items-center gap-1.5 text-sm font-semibold text-ink">
              {t.common.readArticle}
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1 rtl:-scale-x-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </span>
          </div>
        </a>
      )}

      <!-- All other articles -->
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {rest.map((article, i) => (
          <a
            href={getLocalizedPath(article.slug, currentLocale)}
            data-category={article.category}
            class="blog-card group surface card-hover rounded-3xl p-6 sm:p-7 flex flex-col min-h-[13rem]"
            data-reveal
            style={`--reveal-delay: ${i % 3}`}
          >
            <div class="flex items-center justify-between gap-3 text-xs text-subtle">
              <span class="font-medium text-accent-text">{getCategoryLabel(article.category)}</span>
              <time datetime={article.date}>{formatDate(article.date)}</time>
            </div>
            <h2 class="mt-4 font-display text-xl font-semibold tracking-tight leading-snug text-ink group-hover:text-accent-text transition-colors">
              {article.title}
            </h2>
            <span class="mt-auto pt-6 inline-flex items-center gap-1.5 text-sm font-medium text-ink-2">
              {t.common.readArticle}
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1 rtl:-scale-x-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  // Category filter: toggles card visibility client-side; every article stays
  // in the HTML so crawlers and no-JS visitors see the full index.
  function setupBlogFilters() {
    const root = document.querySelector<HTMLElement>('.blog-filters');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.blog-filter'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.blog-card'));
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter || 'all';
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        cards.forEach((card) => {
          const show = filter === 'all' || card.dataset.category === filter;
          card.classList.toggle('hidden', !show);
          if (show) card.classList.add('is-visible');
        });
      });
    });
  }

  setupBlogFilters();
  document.addEventListener('astro:page-load', setupBlogFilters);
</script>
