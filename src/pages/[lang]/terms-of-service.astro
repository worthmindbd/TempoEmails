---
import TermsPage from '../terms-of-service.astro';
import { NON_DEFAULT_LOCALES, type Locale } from '../../i18n/languages';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
---

<TermsPage locale={lang as Locale} />
