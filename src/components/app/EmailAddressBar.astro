---
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import { useTranslation } from '../../i18n/utils';
import type { Locale } from '../../i18n/languages';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslation(locale);
---

<div class="relative w-full">
  <!-- Glow effect under the bar -->
  <div class="absolute -inset-1 bg-gradient-to-r from-[#ea2804]/20 via-[#ff6a3d]/20 to-[#ea2804]/20 rounded-3xl blur-xl opacity-60 pointer-events-none"></div>

  <div class="relative glass-panel rounded-2xl md:rounded-full p-2.5 md:p-3 shadow-xl transition-all duration-300">
    <div class="flex flex-col md:flex-row items-center gap-3">
      <!-- Address display section -->
      <div class="flex items-center gap-3 w-full md:w-auto md:flex-1 min-w-0 px-3 py-1.5 md:py-0">
        <!-- Live status pulse -->
        <div class="relative flex items-center justify-center shrink-0" title="Active & Ready">
          <span class="w-3 h-3 rounded-full bg-[#2b9a66]"></span>
          <span class="absolute w-5 h-5 rounded-full bg-[#2b9a66]/40 animate-ping"></span>
        </div>

        <!-- Address Text -->
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2">
            <span class="text-[10px] font-bold tracking-wider uppercase text-[#8d8d8d] dark:text-zinc-400">
              {t.addressBar.tempEmailLabel}
            </span>
            <span id="provider-badge" class="text-[9px] uppercase tracking-wider px-1.5 py-0.2 rounded bg-black/5 dark:bg-white/10 text-[#575757] dark:text-zinc-300 font-mono">
              {t.addressBar.liveBadge}
            </span>
          </div>
          <div
            id="current-email-display"
            class="font-mono text-base md:text-xl font-bold text-[#202020] dark:text-[#fcfcfc] truncate select-all tracking-tight"
            title="Click to copy email"
          >
            <span class="inline-block w-48 h-5 bg-black/10 dark:bg-white/10 animate-pulse rounded"></span>
          </div>
        </div>
      </div>

      <!-- Action Buttons Row -->
      <div class="flex items-center justify-between md:justify-end gap-1.5 sm:gap-2 w-full md:w-auto shrink-0 pt-2.5 md:pt-0 border-t md:border-t-0 border-black/5 dark:border-white/10">
        <!-- Main Copy Button -->
        <Button variant="primary" size="md" id="copy-email-btn" class="flex-1 md:flex-initial h-10 sm:h-11 px-3.5 sm:px-5 min-w-0" title={t.addressBar.copyAddress}>
          <svg id="copy-icon" class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <svg id="check-icon" class="w-4 h-4 hidden text-white shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span id="copy-btn-text" class="text-xs sm:text-sm font-semibold truncate">{t.addressBar.copyAddress}</span>
        </Button>

        <!-- Refresh Button with countdown bar -->
        <div class="relative shrink-0">
          <Button variant="outline" size="md" id="refresh-inbox-btn" class="w-10 h-10 sm:w-11 sm:h-11 !p-0 relative overflow-hidden flex items-center justify-center shrink-0" title={t.addressBar.refreshTooltip}>
            <svg id="refresh-icon" class="w-4 h-4 text-[#575757] dark:text-zinc-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
            </svg>
            <!-- Progress track at bottom of button -->
            <div id="refresh-progress-bar" class="absolute bottom-0 left-0 h-0.5 bg-[#ea2804] w-full transition-all duration-1000 ease-linear"></div>
          </Button>
        </div>

        <!-- Custom Username Button -->
        <Button variant="outline" size="md" id="custom-email-btn" class="w-10 h-10 sm:w-11 sm:h-11 !p-0 flex items-center justify-center shrink-0" title={t.addressBar.customTooltip}>
          <svg class="w-4 h-4 text-[#575757] dark:text-zinc-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
          </svg>
        </Button>

        <!-- QR Code Button -->
        <Button variant="outline" size="md" id="qr-code-btn" class="w-10 h-10 sm:w-11 sm:h-11 !p-0 flex items-center justify-center shrink-0" title={t.addressBar.qrTooltip}>
          <svg class="w-4 h-4 text-[#575757] dark:text-zinc-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
        </Button>

        <!-- Change / Randomize Button -->
        <Button variant="outline" size="md" id="change-email-btn" class="w-10 h-10 sm:w-11 sm:h-11 !p-0 flex items-center justify-center shrink-0" title={t.addressBar.changeTooltip}>
          <svg class="w-4 h-4 text-[#575757] dark:text-zinc-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path d="M16 3h5v5"></path>
            <path d="M4 20L21 3"></path>
            <path d="M21 16v5h-5"></path>
            <path d="M15 15l6 6"></path>
            <path d="M4 4l5 5"></path>
          </svg>
        </Button>

        <!-- Delete / Wipe Button -->
        <Button variant="outline" size="md" id="delete-inbox-btn" class="w-10 h-10 sm:w-11 sm:h-11 !p-0 flex items-center justify-center shrink-0 hover:text-rose-500 hover:border-rose-300 dark:hover:text-rose-400" title={t.addressBar.deleteTooltip}>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <polyline points="3 6 5 6 21 6"></polyline>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          </svg>
        </Button>
      </div>
    </div>
  </div>
</div>
