---
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
import ToastContainer from '../components/ui/ToastContainer.astro';
import CookieConsent from '../components/ui/CookieConsent.astro';
import { SITE_CONFIG } from '../lib/config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  isApp?: boolean;
  publishDate?: string;
  category?: string;
}

const {
  title = 'TempoEmails — Free Disposable Temporary Email & Verification Codes',
  description = 'Free temporary disposable email address. Receive verification codes, activation links, and OTPs instantly without spam or exposing your real inbox. 100% free and private.',
  keywords = 'temp mail, temporary email, disposable email, throwaway email, burner email, fake email generator, 10 minute mail, 24 hour temp mail, temp mail for discord, temporary email for chatgpt, temp mail for telegram, temporary mail for steam, disposable email for facebook, disposable mail rest api, free temporary inbox, anonymous temp email no log',
  ogImage = '/og-image.png',
  ogType = 'website',
  noindex = false,
  isApp = false,
  publishDate,
  category,
} = Astro.props;

const siteUrl = Astro.site?.origin || SITE_CONFIG.siteUrl;
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = new URL(ogImage, siteUrl);

// Google Analytics 4 & AdSense
const gaId = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID;
const adsenseId = import.meta.env.PUBLIC_GOOGLE_ADSENSE_ID;

// JSON-LD Structured Data for WebSite, WebApplication, and Organization
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'TempoEmails',
  url: `${canonicalURL.origin}/`,
  description: 'Instant, private disposable email addresses with automatic verification code and OTP detection.',
};

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'TempoEmails',
  url: `${canonicalURL.origin}/`,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requires JavaScript. Requires HTML5.',
  offers: {
    '@type': 'Offer',
    price: '0.00',
    priceCurrency: 'USD',
  },
  featureList: [
    'Instant disposable email address generator',
    'Automatic verification code and OTP detection',
    'Custom username and domain aliases',
    'Live auto-refreshing inbox',
    'Desktop-to-mobile QR code scanner',
    'Zero logs and complete privacy',
    'Switch between recent session inboxes',
  ],
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'TempoEmails',
  url: `${canonicalURL.origin}/`,
  logo: new URL('/android-chrome-512x512.png', canonicalURL.origin).href,
  sameAs: [
    'https://github.com/TempoEmails',
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="TempoEmails" />
    <meta name="publisher" content="TempoEmails" />
    <meta name="theme-color" content="#ea2804" />
    <meta name="application-name" content="TempoEmails" />
    <meta name="apple-mobile-web-app-title" content="TempoEmails" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Search Engine Indexing Directives -->
    {noindex ? (
      <>
        <meta name="robots" content="noindex, follow" />
        <meta name="googlebot" content="noindex, follow" />
        <meta name="bingbot" content="noindex, follow" />
      </>
    ) : (
      <>
        <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
        <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
        <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
      </>
    )}
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Social Media Preview Meta Tags -->
    <meta property="og:site_name" content="TempoEmails" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:secure_url" content={ogImageURL.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_US" />
    {ogType === 'article' && publishDate && (
      <>
        <meta property="article:published_time" content={publishDate} />
        <meta property="article:modified_time" content={publishDate} />
        {category && <meta property="article:section" content={category} />}
        <meta property="article:author" content="TempoEmails Editorial Team" />
      </>
    )}

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL.href} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Google Analytics 4 (gtag.js) -->
    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId, { page_path: window.location.pathname });
        </script>
      </>
    )}

    <!-- Google AdSense -->
    {adsenseId && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseId}`}
        crossorigin="anonymous"
      />
    )}

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {isApp && <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />}
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <!-- Google Fonts: Bricolage Grotesque (Display), Inter (Body), JetBrains Mono (Code) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Zero-FOUC Theme Script -->
    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem('theme');
        const userPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (storedTheme === 'dark' || (!storedTheme && userPrefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body class="bg-[#f9f7f3] dark:bg-[#0e0e11] text-[#202020] dark:text-[#fcfcfc] min-h-screen flex flex-col antialiased selection:bg-[#ea2804] selection:text-white overflow-x-hidden">
    <!-- Atmospheric Ambient Glow Mesh Background -->
    <div class="fixed inset-0 hero-glow-mesh pointer-events-none z-0"></div>

    <Header />

    <main class="flex-1 relative z-10">
      <slot />
    </main>

    <Footer />

    <ToastContainer />
    <CookieConsent />
  </body>
</html>
