# ==============================================================================
# TempoEmails — Production Environment Configuration (prod.env)
# ==============================================================================
# Set these variables in your production environment (Dokploy / VPS / Docker).
# Variables starting with PUBLIC_ are safely bundled with the client application.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SITE & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# The primary canonical URL and domain of your live website.
SITE_URL=https://tempoemails.com
PUBLIC_SITE_URL=https://tempoemails.com
PUBLIC_DOMAIN=tempoemails.com

# ------------------------------------------------------------------------------
# 2. SERVER & CONTAINER SETTINGS
# ------------------------------------------------------------------------------
# Port mapped by Docker/Dokploy (internal Nginx listens on 3012).
PORT=3012
HOST=0.0.0.0
NODE_ENV=production

# ------------------------------------------------------------------------------
# 3. GOOGLE ADSENSE MONETIZATION
# ------------------------------------------------------------------------------
# Your AdSense Publisher ID (e.g., ca-pub-1234567890123456).
# Remember to also update your publisher ID in public/ads.txt.
PUBLIC_GOOGLE_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX

# Optional: Default Ad Unit Slot ID for inline banner ads.
PUBLIC_GOOGLE_ADSENSE_SLOT_ID=

# ------------------------------------------------------------------------------
# 4. GOOGLE ANALYTICS & TAG MANAGER
# ------------------------------------------------------------------------------
# Google Analytics 4 (GA4) Measurement ID (e.g., G-XXXXXXXXXX).
PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Optional: Google Tag Manager Container ID (e.g., GTM-XXXXXXX).
PUBLIC_GTM_ID=

# ------------------------------------------------------------------------------
# 5. SEARCH ENGINE / WEBMASTER VERIFICATION
# ------------------------------------------------------------------------------
# Google Search Console HTML meta verification token.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification code (msvalidate.01).
PUBLIC_BING_SITE_VERIFICATION=

# Yandex Webmaster verification code.
PUBLIC_YANDEX_VERIFICATION=

# ------------------------------------------------------------------------------
# 6. PRIVACY-FRIENDLY ANALYTICS ALTERNATIVES (OPTIONAL)
# ------------------------------------------------------------------------------
# Plausible Analytics domain (leave blank if not using Plausible).
PUBLIC_PLAUSIBLE_DOMAIN=

# Umami Analytics website ID & self-hosted script URL.
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# Cloudflare Web Analytics token.
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
