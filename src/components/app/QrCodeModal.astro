---
import DialogHeader from '../ui/DialogHeader.astro';
import { useTranslation } from '../../i18n/utils';
import type { Locale } from '../../i18n/languages';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslation(locale);
---

<div
  id="qr-modal"
  class="dialog-overlay opacity-0 pointer-events-none"
  role="dialog"
  aria-hidden="true"
  inert
  aria-modal="true"
  aria-labelledby="qr-modal-title"
>
  <div id="qr-modal-content" class="dialog-panel max-w-sm scale-95">
    <DialogHeader id="qr-modal-title" closeId="qr-modal-close" title={t.qrModal.title} closeLabel={t.common.close} />
    <p class="text-sm text-muted mb-5">{t.qrModal.desc}</p>

    <div class="rounded-2xl surface-inset p-5 grid place-items-center">
      <div id="qr-code-placeholder" class="grid place-items-center min-h-[200px] min-w-[200px] rounded-xl bg-white p-2 text-sm text-center text-[#6b655d]">
        <div class="w-48 h-48 rounded-lg bg-black/5 animate-pulse"></div>
      </div>
      <span id="qr-modal-address" class="mt-4 font-mono text-sm text-ink font-medium break-all text-center select-all"></span>
    </div>

    <button type="button" id="qr-copy-btn" class="btn btn-primary w-full mt-5">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="13" height="13" rx="2.5"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      {t.addressBar.copyAddress}
    </button>
  </div>
</div>
