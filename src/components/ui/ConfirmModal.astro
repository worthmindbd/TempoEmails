---
import { useTranslation } from '../../i18n/utils';
import type { Locale } from '../../i18n/languages';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslation(locale);
---

<div
  id="confirm-modal"
  class="dialog-overlay opacity-0 pointer-events-none"
  role="dialog"
  aria-hidden="true"
  inert
  aria-modal="true"
  aria-labelledby="confirm-modal-title"
>
  <div id="confirm-modal-content" class="dialog-panel max-w-sm scale-95">
    <div id="confirm-modal-icon-wrapper" class="icon-tile w-12! h-12! rounded-2xl! mb-5">
      <svg id="confirm-icon-random" class="w-[22px] h-[22px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="m18 14 4 4-4 4"></path>
        <path d="m18 2 4 4-4 4"></path>
        <path d="M2 18h1.97a4 4 0 0 0 3.3-1.7l5.45-8.6a4 4 0 0 1 3.3-1.7H22"></path>
        <path d="M2 6h1.97a4 4 0 0 1 3.4 1.9"></path>
        <path d="M22 18h-5.9a4 4 0 0 1-3.4-1.9"></path>
      </svg>
      <svg id="confirm-icon-trash" class="w-[22px] h-[22px] hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"></path>
      </svg>
      <svg id="confirm-icon-warning" class="w-[22px] h-[22px] hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3ZM12 9v4M12 17h.01"></path>
      </svg>
    </div>

    <h3 id="confirm-modal-title" class="font-display text-xl font-semibold tracking-tight text-ink">
      {t.confirmModal.confirm}
    </h3>
    <p id="confirm-modal-description" class="text-sm text-muted mt-2 leading-relaxed">
      {t.confirmModal.changeAddressDesc}
    </p>

    <div class="flex gap-2 mt-7">
      <button type="button" id="confirm-modal-cancel" class="btn btn-secondary flex-1">{t.confirmModal.cancel}</button>
      <button type="button" id="confirm-modal-action" class="btn btn-primary flex-1">{t.confirmModal.confirm}</button>
    </div>
  </div>
</div>

<script>
  // Global Confirm Modal Dialog helper
  let confirmResolve: ((value: boolean) => void) | null = null;
  let lastFocused: HTMLElement | null = null;

  function lockBodyScroll(lock: boolean) {
    try {
      document.body.style.overflow = lock ? 'hidden' : '';
    } catch {}
  }

  (window as any).showConfirmDialog = function ({
    title,
    description,
    confirmText,
    cancelText,
    variant = 'primary',
    iconType = 'random',
  }: {
    title?: string;
    description?: string;
    confirmText?: string;
    cancelText?: string;
    variant?: 'primary' | 'danger';
    iconType?: 'random' | 'trash' | 'warning';
  }): Promise<boolean> {
    const i18n = (window as any).__TEMPO_I18N__?.confirmModal;
    const resolvedTitle = title || i18n?.confirm || 'Confirm Action';
    const resolvedDescription = description || i18n?.changeAddressDesc || 'Are you sure you want to proceed?';
    const resolvedConfirmText = confirmText || i18n?.confirm || 'Confirm';
    const resolvedCancelText = cancelText || i18n?.cancel || 'Cancel';

    return new Promise((resolve) => {
      // Re-entry guard: settle any orphaned earlier dialog instead of hanging it.
      if (confirmResolve) {
        confirmResolve(false);
        confirmResolve = null;
      }

      const modal = document.getElementById('confirm-modal');
      const content = document.getElementById('confirm-modal-content');
      if (!modal || !content) {
        // Modal not rendered on this page (e.g. blog/legal) — fall back to
        // native confirm instead of hanging the awaiting caller forever.
        try {
          resolve(window.confirm(`${resolvedTitle}\n\n${resolvedDescription}`));
        } catch {
          resolve(false);
        }
        return;
      }

      confirmResolve = resolve;
      lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;

      const titleEl = document.getElementById('confirm-modal-title');
      const descEl = document.getElementById('confirm-modal-description');
      const cancelBtn = document.getElementById('confirm-modal-cancel');
      const actionBtn = document.getElementById('confirm-modal-action') as HTMLButtonElement;
      const iconWrapper = document.getElementById('confirm-modal-icon-wrapper');

      const iconRandom = document.getElementById('confirm-icon-random');
      const iconTrash = document.getElementById('confirm-icon-trash');
      const iconWarning = document.getElementById('confirm-icon-warning');

      if (titleEl) titleEl.textContent = resolvedTitle;
      if (descEl) descEl.textContent = resolvedDescription;
      if (cancelBtn) cancelBtn.textContent = resolvedCancelText;

      if (actionBtn) {
        actionBtn.textContent = resolvedConfirmText;
        if (variant === 'danger') {
          actionBtn.className = 'btn btn-danger flex-1';
        } else {
          actionBtn.className = 'btn btn-primary flex-1';
        }
      }

      // Handle icon
      iconRandom?.classList.add('hidden');
      iconTrash?.classList.add('hidden');
      iconWarning?.classList.add('hidden');

      if (iconWrapper) {
        if (iconType === 'trash' || variant === 'danger') {
          iconWrapper.className = 'icon-tile w-12! h-12! rounded-2xl! mb-5 text-danger! bg-danger/8! border-danger/15!';
          iconTrash?.classList.remove('hidden');
        } else if (iconType === 'warning') {
          iconWrapper.className = 'icon-tile w-12! h-12! rounded-2xl! mb-5 text-[#b7791f]! bg-[#b7791f]/10! border-[#b7791f]/20!';
          iconWarning?.classList.remove('hidden');
        } else {
          iconWrapper.className = 'icon-tile w-12! h-12! rounded-2xl! mb-5';
          iconRandom?.classList.remove('hidden');
        }
      }

      if (modal && content) {
        modal.classList.remove('opacity-0', 'pointer-events-none');
        // Match MailboxController: a closed dialog is `inert` + aria-hidden.
        modal.removeAttribute('inert');
        modal.setAttribute('aria-hidden', 'false');
        content.classList.remove('scale-95');
        content.classList.add('scale-100');
        lockBodyScroll(true);
        const focusTarget = actionBtn || (document.getElementById('confirm-modal-cancel') as HTMLElement | null);
        setTimeout(() => focusTarget?.focus(), 50);
      }
    });
  };

  function closeConfirm(result: boolean) {
    const modal = document.getElementById('confirm-modal');
    const content = document.getElementById('confirm-modal-content');
    if (modal && content) {
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.setAttribute('inert', '');
      modal.setAttribute('aria-hidden', 'true');
      content.classList.remove('scale-100');
      content.classList.add('scale-95');
    }
    // Only release the scroll lock when no other app dialog is still open.
    const anyOtherOpen = ['qr-modal', 'custom-modal', 'history-modal'].some((id) => {
      const m = document.getElementById(id);
      return m && !m.classList.contains('pointer-events-none');
    });
    if (!anyOtherOpen) lockBodyScroll(false);
    if (confirmResolve) {
      confirmResolve(result);
      confirmResolve = null;
    }
    lastFocused?.focus?.();
    lastFocused = null;
  }

  // Focus trap: keep Tab cycling inside the open dialog.
  document.getElementById('confirm-modal-content')?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const modal = document.getElementById('confirm-modal');
    if (modal?.classList.contains('pointer-events-none')) return;
    const focusable = Array.from(
      document.querySelectorAll('#confirm-modal-content button')
    ).filter((el) => !(el as HTMLElement).hasAttribute('disabled')) as HTMLElement[];
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  document.getElementById('confirm-modal-cancel')?.addEventListener('click', () => closeConfirm(false));
  document.getElementById('confirm-modal-action')?.addEventListener('click', () => closeConfirm(true));
  document.getElementById('confirm-modal')?.addEventListener('click', (e) => {
    if (e.target === document.getElementById('confirm-modal')) {
      closeConfirm(false);
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const modal = document.getElementById('confirm-modal');
      if (modal && !modal.classList.contains('pointer-events-none')) {
        closeConfirm(false);
      }
    }
  });
</script>
