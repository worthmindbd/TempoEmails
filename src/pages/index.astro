---
import Layout from '../layouts/Layout.astro';
import MailboxManager from '../components/app/MailboxManager.astro';
import OtpShowcase from '../components/sections/OtpShowcase.astro';
import Features from '../components/sections/Features.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Faq from '../components/sections/Faq.astro';
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Can I send emails using TempoEmails?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. To ensure high deliverability, protect sender domain reputation, and prevent spamming abuse, TempoEmails is strictly a receive-only disposable email service. You can receive verification codes, activation links, and confirmation emails instantly.',
      },
    },
    {
      '@type': 'Question',
      name: 'How fast do verification emails and OTPs arrive?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Incoming emails and OTP codes typically arrive within 2 to 5 seconds. The inbox features automatic smart polling so you never need to manually refresh the page.',
      },
    },
    {
      '@type': 'Question',
      name: 'How long do temporary emails stay active?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Your temporary mailbox remains active as long as you keep this browser tab or session open, and is saved in your browser session history so you do not lose it upon refreshing. You can also manually delete it whenever you are finished.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is TempoEmails 100% free?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, TempoEmails is completely free to use without any hidden fees, subscription requirements, or limits on received emails.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do I need to sign up or provide personal details?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Never. You are automatically provided with a disposable email address the moment you visit the website. No name, password, phone number, or personal information is ever requested.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I choose my own custom email username?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes! Click the "Custom" button in the address bar to pick your preferred username alias and choose from our active domain pool.',
      },
    },
  ],
};
---

<Layout
  title="TempoEmails — Free Disposable Temporary Email & Verification Codes"
  description="Get a free disposable temporary email address instantly. Auto-extract OTP verification codes for Discord, ChatGPT, Steam & apps with zero logs."
  keywords="temp mail, temporary email, disposable email, throwaway email, burner email, fake email generator, 10 minute mail, 24 hour temp mail, temp mail for discord, temporary email for chatgpt, temp mail for telegram, temporary mail for steam, disposable email rest api"
  isApp={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <!-- Hero Section -->
  <section class="relative pt-8 pb-5 sm:pt-12 sm:pb-8 md:pt-16 md:pb-10 px-4 sm:px-6 lg:px-8 text-center max-w-5xl mx-auto space-y-4 sm:space-y-5">
    <!-- Editorial Display Headline (DESIGN.md specification) -->
    <h1 class="font-display text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold text-[#202020] dark:text-[#fcfcfc] tracking-tight leading-[1.08] sm:leading-[1.05]">
      Temporary email. <br class="hidden sm:inline" />
      <span class="bg-gradient-to-r from-[#ea2804] via-[#ff6a3d] to-[#ea2804] bg-clip-text text-transparent">
        Instant privacy.
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="text-sm sm:text-lg text-[#575757] dark:text-zinc-300 max-w-2xl mx-auto leading-relaxed">
      Generate a disposable burner inbox in one click. Receive signup verification codes, activation OTPs, and confirmation links without ever exposing your personal email.
    </p>
  </section>

  <!-- Interactive TempMail Box Island -->
  <section id="mailbox-manager" class="px-3 sm:px-6 lg:px-8 pb-12">
    <MailboxManager />
  </section>

  <!-- OTP Feature Showcase -->
  <OtpShowcase />

  <!-- Features Grid -->
  <Features />

  <!-- 4-Step Process Guide -->
  <HowItWorks />

  <!-- FAQ Accordion -->
  <Faq />
</Layout>
