---
import { useTranslation } from '../../i18n/utils';
import type { Locale } from '../../i18n/languages';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslation(locale);
---

<div id="email-detail-container" class="h-full flex flex-col bg-surface">
  <!-- Nothing selected -->
  <div id="email-detail-empty" class="flex flex-col items-center justify-center p-8 text-center h-full min-h-[400px]">
    <div class="relative w-40 h-28 mb-6" aria-hidden="true">
      <div class="absolute inset-x-6 top-0 h-20 rounded-xl surface-inset rotate-[-5deg]"></div>
      <div class="absolute inset-x-3 top-3 h-20 rounded-xl surface rotate-[3deg]"></div>
      <div class="absolute inset-x-0 top-6 rounded-xl surface p-3 space-y-2 text-start">
        <div class="flex items-center gap-2">
          <span class="w-5 h-5 rounded-md bg-accent/15"></span>
          <span class="h-2 w-16 rounded-full bg-ink/12"></span>
        </div>
        <span class="block h-2 w-full rounded-full bg-ink/8"></span>
        <span class="block h-2 w-2/3 rounded-full bg-ink/8"></span>
      </div>
    </div>
    <h3 class="font-display text-lg font-semibold text-ink mb-1.5">{t.emailDetail.noMessageTitle}</h3>
    <p class="text-sm text-muted max-w-xs leading-relaxed">{t.emailDetail.noMessageDesc}</p>
  </div>

  <!-- Loading skeleton -->
  <div id="email-detail-loading" class="hidden flex-col p-5 sm:p-7 h-full min-h-[400px]" aria-busy="true">
    <div class="w-full space-y-5 animate-pulse">
      <span class="sr-only">{t.emailDetail.loading}</span>
      <div class="h-6 w-2/3 rounded-lg bg-ink/10"></div>
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-ink/10"></div>
        <div class="space-y-2 flex-1">
          <div class="h-3 w-40 rounded-full bg-ink/10"></div>
          <div class="h-3 w-28 rounded-full bg-ink/7"></div>
        </div>
      </div>
      <div class="h-64 rounded-2xl bg-ink/6"></div>
    </div>
  </div>

  <!-- Message -->
  <div id="email-detail-content" class="hidden h-full flex flex-col">
    <div class="px-4 sm:px-7 pt-4 sm:pt-5 pb-5 border-b hairline space-y-4">
      <div class="flex items-center justify-between gap-2">
        <button id="email-detail-back-btn" type="button" class="md:hidden btn btn-ghost btn-sm -ms-2 text-ink!">
          <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"></path>
          </svg>
          {t.emailDetail.backToInbox}
        </button>

        <div class="flex items-center gap-1 ms-auto">
          <div class="inline-flex p-0.5 rounded-full bg-ink/6 text-xs me-1" role="group">
            <button id="tab-html-btn" type="button" class="h-7 px-3 rounded-full font-medium transition-all bg-surface text-ink shadow-soft cursor-pointer">
              {t.emailDetail.htmlTab}
            </button>
            <button id="tab-text-btn" type="button" class="h-7 px-3 rounded-full font-medium transition-all text-muted hover:text-ink cursor-pointer">
              {t.emailDetail.textTab}
            </button>
          </div>
          <button
            id="download-email-btn"
            type="button"
            class="btn btn-ghost w-9 h-9 p-0"
            title={t.emailDetail.downloadTooltip}
            aria-label={t.emailDetail.downloadTooltip || 'Download email text'}
          >
            <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"></path>
            </svg>
          </button>
          <button
            id="delete-msg-btn"
            type="button"
            class="btn btn-ghost w-9 h-9 p-0 hover:text-[#c81e3a]!"
            title={t.emailDetail.deleteTooltip}
            aria-label={t.emailDetail.deleteTooltip || 'Delete message'}
          >
            <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            </svg>
          </button>
        </div>
      </div>

      <div id="msg-subject-display" role="heading" aria-level="3" class="font-display text-xl sm:text-2xl font-semibold tracking-tight text-ink break-words leading-snug">
        {t.emailDetail.noSubject || 'Subject'}
      </div>

      <div class="flex items-start gap-3">
        <div id="sender-avatar" class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand to-brand-glow text-white font-semibold grid place-items-center uppercase shrink-0 shadow-soft">
          S
        </div>
        <div class="min-w-0 flex-1 text-sm">
          <div class="flex flex-wrap items-baseline gap-x-2">
            <span id="msg-from-name" class="font-semibold text-ink break-words">{t.emailDetail.defaultSender || 'Sender'}</span>
            <span id="msg-from-address" class="font-mono text-xs text-subtle break-all">sender@example.com</span>
          </div>
          <div class="text-xs text-subtle break-all mt-0.5">
            <span id="msg-to-label">{t.emailDetail.toLabel || 'To:'}</span> <span id="msg-to-address" class="font-mono">you@tempo.mail</span>
          </div>
        </div>
        <span id="msg-date-full" class="hidden sm:block text-xs text-subtle font-mono shrink-0 pt-0.5">{t.emailDetail.defaultDate || 'Date'}</span>
      </div>
    </div>

    <!-- Detected OTP -->
    <div id="otp-highlight-banner" class="hidden mx-4 sm:mx-7 mt-4 rounded-2xl p-[1px] bg-gradient-to-r from-brand/60 via-brand-glow/50 to-brand/60">
      <div class="rounded-[15px] bg-surface px-4 py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-[radial-gradient(120%_140%_at_0%_0%,color-mix(in_srgb,var(--brand)_10%,transparent),transparent_60%)]">
        <div class="min-w-0">
          <span class="flex items-center gap-1.5 text-xs font-medium text-accent-text">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
            {t.emailDetail.otpDetected}
          </span>
          <div id="detected-otp-code" class="font-mono text-[28px] sm:text-[32px] font-semibold tracking-[0.18em] text-ink break-all leading-tight mt-0.5">
            123456
          </div>
        </div>
        <button type="button" id="copy-otp-btn" class="btn btn-primary w-full sm:w-auto">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2.5"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span>{t.emailDetail.copyOtp}</span>
        </button>
      </div>
    </div>

    <!-- Detected verification link -->
    <div id="verify-link-banner" class="hidden mx-4 sm:mx-7 mt-3 rounded-2xl surface-inset px-4 py-3 text-sm flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4">
      <div class="flex items-center gap-2.5 min-w-0 flex-1">
        <span class="icon-tile w-8! h-8! rounded-lg! shrink-0" aria-hidden="true">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
        </span>
        <div class="min-w-0">
          <span class="block text-xs font-medium text-muted">{t.emailDetail.verifyLink}</span>
          <span id="detected-verify-url" class="block font-mono text-xs text-ink truncate"></span>
        </div>
      </div>
      <a id="open-verify-link" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm shrink-0">
        {t.emailDetail.openLink}
        <svg class="w-3.5 h-3.5 rtl:-scale-x-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"></path></svg>
      </a>
    </div>

    <!-- Body -->
    <div class="flex-1 overflow-hidden relative p-4 sm:p-7 min-h-[380px] sm:min-h-[440px]">
      <div id="html-view-wrapper" class="w-full h-full min-h-[380px] sm:min-h-[440px] rounded-2xl overflow-hidden border hairline bg-white">
        <iframe
          id="email-html-frame"
          title="Email content"
          sandbox="allow-popups allow-popups-to-escape-sandbox"
          class="w-full h-full min-h-[380px] sm:min-h-[440px] border-0"
        ></iframe>
      </div>
      <div id="text-view-wrapper" class="hidden w-full h-full min-h-[380px] sm:min-h-[440px] overflow-y-auto p-5 rounded-2xl surface-inset font-mono text-[13px] leading-relaxed text-ink-2 whitespace-pre-wrap select-text">
        <div id="email-text-content"></div>
      </div>
    </div>
  </div>
</div>
