# ==============================================================================
# TempoEmails — Environment Variables Template
# ==============================================================================
# Copy this file to .env or prod.env and fill in your actual values.
# ==============================================================================

# --- [1. SITE & SERVER CONFIGURATION] ---
SITE_URL=https://tempoemails.dev
PUBLIC_SITE_URL=https://tempoemails.dev
PORT=3012
HOST=0.0.0.0
NODE_ENV=production

# --- [2. GOOGLE ADSENSE MONETIZATION] ---
PUBLIC_GOOGLE_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX
PUBLIC_GOOGLE_ADSENSE_SLOT_ID=

# --- [3. GOOGLE ANALYTICS & TAG MANAGER] ---
PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
PUBLIC_GTM_ID=

# --- [4. SEARCH CONSOLE & WEBMASTER VERIFICATIONS] ---
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
PUBLIC_YANDEX_VERIFICATION=

# --- [5. PRIVACY-FIRST ANALYTICS ALTERNATIVES (OPTIONAL)] ---
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
