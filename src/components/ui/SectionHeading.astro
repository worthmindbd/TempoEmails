---
import { stripLeadingEmoji } from '../../lib/utils/text';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'start' | 'center';
  id?: string;
  class?: string;
}

const { eyebrow, title, subtitle, align = 'start', id, class: className = '' } = Astro.props;
---

<div class:list={[align === 'center' ? 'text-center mx-auto max-w-2xl' : 'max-w-2xl', className]} data-reveal>
  {eyebrow && <p class="eyebrow mb-4">{stripLeadingEmoji(eyebrow)}</p>}
  <h2 id={id} class="section-title">{title}</h2>
  {subtitle && (
    <p class:list={['mt-5 text-base sm:text-lg text-muted leading-relaxed max-w-xl', align === 'center' && 'mx-auto']}>
      {subtitle}
    </p>
  )}
  <slot />
</div>
