---
import GlassCard from '../ui/GlassCard.astro';
import Badge from '../ui/Badge.astro';

const steps = [
  {
    step: '01',
    title: 'Generate or Pick Alias',
    description: 'An instant disposable email address is assigned automatically, or you can craft a custom username with active domains.',
  },
  {
    step: '02',
    title: 'Use for Any Sign Up',
    description: 'Paste your temp address on any website requiring email verification, SaaS trials, forums, or downloads.',
  },
  {
    step: '03',
    title: 'Get Code Instantly',
    description: 'Incoming emails appear within seconds. Our smart extractor surfaces your OTP verification code with a 1-tap copy button.',
  },
  {
    step: '04',
    title: 'Auto-Expire & Forget',
    description: 'Done verifying? Keep the mailbox for as long as you want or wipe it clean. Zero spam will ever reach your personal inbox.',
  },
];
---

<section id="how-it-works" class="w-full max-w-6xl mx-auto my-16 px-4">
  <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
    <Badge variant="neutral" size="md">
      How It Works
    </Badge>
    <h2 class="font-display text-3xl md:text-4xl font-black text-[#202020] dark:text-[#fcfcfc] tracking-tight">
      Four simple steps to absolute inbox privacy.
    </h2>
    <p class="text-sm md:text-base text-[#575757] dark:text-zinc-400">
      No passwords, no personal information, and no credit cards required.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {steps.map((s) => (
      <GlassCard variant="card" class="p-6 relative group overflow-hidden border border-black/5 dark:border-white/10">
        <div class="font-mono text-4xl font-black text-[#ea2804]/20 dark:text-[#ea2804]/30 mb-4 transition-colors group-hover:text-[#ea2804]/40">
          {s.step}
        </div>
        <h3 class="font-display text-base font-bold text-[#202020] dark:text-[#fcfcfc] mb-2">
          {s.title}
        </h3>
        <p class="text-xs md:text-sm text-[#575757] dark:text-zinc-400 leading-relaxed">
          {s.description}
        </p>
      </GlassCard>
    ))}
  </div>
</section>
