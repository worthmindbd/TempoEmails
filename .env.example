# Google Analytics 4
PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Google AdSense
PUBLIC_GOOGLE_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX

# Canonical site URL (baked into build output; also drives server.mjs redirects)
SITE_URL=https://tempoemails.com

# server.mjs bind address
HOST=0.0.0.0
PORT=4321

# Number of reverse proxies you control in front of server.mjs (1 = Traefik,
# 2 = Cloudflare -> Traefik). Unset, the /api/mail rate limiter uses the socket
# address, so behind a proxy every visitor shares one bucket.
# TRUST_PROXY=1
