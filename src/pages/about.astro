---
import ContentLayout from '../layouts/ContentLayout.astro';
import { SITE_CONFIG } from '../lib/config';
import { useTranslation, getLocaleFromUrl, getLocalizedPath } from '../i18n/utils';
import { getAboutPageData } from '../i18n/pages-data';
import type { Locale } from '../i18n/languages';

interface Props {
  locale?: Locale;
}

const { locale } = Astro.props;
const currentLocale = locale || getLocaleFromUrl(Astro.url);
const t = useTranslation(currentLocale);
const about = getAboutPageData(currentLocale);
const contactUrl = getLocalizedPath('/contact/', currentLocale);

const siteUrl = Astro.site?.origin || SITE_CONFIG.siteUrl;
let normalizedPath = Astro.url.pathname;
if (!normalizedPath.endsWith('/')) normalizedPath = `${normalizedPath}/`;
const aboutUrl = new URL(normalizedPath, siteUrl);

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: t.pages.about.title,
  description: t.pages.about.description,
  url: aboutUrl.href,
  inLanguage: currentLocale,
  mainEntity: {
    '@type': 'Organization',
    '@id': `${aboutUrl.origin}/#organization`,
    name: 'TempoEmails',
  },
};
---

<ContentLayout
  title={t.pages.about.title}
  description={t.pages.about.description}
  locale={currentLocale}
  keywords="about tempoemails, free temp mail service, disposable temporary email provider, 10 minute mail mission, anonymous burner email, privacy first email"
>
  <script type="application/ld+json" set:html={JSON.stringify(aboutPageSchema)} />
  <p>
    {about.lead}
  </p>

  <p>
    {about.story}
  </p>

  <blockquote>
    {about.quote}
  </blockquote>

  <h2>
    {about.whyHeading}
  </h2>
  <p>
    {about.whyP1}
  </p>
  <p>
    {about.whyP2}
  </p>

  <div class="grid sm:grid-cols-2 gap-3 my-8!">
    {about.features.map((f) => (
      <div class="surface rounded-2xl p-5">
        <span class="icon-tile text-xl mb-4" aria-hidden="true">{f.icon}</span>
        <h3 class="font-display text-lg font-semibold tracking-tight text-ink">{f.title}</h3>
        <p class="mt-1.5 text-sm text-muted leading-relaxed">{f.desc}</p>
      </div>
    ))}
  </div>

  <h2>
    {about.principlesHeading}
  </h2>
  <ul>
    {about.principles.map((p) => (
      <li>
        <strong>{p.label}:</strong> {p.desc}
      </li>
    ))}
  </ul>

  <h2>
    {about.questionsHeading}
  </h2>
  <p>
    {about.questionsLead} <a href={contactUrl}>{about.contactPageLink}</a> {currentLocale === 'en' ? 'or drop us an email at' : '—'} <a href={`mailto:${SITE_CONFIG.emails.contact}`}>{SITE_CONFIG.emails.contact}</a>.
  </p>
</ContentLayout>
