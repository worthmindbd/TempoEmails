---
import { useTranslation, getLocalizedPath } from '../../i18n/utils';
import { stripLeadingEmoji } from '../../lib/utils/text';
import type { Locale } from '../../i18n/languages';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslation(locale);
const contactUrl = getLocalizedPath('/contact/', locale);

const faqs = [
  { q: t.faq.q1, a: t.faq.a1 },
  { q: t.faq.q2, a: t.faq.a2 },
  { q: t.faq.q3, a: t.faq.a3 },
  { q: t.faq.q4, a: t.faq.a4 },
  { q: t.faq.q5, a: t.faq.a5 },
  { q: t.faq.q6, a: t.faq.a6 },
];
---

<section id="faq" class="px-5 sm:px-8 py-16 sm:py-24">
  <div class="max-w-6xl mx-auto grid lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-20">
    <div class="lg:sticky lg:top-28 self-start" data-reveal>
      <p class="eyebrow mb-4">{stripLeadingEmoji(t.faq.badge)}</p>
      <h2 class="section-title">{t.faq.title}</h2>
      <p class="mt-5 text-base text-muted leading-relaxed max-w-sm">{t.faq.subtitle}</p>
      <a href={contactUrl} class="btn btn-secondary mt-8">
        {t.nav.contact}
        <svg class="w-4 h-4 rtl:-scale-x-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </div>

    <div class="divide-y divide-line border-y hairline" data-reveal style="--reveal-delay: 1">
      {faqs.map((faq) => (
        <details class="group">
          <summary class="flex items-start justify-between gap-6 py-6 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <h3 class="font-display text-lg sm:text-xl font-semibold tracking-tight text-ink group-hover:text-accent-text transition-colors">{faq.q}</h3>
            <span class="relative shrink-0 grid place-items-center w-8 h-8 mt-0.5 rounded-full border border-line-strong text-ink-2 transition-transform duration-300 group-open:rotate-45 group-open:bg-ink group-open:text-canvas group-open:border-ink" aria-hidden="true">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
            </span>
          </summary>
          <p class="pb-6 pe-14 text-base text-muted leading-relaxed">{faq.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
