---
import { SUPPORTED_LOCALES, LANGUAGES, type Locale } from '../../i18n/languages';
import { getLocalizedPath, useTranslation } from '../../i18n/utils';

interface Props {
  currentLocale: Locale;
  variant?: 'header' | 'footer' | 'drawer';
}

const { currentLocale = 'en', variant = 'header' } = Astro.props;
const currentLanguage = LANGUAGES[currentLocale] || LANGUAGES.en;
const t = useTranslation(currentLocale);
const pathname = Astro.url.pathname;
---

<div class:list={['relative language-selector-root text-start', variant === 'drawer' ? 'block w-full' : 'inline-block']} data-variant={variant}>
  <button
    type="button"
    class:list={[
      'lang-trigger-btn flex items-center gap-1.5 rounded-full font-medium transition-colors cursor-pointer select-none',
      variant === 'footer' && 'h-9 px-3.5 text-sm text-ink-2 border hairline hover:border-line-strong hover:text-ink',
      variant === 'drawer' && 'w-full justify-between h-12 px-4 rounded-2xl text-[15px] bg-ink/4 text-ink hover:bg-ink/7',
      variant === 'header' && 'h-9 px-2.5 text-sm text-muted hover:text-ink hover:bg-ink/5',
    ]}
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label={t.a11y.changeLanguage.replace('{lang}', currentLanguage.nativeName)}
  >
    <span class="flex items-center gap-2">
      <svg class="w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
      </svg>
      <span class:list={[variant === 'header' ? 'uppercase text-xs font-semibold tracking-wide' : '']}>
        {variant === 'header' ? currentLanguage.code : currentLanguage.nativeName}
      </span>
    </span>
    <svg class="w-3.5 h-3.5 opacity-60 transition-transform duration-200 lang-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round">
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>

  <div
    class:list={[
      'lang-dropdown-menu hidden absolute z-50 w-60 max-h-80 overflow-y-auto rounded-2xl surface-raised p-1.5 transition-all duration-200 opacity-0 scale-95',
      variant === 'footer' ? 'bottom-full mb-2 start-0 origin-bottom' : variant === 'drawer' ? 'bottom-full mb-2 inset-x-0 w-auto origin-bottom' : 'top-full mt-2 end-0 origin-top-right',
    ]}
    role="menu"
  >
    <div class="px-3 pt-2 pb-1.5 text-xs font-medium text-subtle flex items-center justify-between">
      <span>{t.nav.selectLanguage}</span>
      <span class="font-mono">{SUPPORTED_LOCALES.length}</span>
    </div>
    {
      SUPPORTED_LOCALES.map((locale) => {
        const lang = LANGUAGES[locale];
        const isCurrent = locale === currentLocale;
        return (
          <a
            href={getLocalizedPath(pathname, locale)}
            hreflang={lang.hreflang}
            aria-current={isCurrent ? 'true' : undefined}
            class:list={[
              'flex items-center justify-between gap-3 px-3 py-2 rounded-xl text-sm transition-colors',
              isCurrent ? 'bg-accent/8 text-accent-text font-semibold' : 'text-ink hover:bg-ink/5',
            ]}
            role="menuitem"
          >
            <span class="flex items-center gap-2.5">
              <span class="text-base leading-none select-none" aria-hidden="true">{lang.flag}</span>
              <span>{lang.nativeName}</span>
            </span>
            <span class="text-xs text-subtle">{lang.name}</span>
          </a>
        );
      })
    }
  </div>
</div>

<script>
  function setupLanguageSelectors() {
    if ((window as any).__tempoLangBound) return;
    (window as any).__tempoLangBound = true;
    document.querySelectorAll('.language-selector-root').forEach((container) => {
      if ((container as HTMLElement).dataset.bound === 'true') return;
      (container as HTMLElement).dataset.bound = 'true';
      const trigger = container.querySelector('.lang-trigger-btn');
      const menu = container.querySelector('.lang-dropdown-menu');
      const chevron = container.querySelector('.lang-chevron');

      if (!trigger || !menu) return;

      const toggleMenu = (open?: boolean) => {
        const isHidden = menu.classList.contains('hidden');
        const shouldOpen = open !== undefined ? open : isHidden;

        if (shouldOpen) {
          // Close any other open menus first — including resetting their
          // trigger's aria-expanded, which used to stay "true" forever.
          document.querySelectorAll('.language-selector-root').forEach((otherRoot) => {
            if (otherRoot === container) return;
            const otherMenu = otherRoot.querySelector('.lang-dropdown-menu');
            const otherTrigger = otherRoot.querySelector('.lang-trigger-btn');
            if (otherMenu) {
              otherMenu.classList.add('hidden', 'opacity-0', 'scale-95');
              otherMenu.classList.remove('opacity-100', 'scale-100');
            }
            otherTrigger?.setAttribute('aria-expanded', 'false');
            otherRoot.querySelector('.lang-chevron')?.classList.remove('rotate-180');
          });

          menu.classList.remove('hidden');
          requestAnimationFrame(() => {
            menu.classList.remove('opacity-0', 'scale-95');
            menu.classList.add('opacity-100', 'scale-100');
            chevron?.classList.add('rotate-180');
            trigger.setAttribute('aria-expanded', 'true');
          });
        } else {
          menu.classList.remove('opacity-100', 'scale-100');
          menu.classList.add('opacity-0', 'scale-95');
          chevron?.classList.remove('rotate-180');
          trigger.setAttribute('aria-expanded', 'false');
          setTimeout(() => {
            menu.classList.add('hidden');
          }, 150);
        }
      };

      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMenu();
      });

      // Close menu when clicking outside
      document.addEventListener('click', (e) => {
        if (!container.contains(e.target as Node)) {
          toggleMenu(false);
        }
      });

      // Close menu on Escape key and return focus to the trigger
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          const wasOpen = !menu.classList.contains('hidden');
          toggleMenu(false);
          if (wasOpen) (trigger as HTMLElement).focus();
        }
      });
    });
  }

  setupLanguageSelectors();
  document.addEventListener('astro:page-load', setupLanguageSelectors);
</script>
