      <div class="flex flex-wrap gap-2 text-xs text-zinc-400">
        <a href="/#mailbox-manager" class="px-2.5 py-1 rounded-md bg-white/5 hover:bg-white/10 hover:text-white transition-colors">Free Temp Mail</a>
