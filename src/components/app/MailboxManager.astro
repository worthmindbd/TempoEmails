---
import GlassCard from '../ui/GlassCard.astro';
import EmailAddressBar from './EmailAddressBar.astro';
import InboxList from './InboxList.astro';
import EmailDetail from './EmailDetail.astro';
import QrCodeModal from './QrCodeModal.astro';
import CustomInboxModal from './CustomInboxModal.astro';
import InboxHistoryDrawer from './InboxHistoryDrawer.astro';
import ConfirmModal from '../ui/ConfirmModal.astro';
import type { Locale } from '../../i18n/languages';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

<div id="mailbox-manager" class="w-full max-w-6xl mx-auto space-y-5">
  <!-- Top Address & Action Controls Island -->
  <EmailAddressBar locale={locale} />

  <!-- Main Inbox Grid (Split View on Desktop, Toggle on Mobile) -->
  <GlassCard variant="panel" class="overflow-hidden border border-white/60 dark:border-white/10 shadow-2xl">
    <div class="grid grid-cols-1 md:grid-cols-12 min-h-[540px]">
      <!-- Left Column: Inbox List (md:col-span-5 or 4) -->
      <div id="inbox-list-pane" class="md:col-span-5 lg:col-span-4 border-r border-black/5 dark:border-white/10 h-full">
        <InboxList locale={locale} />
      </div>

      <!-- Right Column: Email Reader Detail (md:col-span-7 or 8) -->
      <div id="email-detail-pane" class="hidden md:block md:col-span-7 lg:col-span-8 h-full">
        <EmailDetail locale={locale} />
      </div>
    </div>
  </GlassCard>

  <!-- Modals -->
  <QrCodeModal locale={locale} />
  <CustomInboxModal locale={locale} />
  <InboxHistoryDrawer locale={locale} />
  <ConfirmModal locale={locale} />
</div>

<script>
  import { MailService } from '../../lib/mail/service';
  import { StorageManager } from '../../lib/utils/storage';
  import { copyToClipboard } from '../../lib/utils/clipboard';
  import { formatRelativeTime, formatFullDateTime } from '../../lib/utils/date-formatter';
  import { generateQrCodeSvg } from '../../lib/utils/qrcode';
  import { sanitizeEmailHtml, escapeHtml } from '../../lib/utils/sanitize';
  import { SITE_CONFIG } from '../../lib/config';
  import type { MailAccount, MailMessage, DetailedMailMessage, MailDomain } from '../../lib/mail/types';

  const POLL_SECONDS = 10;

  class MailboxController {
    private account: MailAccount | null = null;
    private messages: MailMessage[] = [];
    private selectedMessage: DetailedMailMessage | null = null;
    private timerInterval: any = null;
    private pollCountdown: number = POLL_SECONDS;
    private isPolling: boolean = false;
    private pendingFetch: boolean = false;
    private fetchGen: number = 0;
    private destroyed: boolean = false;
    private availableDomains: MailDomain[] = [];
    private sseSource: EventSource | null = null;
    private addressDisplayBackup: string | null = null;

    async init() {
      this.bindEvents();
      document.addEventListener('visibilitychange', this.handleVisibility);
      window.addEventListener('beforeunload', this.handleUnload);
      await this.loadInitialMailbox();
      this.startAutoRefresh();
      this.loadDomains();
    }

    private handleVisibility = () => {
      if (!document.hidden && !this.destroyed) {
        this.fetchMessages();
      }
    };

    private handleUnload = () => {
      this.destroyed = true;
      if (this.timerInterval) clearInterval(this.timerInterval);
      if (this.sseSource) {
        this.sseSource.close();
        this.sseSource = null;
      }
    };

    async loadInitialMailbox(
      forceNew: boolean = false,
      preferredProvider?: 'mailtm' | 'inboxes' | 'tempmaillol' | 'guerrilla',
      excludeDomain?: string
    ) {
      this.fetchGen++;
      this.showAddressLoading(true);
      if (this.sseSource) {
        this.sseSource.close();
        this.sseSource = null;
      }
      try {
        this.account = await MailService.getOrCreateAccount(forceNew, preferredProvider, excludeDomain);
        this.updateAddressDisplay();

        // Warn clearly if every live provider is unreachable and the app fell
        // back to the simulated inbox (it cannot receive real email).
        if (this.account.provider === 'mock') {
          const i18nWarn = (window as any).__TEMPO_I18N__;
          window.dispatchEvent(
            new CustomEvent('tempomail:toast', {
              detail: {
                message: i18nWarn?.toasts?.mockFallback || 'All mail providers are unreachable right now — this is a simulated inbox and cannot receive real email.',
                type: 'error',
                duration: 6000,
              },
            })
          );
        }

        // Immediately render locally stored messages for instant response
        this.messages = StorageManager.getCachedMessages(this.account.address);
        this.renderMessageList();

        this.connectRealtimeStream();
        await this.fetchMessages(true);
      } catch (err) {
        console.error('Failed to init mailbox:', err);
        const i18n = (window as any).__TEMPO_I18N__;
        window.dispatchEvent(
          new CustomEvent('tempomail:toast', {
            detail: { message: i18n?.toasts?.initFailed || 'Failed to initialize mailbox. Please try refreshing.', type: 'error' },
          })
        );
      } finally {
        this.showAddressLoading(false);
      }
    }

    connectRealtimeStream() {
      if (!this.account || this.account.provider !== 'mailtm' || !this.account.id) return;
      if (typeof window === 'undefined' || typeof EventSource === 'undefined') return;

      try {
        if (this.sseSource) {
          this.sseSource.close();
        }
        // mail.gw accounts never get events from the mail.tm hub — skip SSE
        // and rely on polling instead of opening a dead, IP-leaking connection.
        const apiBase = this.account.apiBase || '/api/mail/mailtm';
        if (!apiBase.endsWith('/mailtm')) {
          this.sseSource = null;
          return;
        }
        const sseUrl = `https://mercure.mail.tm/.well-known/mercure?topic=/accounts/${this.account.id}`;
        this.sseSource = new EventSource(sseUrl);

        this.sseSource.onmessage = () => {
          this.fetchMessages();
        };

        this.sseSource.onerror = () => {
          // If SSE drops, fallback timer handles polling automatically
          this.sseSource?.close();
          this.sseSource = null;
        };
      } catch {
        // Fallback polling active
      }
    }

    async loadDomains() {
      try {
        this.availableDomains = await MailService.getAvailableDomains();
        this.populateDomainSelect();
      } catch (err) {
        console.warn('Could not load domains', err);
      }
    }

    populateDomainSelect() {
      const select = document.getElementById('custom-domain-select') as HTMLSelectElement;
      if (!select) return;

      select.innerHTML = '';

      if (this.availableDomains.length === 0) {
        const opt = document.createElement('option');
        opt.value = '';
        opt.disabled = true;
        opt.selected = true;
        opt.textContent = 'Could not load domains — please try again';
        select.appendChild(opt);
        this.updateCustomPreview();
        return;
      }

      // Only providers that genuinely support user-chosen usernames + domains
      // are offered here. TempMail.lol assigns its own random address, and the
      // simulated (mock) domains cannot receive real email at all.
      const mailtmDomains = this.availableDomains.filter((d) => d.provider === 'mailtm');
      const inboxesDomains = this.availableDomains.filter((d) => d.provider === 'inboxes');
      const guerrillaDomains = this.availableDomains.filter((d) => d.provider === 'guerrilla');

      if (mailtmDomains.length > 0) {
        const group = document.createElement('optgroup');
        group.label = '⭐ Mail.tm & Mail.gw (Private / Authenticated)';
        mailtmDomains.forEach((d) => {
          const opt = document.createElement('option');
          opt.value = d.domain;
          opt.dataset.provider = 'mailtm';
          opt.textContent = `@${d.domain}`;
          group.appendChild(opt);
        });
        select.appendChild(group);
      }

      if (inboxesDomains.length > 0) {
        const group = document.createElement('optgroup');
        group.label = '🚀 Inboxes Network (GetNada, AirMail, Bear, etc.)';
        inboxesDomains.forEach((d) => {
          const opt = document.createElement('option');
          opt.value = d.domain;
          opt.dataset.provider = 'inboxes';
          opt.textContent = `@${d.domain}`;
          group.appendChild(opt);
        });
        select.appendChild(group);
      }

      if (guerrillaDomains.length > 0) {
        const group = document.createElement('optgroup');
        group.label = '🛡️ Guerrilla Mail';
        guerrillaDomains.forEach((d) => {
          const opt = document.createElement('option');
          opt.value = d.domain;
          opt.dataset.provider = 'guerrilla';
          opt.textContent = `@${d.domain}`;
          group.appendChild(opt);
        });
        select.appendChild(group);
      }

      this.updateCustomPreview();
    }

    updateAddressDisplay() {
      const display = document.getElementById('current-email-display');
      const providerBadge = document.getElementById('provider-badge');
      if (!this.account || !display) return;

      display.textContent = this.account.address;
      if (providerBadge) {
        const prov = this.account.provider;
        if (prov === 'mailtm') {
          providerBadge.textContent = 'MAIL.TM';
          providerBadge.className = 'text-[9px] uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/25 font-mono font-bold cursor-pointer hover:opacity-80 transition-opacity';
          providerBadge.title = 'Click to switch provider';
        } else if (prov === 'inboxes') {
          providerBadge.textContent = 'INBOXES';
          providerBadge.className = 'text-[9px] uppercase tracking-wider px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/25 font-mono font-bold cursor-pointer hover:opacity-80 transition-opacity';
          providerBadge.title = 'Click to switch provider';
        } else if (prov === 'tempmaillol') {
          providerBadge.textContent = 'TEMPMAIL';
          providerBadge.className = 'text-[9px] uppercase tracking-wider px-2 py-0.5 rounded-full bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-500/25 font-mono font-bold cursor-pointer hover:opacity-80 transition-opacity';
          providerBadge.title = 'Click to switch provider';
        } else if (prov === 'guerrilla') {
          providerBadge.textContent = 'GUERRILLA';
          providerBadge.className = 'text-[9px] uppercase tracking-wider px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/25 font-mono font-bold cursor-pointer hover:opacity-80 transition-opacity';
          providerBadge.title = 'Click to switch provider';
        } else {
          providerBadge.textContent = 'MOCK';
          providerBadge.className = 'text-[9px] uppercase tracking-wider px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/25 font-mono font-bold';
        }
      }
    }

    showAddressLoading(loading: boolean) {
      const display = document.getElementById('current-email-display');
      if (!display) return;
      if (loading) {
        // Remember the current content so a failed load can restore it —
        // previously a failed mailbox creation left a skeleton forever.
        if (this.addressDisplayBackup === null) {
          this.addressDisplayBackup = display.textContent || '';
        }
        display.innerHTML = '<span class="inline-block w-48 h-5 bg-black/10 dark:bg-white/10 animate-pulse rounded"></span>';
      } else {
        // If the address was NOT re-rendered yet (failure path) the skeleton is
        // still showing — restore the previous content. On success paths
        // updateAddressDisplay() already replaced the skeleton.
        if (this.addressDisplayBackup !== null && display.querySelector('.animate-pulse')) {
          display.textContent = this.addressDisplayBackup;
        }
        this.addressDisplayBackup = null;
      }
    }

    async fetchMessages(isInitial: boolean = false) {
      if (!this.account || this.destroyed) return;
      if (this.isPolling) {
        this.pendingFetch = true;
        return;
      }
      this.isPolling = true;
      const gen = ++this.fetchGen;
      const accountAddress = this.account.address;

      const refreshIcon = document.getElementById('refresh-icon');
      if (refreshIcon) refreshIcon.classList.add('animate-spin');

      try {
        const fetched = await MailService.getMessages(this.account, isInitial);
        // Stale fetch guard: a slower earlier request must not overwrite the
        // mailbox the user already switched to.
        if (gen !== this.fetchGen || this.account.address !== accountAddress) return;
        this.messages = fetched;
        this.renderMessageList();
      } catch (err) {
        console.warn('Message fetch error', err);
        if (gen !== this.fetchGen || !this.account || this.account.address !== accountAddress) return;
        this.messages = StorageManager.getCachedMessages(accountAddress);
        this.renderMessageList();
      } finally {
        this.isPolling = false;
        if (refreshIcon) refreshIcon.classList.remove('animate-spin');
        this.resetRefreshTimer();
        if (this.pendingFetch && !this.destroyed) {
          this.pendingFetch = false;
          this.fetchMessages();
        }
      }
    }

    startAutoRefresh() {
      if (this.timerInterval) clearInterval(this.timerInterval);

      this.pollCountdown = POLL_SECONDS;
      this.timerInterval = setInterval(() => {
        if (document.hidden || this.destroyed) return;
        this.pollCountdown = Math.max(0, this.pollCountdown - 1);
        const progressBar = document.getElementById('refresh-progress-bar');

        if (progressBar) {
          const pct = Math.min(100, ((POLL_SECONDS - this.pollCountdown) / POLL_SECONDS) * 100);
          progressBar.style.width = `${pct}%`;
        }

        if (this.pollCountdown <= 0) {
          this.fetchMessages();
        }
      }, 1000);
    }

    resetRefreshTimer() {
      this.pollCountdown = POLL_SECONDS;
      const progressBar = document.getElementById('refresh-progress-bar');
      if (progressBar) progressBar.style.width = '0%';
    }

    renderMessageList() {
      const emptyState = document.getElementById('inbox-empty-state');
      const listContainer = document.getElementById('inbox-items-list');
      const countBadge = document.getElementById('inbox-count-badge');
      const i18n = (window as any).__TEMPO_I18N__;

      if (countBadge) {
        countBadge.textContent = String(this.messages.length);
        const unread = this.messages.filter((m) => !m.seen).length;
        if (unread > 0) {
          const unreadLabel = unread > 1 ? (i18n?.inboxList?.unreadEmails || 'unread emails') : (i18n?.inboxList?.unreadEmail || 'unread email');
          countBadge.title = `${unread} ${unreadLabel}`;
        } else {
          const totalLabel = this.messages.length !== 1 ? (i18n?.inboxList?.totalEmails || 'emails') : (i18n?.inboxList?.totalEmail || 'email');
          countBadge.title = `${this.messages.length} ${totalLabel}`;
        }
      }

      if (!listContainer || !emptyState) return;

      if (this.messages.length === 0) {
        emptyState.classList.remove('hidden');
        listContainer.classList.add('hidden');
        listContainer.innerHTML = '';
        return;
      }

      emptyState.classList.add('hidden');
      listContainer.classList.remove('hidden');
      const scroller = document.getElementById('messages-container');
      const savedScrollTop = scroller ? scroller.scrollTop : 0;
      listContainer.innerHTML = '';

      this.messages.forEach((msg) => {
        const item = document.createElement('div');
        const isSelected = this.selectedMessage && this.selectedMessage.id === msg.id;
        const initial = (msg.from.name || msg.from.address || 'U').charAt(0).toUpperCase();
        const isUnread = !msg.seen;
        const unreadBadgeText = i18n?.inboxList?.unreadBadge || 'Unread';
        const noSubjectText = i18n?.emailDetail?.noSubject || '(No Subject)';
        const clickToViewText = i18n?.inboxList?.clickToView || 'Click to view email details...';

        item.className = `p-4 cursor-pointer transition-all hover:bg-black/5 dark:hover:bg-white/5 relative flex items-start gap-3 border-b border-black/5 dark:border-white/5 ${
          isSelected ? 'bg-[#ea2804]/10 dark:bg-[#ea2804]/15 border-l-4 border-l-[#ea2804]' : ''
        }`;

        // SECURITY: Build the item with DOM APIs + textContent only.
        // Email fields (from.name, subject, intro, OTP) are attacker-controlled;
        // never interpolate them into innerHTML.
        const avatar = document.createElement('div');
        avatar.className = 'relative w-9 h-9 rounded-full bg-gradient-to-br from-[#ea2804] to-[#ff6a3d] text-white flex items-center justify-center font-bold text-xs shrink-0 shadow-xs';
        avatar.textContent = initial;
        if (isUnread) {
          const unreadDot = document.createElement('span');
          unreadDot.className = 'absolute -top-0.5 -right-0.5 w-2.5 h-2.5 bg-blue-500 border-2 border-white dark:border-zinc-900 rounded-full';
          unreadDot.title = unreadBadgeText;
          avatar.appendChild(unreadDot);
        }

        const body = document.createElement('div');
        body.className = 'flex-1 min-w-0';

        const topRow = document.createElement('div');
        topRow.className = 'flex items-center justify-between gap-1 mb-1';

        const senderSpan = document.createElement('span');
        senderSpan.className = `font-bold text-xs ${isUnread ? 'text-[#ea2804] dark:text-[#ff6a3d]' : 'text-[#202020] dark:text-[#fcfcfc]'} truncate`;
        senderSpan.textContent = msg.from.name || msg.from.address;

        const timeSpan = document.createElement('span');
        timeSpan.className = 'text-[10px] text-[#8d8d8d] dark:text-zinc-400 font-mono shrink-0';
        timeSpan.textContent = formatRelativeTime(msg.createdAt);

        topRow.append(senderSpan, timeSpan);

        const subjectDiv = document.createElement('div');
        subjectDiv.className = `text-xs ${isUnread ? 'font-bold text-[#101010] dark:text-white' : 'font-medium text-[#3a3a3a] dark:text-zinc-300'} truncate mb-1`;
        subjectDiv.textContent = msg.subject || noSubjectText;

        const introDiv = document.createElement('div');
        introDiv.className = 'text-[11px] text-[#8d8d8d] dark:text-zinc-400 line-clamp-1';
        introDiv.textContent = msg.intro || clickToViewText;

        body.append(topRow, subjectDiv, introDiv);

        if (msg.extractedOtp) {
          const otpBadge = document.createElement('div');
          otpBadge.className = 'mt-2 inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-[#ea2804]/10 dark:bg-[#ea2804]/20 border border-[#ea2804]/30 text-[#ea2804] dark:text-[#ff6a3d] font-mono text-[11px] font-bold';
          const otpLabel = document.createElement('span');
          otpLabel.textContent = '⚡ OTP:';
          const otpValue = document.createElement('span');
          otpValue.textContent = msg.extractedOtp;
          otpBadge.append(otpLabel, otpValue);
          body.appendChild(otpBadge);
        }

        item.append(avatar, body);

        item.addEventListener('click', () => {
          this.selectMessage(msg.id);
        });

        listContainer.appendChild(item);
      });

      if (scroller) scroller.scrollTop = savedScrollTop;
    }

    async selectMessage(messageId: string) {
      if (!this.account) return;
      const selectGen = this.fetchGen;

      const empty = document.getElementById('email-detail-empty');
      const loading = document.getElementById('email-detail-loading');
      const content = document.getElementById('email-detail-content');

      if (empty) empty.classList.add('hidden');
      if (loading) loading.classList.remove('hidden', 'flex-col');
      if (loading) loading.classList.add('flex');
      if (content) content.classList.add('hidden');

      // Mobile pane switch
      const inboxListPane = document.getElementById('inbox-list-pane');
      const emailDetailPane = document.getElementById('email-detail-pane');
      if (window.innerWidth < 768) {
        if (inboxListPane) inboxListPane.classList.add('hidden');
        if (emailDetailPane) {
          emailDetailPane.classList.remove('hidden');
          emailDetailPane.classList.add('block');
        }
        // Smoothly scroll to the mailbox island on mobile
        const prefersReducedMotion = typeof window !== 'undefined' && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const mailboxManager = document.getElementById('mailbox-manager');
        if (mailboxManager) {
          const yOffset = -70; // Header height compensation
          const y = mailboxManager.getBoundingClientRect().top + window.pageYOffset + yOffset;
          window.scrollTo({ top: y, behavior: prefersReducedMotion ? 'auto' : 'smooth' });
        }
      }

      try {
        const loaded = await MailService.getMessageDetail(this.account, messageId);
        if (selectGen !== this.fetchGen) return;
        this.selectedMessage = loaded;
        this.renderMessageDetail();
        // Update messages list to reflect seen state
        this.messages = StorageManager.getCachedMessages(this.account.address);
        this.renderMessageList();
      } catch (err) {
        console.error('Failed to load message detail:', err);
        const i18n = (window as any).__TEMPO_I18N__;
        window.dispatchEvent(
          new CustomEvent('tempomail:toast', {
            detail: { message: i18n?.toasts?.loadMessageFailed || 'Failed to load message content.', type: 'error' },
          })
        );
      } finally {
        if (loading) {
          loading.classList.add('hidden', 'flex-col');
          loading.classList.remove('flex');
        }
      }
    }

    renderMessageDetail() {
      const msg = this.selectedMessage;
      if (!msg) return;

      const i18n = (window as any).__TEMPO_I18N__;
      const content = document.getElementById('email-detail-content');
      const subject = document.getElementById('msg-subject-display');
      const fromName = document.getElementById('msg-from-name');
      const fromAddr = document.getElementById('msg-from-address');
      const toAddr = document.getElementById('msg-to-address');
      const dateFull = document.getElementById('msg-date-full');
      const avatar = document.getElementById('sender-avatar');
      const otpBanner = document.getElementById('otp-highlight-banner');
      const otpCodeText = document.getElementById('detected-otp-code');
      const linkBanner = document.getElementById('verify-link-banner');
      const verifyUrlText = document.getElementById('detected-verify-url');
      const verifyLinkA = document.getElementById('open-verify-link') as HTMLAnchorElement;
      const htmlFrame = document.getElementById('email-html-frame') as HTMLIFrameElement;
      const textContent = document.getElementById('email-text-content');

      if (content) content.classList.remove('hidden');
      if (subject) subject.textContent = msg.subject || i18n?.emailDetail?.noSubject || '(No Subject)';
      if (fromName) fromName.textContent = msg.from.name || i18n?.emailDetail?.defaultSender || 'Unknown Sender';
      if (fromAddr) fromAddr.textContent = msg.from.address;
      if (toAddr) toAddr.textContent = msg.to.map((t) => t.address).join(', ') || this.account?.address || '';
      if (dateFull) dateFull.textContent = formatFullDateTime(msg.createdAt);
      if (avatar) avatar.textContent = (msg.from.name || 'S').charAt(0).toUpperCase();

      // Handle OTP detection
      if (msg.extractedOtp && otpBanner && otpCodeText) {
        otpCodeText.textContent = msg.extractedOtp;
        otpBanner.classList.remove('hidden');
      } else if (otpBanner) {
        otpBanner.classList.add('hidden');
      }

      // Handle Verification Link detection
      if (msg.verificationLink && linkBanner && verifyUrlText && verifyLinkA) {
        verifyUrlText.textContent = msg.verificationLink;
        verifyLinkA.href = msg.verificationLink;
        linkBanner.classList.remove('hidden');
      } else if (linkBanner) {
        linkBanner.classList.add('hidden');
      }

      // Render HTML in sandboxed iframe — sanitize first (strip scripts,
      // forms, tracking pixels) and escape plain-text bodies.
      if (htmlFrame) {
        const rawHtml =
          msg.html && msg.html.length > 0
            ? sanitizeEmailHtml(msg.html.join(''))
            : `<pre style="font-family: monospace; white-space: pre-wrap; padding: 20px;">${escapeHtml(msg.text)}</pre>`;
        const isDark = document.documentElement.classList.contains('dark');
        const styledDoc = `
          <!DOCTYPE html>
          <html>
            <head>
              <meta charset="utf-8">
              <meta name="viewport" content="width=device-width, initial-scale=1">
              <style>
                body {
                  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                  color: ${isDark ? '#f4f4f5' : '#202020'};
                  background: ${isDark ? '#18181b' : '#ffffff'};
                  line-height: 1.6;
                  padding: 16px;
                  margin: 0;
                  word-break: break-word;
                }
                a { color: #ea2804; }
                img { max-width: 100%; height: auto; }
              </style>
            </head>
            <body>
              ${rawHtml}
            </body>
          </html>
        `;
        htmlFrame.srcdoc = styledDoc;
      }

      // Plain text content
      if (textContent) {
        textContent.textContent = msg.text || (msg.html ? msg.html.join('\n').replace(/<[^>]*>?/gm, '') : '');
      }

      // Reset to HTML view tab by default
      this.switchViewTab('html');
    }

    switchViewTab(tab: 'html' | 'text') {
      const htmlBtn = document.getElementById('tab-html-btn');
      const textBtn = document.getElementById('tab-text-btn');
      const htmlWrapper = document.getElementById('html-view-wrapper');
      const textWrapper = document.getElementById('text-view-wrapper');

      if (tab === 'html') {
        htmlBtn?.classList.add('bg-white', 'dark:bg-zinc-800', 'text-[#202020]', 'dark:text-white', 'shadow-xs');
        htmlBtn?.classList.remove('text-[#575757]', 'dark:text-zinc-400');
        textBtn?.classList.remove('bg-white', 'dark:bg-zinc-800', 'text-[#202020]', 'dark:text-white', 'shadow-xs');
        textBtn?.classList.add('text-[#575757]', 'dark:text-zinc-400');
        htmlWrapper?.classList.remove('hidden');
        textWrapper?.classList.add('hidden');
      } else {
        textBtn?.classList.add('bg-white', 'dark:bg-zinc-800', 'text-[#202020]', 'dark:text-white', 'shadow-xs');
        textBtn?.classList.remove('text-[#575757]', 'dark:text-zinc-400');
        htmlBtn?.classList.remove('bg-white', 'dark:bg-zinc-800', 'text-[#202020]', 'dark:text-white', 'shadow-xs');
        htmlBtn?.classList.add('text-[#575757]', 'dark:text-zinc-400');
        textWrapper?.classList.remove('hidden');
        htmlWrapper?.classList.add('hidden');
      }
    }

    async deleteCurrentSelectedMessage() {
      if (!this.account || !this.selectedMessage) return;
      const msgId = this.selectedMessage.id;
      await MailService.deleteMessage(this.account, msgId);
      this.selectedMessage = null;
      
      const empty = document.getElementById('email-detail-empty');
      const content = document.getElementById('email-detail-content');
      if (empty) empty.classList.remove('hidden');
      if (content) content.classList.add('hidden');

      // On mobile return to list
      if (window.innerWidth < 768) {
        const inboxListPane = document.getElementById('inbox-list-pane');
        const emailDetailPane = document.getElementById('email-detail-pane');
        if (inboxListPane) inboxListPane.classList.remove('hidden');
        if (emailDetailPane) emailDetailPane.classList.add('hidden');
      }

      await this.fetchMessages();
      const i18n = (window as any).__TEMPO_I18N__;
      window.dispatchEvent(
        new CustomEvent('tempomail:toast', {
          detail: { message: i18n?.toasts?.messageDeleted || 'Message deleted', type: 'success' },
        })
      );
    }

    downloadCurrentEmail() {
      if (!this.selectedMessage) return;
      const msg = this.selectedMessage;
      const rawContent = `From: ${msg.from.name} <${msg.from.address}>\nTo: ${msg.to.map((t) => t.address).join(', ')}\nDate: ${msg.createdAt}\nSubject: ${msg.subject}\n\n${msg.text || msg.html.join('\n')}`;
      const blob = new Blob([rawContent], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${msg.subject.replace(/[^a-z0-9]/gi, '_').toLowerCase() || 'email'}.txt`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    }

    private lastModalFocus: HTMLElement | null = null;

    private setModalOpen(modalId: string, contentId: string, open: boolean, focusSelector?: string) {
      const modal = document.getElementById(modalId);
      const content = document.getElementById(contentId);
      if (!modal || !content) return;
      if (open) {
        if (this.lastModalFocus === null) {
          this.lastModalFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        }
        modal.classList.remove('opacity-0', 'pointer-events-none');
        content.classList.remove('scale-95');
        content.classList.add('scale-100');
        try {
          document.body.style.overflow = 'hidden';
        } catch {}
        const target = (focusSelector ? document.querySelector(focusSelector) : null) as HTMLElement | null;
        const fallback = content.querySelector('button, input, select, a[href]') as HTMLElement | null;
        setTimeout(() => (target || fallback)?.focus(), 50);
      } else {
        modal.classList.add('opacity-0', 'pointer-events-none');
        content.classList.remove('scale-100');
        content.classList.add('scale-95');
        const anyOpen = ['qr-modal', 'custom-modal', 'history-modal'].some((id) => {
          const m = document.getElementById(id);
          return m && !m.classList.contains('pointer-events-none');
        });
        if (!anyOpen) {
          try {
            document.body.style.overflow = '';
          } catch {}
          this.lastModalFocus?.focus?.();
          this.lastModalFocus = null;
        }
      }
    }

    openQrModal() {
      if (!this.account) return;
      const addressText = document.getElementById('qr-modal-address');
      const qrPlaceholder = document.getElementById('qr-code-placeholder');

      if (addressText) addressText.textContent = this.account.address;
      if (qrPlaceholder) {
        qrPlaceholder.innerHTML = generateQrCodeSvg(this.account.address, 200);
        const img = qrPlaceholder.querySelector('img');
        img?.addEventListener(
          'error',
          () => {
            qrPlaceholder.textContent = 'QR code unavailable — check your connection and try again.';
          },
          { once: true }
        );
      }

      this.setModalOpen('qr-modal', 'qr-modal-content', true, '#qr-copy-btn');
    }

    closeQrModal() {
      this.setModalOpen('qr-modal', 'qr-modal-content', false);
    }

    openCustomModal() {
      this.setModalOpen('custom-modal', 'custom-modal-content', true, '#custom-prefix-input');
    }

    closeCustomModal() {
      this.setModalOpen('custom-modal', 'custom-modal-content', false);
    }

    updateCustomPreview() {
      const input = document.getElementById('custom-prefix-input') as HTMLInputElement;
      const select = document.getElementById('custom-domain-select') as HTMLSelectElement;
      const preview = document.getElementById('custom-preview-address');
      if (!preview) return;

      const prefix = input?.value?.trim() || 'yourname';
      const domain = select?.value || this.availableDomains[0]?.domain || SITE_CONFIG.domain;
      preview.textContent = `${prefix}@${domain}`;
    }

    openHistoryModal() {
      const i18n = (window as any).__TEMPO_I18N__;
      const saved = StorageManager.getSavedAccounts();
      const clearBtn = document.getElementById('clear-all-history-btn') as HTMLButtonElement | null;
      if (clearBtn) clearBtn.disabled = saved.length === 0;
      const list = document.getElementById('history-inboxes-list');

      if (!list) return;

      if (saved.length === 0) {
        const emptyMsg = document.createElement('div');
        emptyMsg.className = 'text-center py-6 text-xs text-[#8d8d8d]';
        emptyMsg.textContent = i18n?.historyDrawer?.emptyTitle || 'No previous inboxes found in this session.';
        list.innerHTML = '';
        list.appendChild(emptyMsg);
      } else {
        list.innerHTML = '';
        saved.forEach((acc) => {
          const isCurrent = this.account && this.account.address.toLowerCase() === acc.address.toLowerCase();

          // SECURITY: DOM APIs + textContent only (addresses are user-influenced data).
          const item = document.createElement('div');
          item.className = `flex items-center justify-between p-3 rounded-xl border text-xs transition-all ${
            isCurrent
              ? 'bg-[#ea2804]/10 dark:bg-[#ea2804]/20 border-[#ea2804]/40 font-bold'
              : 'bg-black/5 dark:bg-white/5 border-transparent hover:border-black/10 dark:hover:border-white/10'
          }`;

          const switchBtn = document.createElement('div');
          switchBtn.className = 'flex items-center gap-2 truncate cursor-pointer flex-1';
          const statusDot = document.createElement('span');
          statusDot.className = `w-2 h-2 rounded-full ${isCurrent ? 'bg-[#ea2804]' : 'bg-[#8d8d8d]'}`;
          const addressSpan = document.createElement('span');
          addressSpan.className = 'font-mono text-[#202020] dark:text-zinc-200 truncate';
          addressSpan.textContent = acc.address;
          switchBtn.append(statusDot, addressSpan);

          const actions = document.createElement('div');
          actions.className = 'flex items-center gap-1.5 shrink-0';

          if (isCurrent) {
            const activeLabel = document.createElement('span');
            activeLabel.className = 'text-[10px] text-[#ea2804] uppercase font-bold tracking-wider';
            activeLabel.textContent = i18n?.historyDrawer?.activeInbox || 'Active';
            actions.appendChild(activeLabel);
          }

          const deleteBtn = document.createElement('button');
          deleteBtn.type = 'button';
          deleteBtn.className = 'text-rose-500 hover:text-rose-700 p-1 transition-colors cursor-pointer';
          deleteBtn.title = i18n?.historyDrawer?.clearAll || 'Delete from history';
          deleteBtn.setAttribute('aria-label', i18n?.historyDrawer?.clearAll || 'Delete from history');
          deleteBtn.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';

          actions.appendChild(deleteBtn);
          item.append(switchBtn, actions);

          // Bind switch click
          switchBtn.addEventListener('click', () => {
            this.switchInbox(acc);
            this.closeHistoryModal();
          });

          // Bind delete click
          deleteBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            StorageManager.removeSavedAccount(acc.address);
            this.openHistoryModal(); // Refresh modal
          });

          list.appendChild(item);
        });
      }

      this.setModalOpen('history-modal', 'history-modal-content', true, '#history-modal-done');
    }

    closeHistoryModal() {
      this.setModalOpen('history-modal', 'history-modal-content', false);
    }

    switchInbox(targetAccount: MailAccount) {
      this.fetchGen++;
      this.account = targetAccount;
      StorageManager.setCurrentAccount(targetAccount);
      this.selectedMessage = null;
      this.updateAddressDisplay();

      // Immediately render locally stored messages for this switched inbox
      this.messages = StorageManager.getCachedMessages(targetAccount.address);
      this.renderMessageList();

      this.connectRealtimeStream();
      this.fetchMessages();
      const i18n = (window as any).__TEMPO_I18N__;
      const switchedMsg = (i18n?.toasts?.switchedTo || 'Switched to {address}').replace('{address}', targetAccount.address);
      window.dispatchEvent(
        new CustomEvent('tempomail:toast', {
          detail: { message: switchedMsg, type: 'success' },
        })
      );
    }

    bindEvents() {
      // 1. Copy button
      const copyBtn = document.getElementById('copy-email-btn');
      const copyIcon = document.getElementById('copy-icon');
      const checkIcon = document.getElementById('check-icon');
      const copyText = document.getElementById('copy-btn-text');

      const performCopy = async () => {
        if (!this.account) return;
        const i18n = (window as any).__TEMPO_I18N__;
        const copyToastMsg = (i18n?.common?.copyEmailToast || i18n?.toasts?.copiedToClipboard || 'Copied {email} to clipboard!').replace('{email}', this.account.address);
        const ok = await copyToClipboard(this.account.address, copyToastMsg);
        if (ok && copyIcon && checkIcon && copyText) {
          copyIcon.classList.add('hidden');
          checkIcon.classList.remove('hidden');
          copyText.textContent = i18n?.common?.copied || 'Copied!';
          setTimeout(() => {
            copyIcon.classList.remove('hidden');
            checkIcon.classList.add('hidden');
            copyText.textContent = i18n?.addressBar?.copyAddress || 'Copy Address';
          }, 2000);
        }
      };

      copyBtn?.addEventListener('click', performCopy);
      document.getElementById('current-email-display')?.addEventListener('click', performCopy);

      // 2. Refresh button
      document.getElementById('refresh-inbox-btn')?.addEventListener('click', () => {
        this.fetchMessages();
      });

      // 3. Change / Randomize button
      document.getElementById('change-email-btn')?.addEventListener('click', async () => {
        const i18n = (window as any).__TEMPO_I18N__;
        const currentDomain = this.account?.address.split('@')[1];
        const ok = await (window as any).showConfirmDialog({
          title: i18n?.confirmModal?.changeAddressTitle || 'Generate New Email?',
          description: i18n?.confirmModal?.changeAddressDesc || 'This will create a fresh temporary mailbox with a new domain. Your current mailbox remains saved in history.',
          confirmText: i18n?.confirmModal?.confirm || 'Generate New',
          cancelText: i18n?.confirmModal?.cancel || 'Keep Current',
          variant: 'primary',
          iconType: 'random',
        });
        if (ok) {
          await this.loadInitialMailbox(true, undefined, currentDomain);
          window.dispatchEvent(
            new CustomEvent('tempomail:toast', {
              detail: { message: i18n?.toasts?.generatedNew || 'Generated fresh temporary inbox with new domain!', type: 'success' },
            })
          );
        }
      });

      // 4. Delete current mailbox
      document.getElementById('delete-inbox-btn')?.addEventListener('click', async () => {
        const i18n = (window as any).__TEMPO_I18N__;
        const ok = await (window as any).showConfirmDialog({
          title: i18n?.confirmModal?.deleteInboxTitle || 'Delete This Mailbox?',
          description: i18n?.confirmModal?.deleteInboxDesc || 'Are you sure you want to delete this temporary inbox and generate a fresh one?',
          confirmText: i18n?.confirmModal?.confirm || 'Delete Mailbox',
          cancelText: i18n?.confirmModal?.cancel || 'Cancel',
          variant: 'danger',
          iconType: 'trash',
        });
        if (ok) {
          if (this.account) {
            const currentDomain = this.account.address.split('@')[1];
            this.account = await MailService.deleteCurrentAccount(this.account);
            this.updateAddressDisplay();
            this.connectRealtimeStream();
            this.selectedMessage = null;
            await this.fetchMessages();
            window.dispatchEvent(
              new CustomEvent('tempomail:toast', {
                detail: { message: i18n?.toasts?.mailboxDeleted || 'Mailbox deleted and fresh address generated!', type: 'success' },
              })
            );
          }
        }
      });

      // 5. QR Code modal triggers
      document.getElementById('qr-code-btn')?.addEventListener('click', () => this.openQrModal());
      document.getElementById('qr-modal-close')?.addEventListener('click', () => this.closeQrModal());
      document.getElementById('qr-modal')?.addEventListener('click', (e) => {
        if (e.target === document.getElementById('qr-modal')) this.closeQrModal();
      });
      document.getElementById('qr-copy-btn')?.addEventListener('click', () => {
        if (this.account) {
          const i18n = (window as any).__TEMPO_I18N__;
          const copyToastMsg = (i18n?.common?.copyEmailToast || i18n?.toasts?.copiedToClipboard || 'Copied {email} to clipboard!').replace('{email}', this.account.address);
          copyToClipboard(this.account.address, copyToastMsg);
        }
      });

      // 7. Custom email modal triggers
      document.getElementById('custom-email-btn')?.addEventListener('click', () => this.openCustomModal());
      document.getElementById('custom-modal-close')?.addEventListener('click', () => this.closeCustomModal());
      document.getElementById('custom-modal-cancel')?.addEventListener('click', () => this.closeCustomModal());
      document.getElementById('custom-modal')?.addEventListener('click', (e) => {
        if (e.target === document.getElementById('custom-modal')) this.closeCustomModal();
      });

      const customPrefix = document.getElementById('custom-prefix-input');
      const customDomain = document.getElementById('custom-domain-select');
      customPrefix?.addEventListener('input', () => this.updateCustomPreview());
      customDomain?.addEventListener('change', () => this.updateCustomPreview());

      document.getElementById('custom-inbox-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const prefixInput = document.getElementById('custom-prefix-input') as HTMLInputElement;
        const select = document.getElementById('custom-domain-select') as HTMLSelectElement;
        const prefix = prefixInput?.value?.trim();
        const domain = select?.value;
        const selectedOpt = select?.options[select.selectedIndex];
        const providerHint = selectedOpt?.dataset?.provider as ('mailtm' | 'inboxes' | 'guerrilla' | undefined);

        if (!prefix || !domain) return;

        this.showAddressLoading(true);
        this.closeCustomModal();
        try {
          this.account = await MailService.createCustomAccount(prefix, domain, providerHint);
          this.updateAddressDisplay();
          this.connectRealtimeStream();
          this.selectedMessage = null;
          await this.fetchMessages();
          const i18n = (window as any).__TEMPO_I18N__;
          const customCreatedTpl = i18n?.toasts?.customCreated || 'Created custom inbox: {address}';
          window.dispatchEvent(
            new CustomEvent('tempomail:toast', {
              detail: { message: customCreatedTpl.replace('{address}', `${this.account.address} (${this.account.provider.toUpperCase()})`), type: 'success' },
            })
          );
        } catch (err: any) {
          console.error('Custom inbox creation failed:', err);
          const i18n = (window as any).__TEMPO_I18N__;
          window.dispatchEvent(
            new CustomEvent('tempomail:toast', {
              detail: { message: err?.message || i18n?.toasts?.customFailed || 'Failed to create inbox. Please try a different username.', type: 'error' },
            })
          );
        } finally {
          this.showAddressLoading(false);
        }
      });

      // Quick Provider Toggle on Badge Click
      document.getElementById('provider-badge')?.addEventListener('click', async () => {
        const provs: ('mailtm' | 'inboxes' | 'tempmaillol' | 'guerrilla')[] = [
          'mailtm',
          'inboxes',
          'tempmaillol',
          'guerrilla',
        ];
        const curIdx = provs.indexOf(this.account?.provider as any);
        const nextProvider = provs[(curIdx + 1) % provs.length] || 'mailtm';
        const i18n = (window as any).__TEMPO_I18N__;
        await this.loadInitialMailbox(true, nextProvider);
        const actual = (this.account?.provider || nextProvider).toUpperCase();
        const provSwitchedTpl = i18n?.toasts?.providerSwitched || 'Switched active provider to {provider}';
        window.dispatchEvent(
          new CustomEvent('tempomail:toast', {
            detail: { message: provSwitchedTpl.replace('{provider}', actual), type: 'success' },
          })
        );
      });

      // 8. History modal triggers (from Header or button)
      window.addEventListener('tempomail:openhistory', () => this.openHistoryModal());
      document.getElementById('history-modal-close')?.addEventListener('click', () => this.closeHistoryModal());
      document.getElementById('history-modal-done')?.addEventListener('click', () => this.closeHistoryModal());
      document.getElementById('history-modal')?.addEventListener('click', (e) => {
        if (e.target === document.getElementById('history-modal')) this.closeHistoryModal();
      });
      document.getElementById('clear-all-history-btn')?.addEventListener('click', async () => {
        const i18n = (window as any).__TEMPO_I18N__;
        const ok = await (window as any).showConfirmDialog({
          title: i18n?.historyDrawer?.confirmClearTitle || 'Clear All Inboxes?',
          description: i18n?.historyDrawer?.confirmClearDesc || 'Are you sure you want to permanently remove all saved temporary inboxes from browser memory?',
          confirmText: i18n?.confirmModal?.confirm || 'Clear Everything',
          cancelText: i18n?.confirmModal?.cancel || 'Cancel',
          variant: 'danger',
          iconType: 'trash',
        });
        if (ok) {
          StorageManager.clearAllSavedAccounts();
          await this.loadInitialMailbox(true);
          this.closeHistoryModal();
          window.dispatchEvent(
            new CustomEvent('tempomail:toast', {
              detail: { message: i18n?.toasts?.historyCleared || 'All saved inboxes cleared from memory.', type: 'success' },
            })
          );
        }
      });

      // 9. Message detail view controls
      document.getElementById('tab-html-btn')?.addEventListener('click', () => this.switchViewTab('html'));
      document.getElementById('tab-text-btn')?.addEventListener('click', () => this.switchViewTab('text'));
      document.getElementById('delete-msg-btn')?.addEventListener('click', () => this.deleteCurrentSelectedMessage());
      document.getElementById('download-email-btn')?.addEventListener('click', () => this.downloadCurrentEmail());

      // 10. Copy OTP code button
      document.getElementById('copy-otp-btn')?.addEventListener('click', () => {
        if (this.selectedMessage?.extractedOtp) {
          const i18n = (window as any).__TEMPO_I18N__;
          const otpTpl = i18n?.toasts?.otpCopied || 'Verification code {code} copied!';
          copyToClipboard(this.selectedMessage.extractedOtp, otpTpl.replace('{code}', this.selectedMessage.extractedOtp));
        }
      });

      // 11. Mobile back button
      document.getElementById('email-detail-back-btn')?.addEventListener('click', () => {
        const inboxListPane = document.getElementById('inbox-list-pane');
        const emailDetailPane = document.getElementById('email-detail-pane');
        if (inboxListPane) inboxListPane.classList.remove('hidden');
        if (emailDetailPane) {
          emailDetailPane.classList.add('hidden');
          emailDetailPane.classList.remove('block');
        }
      });

      // Global Escape closes any open app modal (QR / custom / history).
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const openId = ['qr-modal', 'custom-modal', 'history-modal'].find((id) => {
          const m = document.getElementById(id);
          return m && !m.classList.contains('pointer-events-none');
        });
        if (openId === 'qr-modal') this.closeQrModal();
        else if (openId === 'custom-modal') this.closeCustomModal();
        else if (openId === 'history-modal') this.closeHistoryModal();
      });

      // Re-theme the email reader when the app theme changes.
      window.addEventListener('tempomail:themechange', () => {
        if (this.selectedMessage) this.renderMessageDetail();
      });
    }
  }

  // Initialize controller
  const controller = new MailboxController();
  controller.init();
</script>
