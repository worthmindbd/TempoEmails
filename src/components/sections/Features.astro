---
import SectionHeading from '../ui/SectionHeading.astro';
import { useTranslation } from '../../i18n/utils';
import type { Locale } from '../../i18n/languages';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslation(locale);
const items = t.features.items || [];

// Bento placement per feature index (4-column grid on large screens).
const spans = ['md:col-span-2', '', '', '', '', 'md:col-span-2'];
const sampleAddresses = ['nova.k7x2@mail.tm', 'quiet-fern@getnada.com', 'v9q4r@guerrillamail.info'];
---

<section id="features" class="px-5 sm:px-8 py-16 sm:py-24">
  <div class="max-w-6xl mx-auto">
    <SectionHeading eyebrow={t.features.badge} title={t.features.title} subtitle={t.features.subtitle} />

    <div class="mt-12 sm:mt-16 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {items.map((item, i) => (
        <article
          class:list={['surface card-hover rounded-3xl p-5 sm:p-7 flex flex-col overflow-hidden', spans[i]]}
          data-reveal
          style={`--reveal-delay: ${i % 3}`}
        >
          <div class="h-24 sm:h-32 mb-5 sm:mb-6 relative" aria-hidden="true">
            {i === 0 && (
              <div class="absolute inset-0 flex flex-col justify-center gap-2">
                {sampleAddresses.map((addr, j) => (
                  <span
                    class:list={[
                      'self-start inline-flex items-center gap-2 h-9 px-3.5 rounded-xl font-mono text-[13px] border',
                      j === 1 ? 'ms-8 bg-accent/8 border-accent/25 text-accent-text' : 'surface-inset text-muted',
                      j === 2 && 'ms-3 opacity-60',
                    ]}
                  >
                    <span class:list={['w-1.5 h-1.5 rounded-full', j === 1 ? 'bg-accent' : 'bg-ink/25']}></span>
                    {addr}
                  </span>
                ))}
              </div>
            )}
            {i === 1 && (
              <div class="absolute inset-0 grid place-items-center">
                <div class="flex gap-1.5">
                  {'482913'.split('').map((d) => (
                    <span class="w-8 h-11 grid place-items-center rounded-lg surface-inset font-mono text-xl font-semibold text-ink">{d}</span>
                  ))}
                </div>
              </div>
            )}
            {i === 2 && (
              <div class="absolute inset-0 grid place-items-center">
                <div class="relative grid place-items-center w-20 h-20 sm:w-24 sm:h-24 rounded-full border border-dashed border-line-strong">
                  <div class="icon-tile w-14! h-14! rounded-2xl!">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 10a2 2 0 0 0-2 2c0 1.02-.1 2.51-.26 4"></path>
                      <path d="M14 13.12c0 2.38 0 6.38-1 8.88"></path>
                      <path d="M17.29 21.02c.12-.6.43-2.3.5-3.02"></path>
                      <path d="M2 12a10 10 0 0 1 18-6"></path>
                      <path d="M2 16h.01"></path>
                      <path d="M21.8 16c.2-2 .131-5.354 0-6"></path>
                      <path d="M5 19.5C5.5 18 6 15 6 12a6 6 0 0 1 .34-2"></path>
                      <path d="M8.65 22c.21-.66.45-1.32.57-2"></path>
                      <path d="M9 6.8a6 6 0 0 1 9 5.2v2"></path>
                    </svg>
                  </div>
                  <span class="absolute -top-1 end-1 w-3 h-3 rounded-full bg-success ring-4 ring-surface"></span>
                </div>
              </div>
            )}
            {i === 3 && (
              <div class="absolute inset-0 grid place-items-center">
                <svg class="w-24 h-24 sm:w-28 sm:h-28 text-ink" viewBox="0 0 29 29" shape-rendering="crispEdges">
                  <rect width="29" height="29" rx="3" class="fill-surface-2" />
                  <path fill="currentColor" fill-rule="evenodd" d="M3 3h7v7H3zm1 1v5h5V4zm1 1h3v3H5zm14-2h7v7h-7zm1 1v5h5V4zm1 1h3v3h-3zM3 19h7v7H3zm1 1v5h5v-5zm1 1h3v3H5zM12 3h1v2h-1zm2 1h2v1h-2zm-2 3h2v2h-2zm3 0h1v3h-1zM3 12h2v1H3zm3 0h3v2H6zm5 0h2v1h-2zm3 0h1v2h-1zm2-1h2v1h-2zm3 1h2v1h-2zm4 0h2v2h-2zM12 15h3v1h-3zm4 0h1v3h-1zm2 1h3v1h-3zm4 0h1v1h-1zM12 18h2v2h-2zm7 0h2v1h-2zm4 1h3v1h-3zM12 22h1v4h-1zm2-1h2v1h-2zm3 2h3v1h-3zm4 0h1v3h-1zm2 1h3v2h-3zm-9 1h2v1h-2z" />
                  <rect x="12.5" y="12.5" width="4" height="4" rx="1" class="fill-accent" />
                </svg>
              </div>
            )}
            {i === 4 && (
              <div class="absolute inset-0 grid place-items-center">
                <div class="relative w-20 h-20 sm:w-24 sm:h-24">
                  <svg class="w-full h-full -rotate-90" viewBox="0 0 36 36">
                    <circle cx="18" cy="18" r="15.5" fill="none" stroke-width="2.5" class="stroke-ink/8" />
                    <circle cx="18" cy="18" r="15.5" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="97.4" stroke-dashoffset="34" class="stroke-accent" />
                  </svg>
                  <span class="absolute inset-0 grid place-items-center font-mono text-xl font-semibold text-ink">10s</span>
                </div>
              </div>
            )}
            {i === 5 && (
              <div class="absolute inset-0 flex flex-col justify-center gap-1.5 max-w-sm">
                {['inbox · 3', 'inbox · 1', 'inbox · 0'].map((label, j) => (
                  <div
                    class:list={[
                      'flex items-center justify-between gap-3 h-9 px-3 rounded-xl border text-[13px]',
                      j === 0 ? 'bg-accent/8 border-accent/25' : 'surface-inset',
                    ]}
                  >
                    <span class="flex items-center gap-2 font-mono text-ink-2 truncate">
                      <span class:list={['w-2 h-2 rounded-full', j === 0 ? 'bg-accent' : 'bg-ink/20']}></span>
                      {sampleAddresses[j]}
                    </span>
                    <span class="font-mono text-xs text-subtle shrink-0">{label}</span>
                  </div>
                ))}
              </div>
            )}
          </div>

          <h3 class="font-display text-xl font-semibold tracking-tight text-ink">{item.title}</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed max-w-md">{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
