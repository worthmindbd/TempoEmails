---
import GlassCard from '../ui/GlassCard.astro';
import Badge from '../ui/Badge.astro';

const steps = [
  {
    step: '01',
    title: 'Generate Temp Mail Address',
    description: 'Use the instant random email generator or click "Custom" to choose your own burner username and domain alias.',
  },
  {
    step: '02',
    title: 'Paste into Signups & Trials',
    description: 'Use your disposable email on Discord, ChatGPT, Telegram, Steam, free trials, and gated whitepapers.',
  },
  {
    step: '03',
    title: 'Receive OTP Codes & Links',
    description: 'Incoming emails land within seconds. The automated parser detects and highlights your verification OTP for 1-click copy.',
  },
  {
    step: '04',
    title: 'Walk Away 100% Spam-Free',
    description: 'Once verified, delete the temporary mailbox or let it expire. Your personal inbox remains protected from spam forever.',
  },
];
---

<section id="how-it-works" class="w-full max-w-6xl mx-auto my-16 px-4">
  <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
    <Badge variant="neutral" size="md">
      How It Works
    </Badge>
    <h2 class="font-display text-3xl md:text-4xl font-black text-[#202020] dark:text-[#fcfcfc] tracking-tight">
      How temporary email works in 4 easy steps.
    </h2>
    <p class="text-sm md:text-base text-[#575757] dark:text-zinc-400">
      Generate a working disposable inbox instantly — no registration, no passwords, and 100% free.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6">
    {steps.map((s) => (
      <GlassCard variant="card" class="p-5 sm:p-6 relative group overflow-hidden border border-black/5 dark:border-white/10">
        <div class="font-mono text-3xl sm:text-4xl font-black text-[#ea2804]/20 dark:text-[#ea2804]/30 mb-3 sm:mb-4 transition-colors group-hover:text-[#ea2804]/40">
          {s.step}
        </div>
        <h3 class="font-display text-base font-bold text-[#202020] dark:text-[#fcfcfc] mb-2">
          {s.title}
        </h3>
        <p class="text-xs md:text-sm text-[#575757] dark:text-zinc-400 leading-relaxed">
          {s.description}
        </p>
      </GlassCard>
    ))}
  </div>
</section>
