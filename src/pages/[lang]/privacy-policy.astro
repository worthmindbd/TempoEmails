---
import PrivacyPolicyPage from '../privacy-policy.astro';
import { NON_DEFAULT_LOCALES, type Locale } from '../../i18n/languages';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
---

<PrivacyPolicyPage locale={lang as Locale} />
