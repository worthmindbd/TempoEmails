---
import Layout from './Layout.astro';
import { SITE_CONFIG } from '../lib/config';
import { useTranslation, getLocaleFromUrl, getLocalizedPath } from '../i18n/utils';
import { getBlogArticleBySlug, getBlogArticles } from '../i18n/blog-data';
import type { Locale } from '../i18n/languages';

export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  publishDate?: string;
  updatedDate?: string;
  category?: string;
  keywords?: string;
  locale?: Locale;
  faqItems?: FaqItem[];
}

const { title, description, publishDate, updatedDate, category, keywords, locale, faqItems } = Astro.props;
const currentLocale = locale || getLocaleFromUrl(Astro.url);
const t = useTranslation(currentLocale);

// If this is a blog post, fetch localized title & description if available
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const currentSlug = pathSegments[pathSegments.length - 1] || '';
const localizedArticle = category ? getBlogArticleBySlug(currentSlug, currentLocale) : undefined;
const displayTitle = localizedArticle?.title || title;
const displayDescription = localizedArticle?.description || description;

// Clean displayTitle for headings and breadcrumbs (strip redundant brand suffix if present)
const cleanTitle = displayTitle.replace(/\s*[—–-]\s*TempoEmails.*$/i, '').trim();

// Full title for the <title> tag: ensure brand is included once
const metaTitle = displayTitle.includes('TempoEmails')
  ? displayTitle
  : `${displayTitle} — TempoEmails`;

function getCategoryLabel(cat?: string) {
  if (!cat) return '';
  if (cat === 'Privacy') return t.common.privacy;
  if (cat === 'Security') return t.common.security;
  if (cat === 'Guides') return t.common.guide;
  if (cat === 'Technology') return t.common.architecture;
  return cat;
}
const displayCategory = getCategoryLabel(category);

const siteUrl = Astro.site?.origin || SITE_CONFIG.siteUrl;
// Canonical must always carry a trailing slash so the <link rel="canonical">,
// JSON-LD `mainEntityOfPage`, breadcrumbs and the sitemap agree on one URL.
// (Layout.astro already normalizes; this keeps structured data consistent.)
const canonicalPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalURL = new URL(canonicalPath, siteUrl);
const homeUrl = currentLocale === 'en' ? '/' : `/${currentLocale}/`;
const blogUrl = getLocalizedPath('/blog/', currentLocale);

// Freshness signals: dateModified must be >= datePublished and reflect the
// last editorial review. Falls back to publishDate when no review happened.
const datePublishedISO = publishDate ? new Date(publishDate).toISOString() : undefined;
const effectiveUpdated = updatedDate || publishDate;
const dateModifiedISO = effectiveUpdated ? new Date(effectiveUpdated).toISOString() : undefined;
const hasFreshUpdate = Boolean(publishDate && updatedDate && updatedDate !== publishDate);

function formatDate(dateStr: string, loc: string) {
  return new Date(dateStr).toLocaleDateString(loc, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

const formattedDate = publishDate
  ? formatDate(publishDate, currentLocale)
  : null;
const formattedUpdated = hasFreshUpdate && effectiveUpdated
  ? formatDate(effectiveUpdated, currentLocale)
  : null;

// JSON-LD Schema: BreadcrumbList
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t.common.home,
      item: `${canonicalURL.origin}${homeUrl}`,
    },
    ...(category
      ? [
          {
            '@type': 'ListItem',
            position: 2,
            name: t.common.blog,
            item: `${canonicalURL.origin}${blogUrl}`,
          },
          {
            '@type': 'ListItem',
            position: 3,
            name: cleanTitle,
            item: canonicalURL.href,
          },
        ]
      : [
          {
            '@type': 'ListItem',
            position: 2,
            name: cleanTitle,
            item: canonicalURL.href,
          },
        ]),
  ],
};

// JSON-LD Schema: BlogPosting (richer than generic Article — carries the
// E-E-A-T signals Google needs for YMYL-adjacent security/privacy guides:
// explicit author + publisher, distinct datePublished/dateModified, section,
// and stable mainEntityOfPage matching the canonical URL).
const articleSchema = publishDate
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: cleanTitle,
      description: displayDescription,
      inLanguage: currentLocale,
      datePublished: datePublishedISO,
      dateModified: dateModifiedISO,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalURL.href,
      },
      author: {
        '@type': 'Organization',
        name: 'TempoEmails Editorial Team',
        url: `${canonicalURL.origin}/about/`,
      },
      editor: {
        '@type': 'Organization',
        name: 'TempoEmails Editorial Team',
        url: `${canonicalURL.origin}/about/`,
      },
      publisher: {
        '@type': 'Organization',
        name: 'TempoEmails',
        url: `${canonicalURL.origin}/`,
        logo: {
          '@type': 'ImageObject',
          url: `${canonicalURL.origin}/android-chrome-512x512.png`,
        },
      },
      image: `${canonicalURL.origin}/og-image.png`,
      articleSection: displayCategory || 'Privacy',
    }
  : null;

// JSON-LD Schema: FAQPage (only when the page supplies faqItems)
const faqSchema = faqItems && faqItems.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      inLanguage: currentLocale,
      mainEntity: faqItems.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.answer,
        },
      })),
    }
  : null;

// Related guides: same-category first, then newest others, excluding self.
// This internal-link mesh is deliberate: every article now links out to three
// siblings (and receives inbound links from them), lifting crawl depth and
// PageRank flow for pages Google previously crawled but declined to index.
const allArticles = category ? getBlogArticles(currentLocale) : [];
const normalizedSlug = currentSlug.toLowerCase();
const sameCategory = allArticles.filter(
  (a) => a.slug.toLowerCase().replace(/\/+$/g, '').split('/').pop() !== normalizedSlug &&
    a.category === category
);
const otherCategory = allArticles.filter(
  (a) => a.slug.toLowerCase().replace(/\/+$/g, '').split('/').pop() !== normalizedSlug &&
    a.category !== category
);
const relatedArticles = [...sameCategory, ...otherCategory].slice(0, 3);
---

<Layout
  title={metaTitle}
  description={displayDescription}
  keywords={keywords}
  ogType={publishDate ? 'article' : 'website'}
  publishDate={datePublishedISO}
  modifiedDate={dateModifiedISO}
  category={displayCategory}
  locale={currentLocale}
  isApp={false}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    <!-- Breadcrumb Navigation -->
    <nav class="mb-8 flex flex-wrap items-center gap-2 text-xs font-mono text-[#8d8d8d] dark:text-zinc-500">
      <a href={homeUrl} class="hover:text-[#ea2804] transition-colors shrink-0">{t.common.home}</a>
      <span>→</span>
      {category && (
        <>
          <a href={blogUrl} class="hover:text-[#ea2804] transition-colors shrink-0">{t.common.blog}</a>
          <span>→</span>
        </>
      )}
      <span class="text-[#575757] dark:text-zinc-300 truncate max-w-[200px] sm:max-w-none">{cleanTitle}</span>
    </nav>

    <!-- Article Header -->
    <header class="mb-10 space-y-4">
      {displayCategory && (
        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-[#ea2804]/10 text-[#ea2804] dark:bg-[#ea2804]/20 dark:text-[#ff6a3d]">
          {displayCategory}
        </span>
      )}

      <h1 class="font-display text-2xl sm:text-4xl md:text-5xl font-extrabold text-[#202020] dark:text-[#fcfcfc] tracking-tight leading-tight break-words">
        {cleanTitle}
      </h1>

      <!-- E-E-A-T byline: visible author + published/reviewed dates. Security &
           privacy guides are YMYL-adjacent, so showing editorial ownership and
           review freshness is a direct indexing-quality signal. -->
      {(formattedDate || displayCategory) && (
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs font-mono text-[#8d8d8d] dark:text-zinc-500 pt-1">
          <span class="inline-flex items-center gap-1.5">
            <span class="w-6 h-6 rounded-full bg-gradient-to-tr from-[#ea2804] to-[#ff6a3d] text-white flex items-center justify-center text-[10px] font-bold select-none" aria-hidden="true">T</span>
            <span class="font-semibold text-[#575757] dark:text-zinc-300">TempoEmails Editorial Team</span>
          </span>
          {formattedDate && (
            <span>Published: <time datetime={datePublishedISO}>{formattedDate}</time></span>
          )}
          {formattedUpdated && (
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 font-semibold">
              Updated: <time datetime={dateModifiedISO}>{formattedUpdated}</time>
            </span>
          )}
          {displayCategory && <span>{displayCategory}</span>}
        </div>
      )}

      <div class="w-16 h-1 rounded-full bg-gradient-to-r from-[#ea2804] to-[#ff6a3d]"></div>
    </header>

    <!-- Multilingual Translation Notice Banner for non-default locales -->
    {currentLocale !== 'en' && category && (
      <aside
        class="mb-8 p-4 sm:p-5 rounded-2xl bg-amber-500/10 dark:bg-amber-500/15 border border-amber-500/25 dark:border-amber-500/30 flex items-start gap-3.5 text-[#202020] dark:text-zinc-200"
        role="note"
        aria-label="Translation Notice"
      >
        <div class="w-8 h-8 rounded-full bg-amber-500/20 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0 text-base select-none">
          🌐
        </div>
        <div class="flex-1 text-xs sm:text-sm leading-relaxed">
          <p class="font-semibold text-amber-900 dark:text-amber-300 mb-0.5">
            {t.common.translationNotice}
          </p>
          <p class="text-[#575757] dark:text-zinc-400 text-xs">
            {currentLocale === 'es' && "El contenido del artículo se presenta en su idioma de publicación original mientras completamos la revisión editorial."}
            {currentLocale === 'pt' && "O conteúdo do artigo está no idioma de publicação original enquanto concluímos a revisão editorial."}
            {currentLocale === 'fr' && "Le texte de cet article est conservé en anglais le temps de finaliser notre révision éditoriale."}
            {currentLocale === 'de' && "Der Text wird in der englischen Originalfassung bereitgestellt, während die redaktionelle Übersetzung finalisiert wird."}
            {currentLocale === 'ru' && "Текст статьи представлен на языке оригинала, пока завершается редакционный перевод."}
            {currentLocale === 'zh' && "在编辑团队完成全篇本地化审校之前，正文内容保留英文原文供您参考。"}
            {currentLocale === 'ja' && "翻訳校正が完了するまでの間、記事本文は英語原文のまま掲載しております。"}
            {currentLocale === 'ar' && "يتم عرض محتوى المقال بلغته الأصلية ريثما نكتمل من المراجعة التحريرية الشاملة."}
            {currentLocale === 'id' && "Isi artikel ditampilkan dalam bahasa asli sembari tim editorial menyelesaikan ulasan terjemahan."}
          </p>
        </div>
      </aside>
    )}

    <!-- Article Content -->
    <div class="content-body space-y-1">
      <slot />
    </div>

    <!-- Client-side internal link localization for non-default locales -->
    {currentLocale !== 'en' && (
      <script is:inline define:vars={{ currentLocale }}>
        function localizeContentLinks() {
          const links = document.querySelectorAll('.content-body a[href^="/"]');
          links.forEach((a) => {
            const href = a.getAttribute('href');
            if (href && !href.startsWith(`/${currentLocale}/`) && !href.startsWith('/#') && !href.startsWith('//')) {
              a.setAttribute('href', href === '/' ? `/${currentLocale}/` : `/${currentLocale}${href}`);
            }
          });
        }
        localizeContentLinks();
        document.addEventListener('astro:page-load', localizeContentLinks);
      </script>
    )}

    <!-- FAQ section (visible) — rendered when the page supplies faqItems -->
    {faqItems && faqItems.length > 0 && (
      <section class="mt-14 space-y-4" aria-label="Frequently asked questions">
        <h2 class="font-display text-2xl font-bold text-[#202020] dark:text-[#fcfcfc]">
          Frequently Asked Questions
        </h2>
        <div class="space-y-3">
          {faqItems.map((f) => (
            <details class="group rounded-2xl border border-black/10 dark:border-white/10 bg-white/70 dark:bg-zinc-900/60 px-5 py-4 open:shadow-md transition-shadow">
              <summary class="cursor-pointer font-semibold text-sm sm:text-base text-[#202020] dark:text-[#fcfcfc] list-none flex items-center justify-between gap-3">
                <span>{f.question}</span>
                <span class="text-[#ea2804] transition-transform group-open:rotate-45 text-xl leading-none select-none">+</span>
              </summary>
              <p class="mt-2 text-sm text-[#575757] dark:text-zinc-300 leading-relaxed">{f.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Related guides — internal link mesh so no article is a dead end -->
    {relatedArticles.length > 0 && (
      <section class="mt-14" aria-label="Related guides">
        <div class="flex items-center justify-between gap-3 mb-5">
          <h2 class="font-display text-2xl font-bold text-[#202020] dark:text-[#fcfcfc]">
            Related Guides
          </h2>
          {category && (
            <a href={blogUrl} class="text-xs font-semibold text-[#ea2804] hover:underline shrink-0">
              {t.common.allArticles}
            </a>
          )}
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {relatedArticles.map((a) => (
            <a
              href={getLocalizedPath(a.slug, currentLocale)}
              class="group block rounded-2xl border border-black/10 dark:border-white/10 bg-white/70 dark:bg-zinc-900/60 p-5 hover:border-[#ea2804]/40 dark:hover:border-[#ea2804]/40 hover:shadow-md transition-all"
            >
              <div class="text-[10px] font-mono uppercase tracking-wider text-[#8d8d8d] dark:text-zinc-500 mb-2">
                {getCategoryLabel(a.category)} • {formatDate(a.date, currentLocale)}
              </div>
              <div class="font-display text-sm font-bold text-[#202020] dark:text-[#fcfcfc] leading-snug group-hover:text-[#ea2804] dark:group-hover:text-[#ff6a3d] transition-colors mb-1.5">
                {a.title}
              </div>
              <div class="text-xs text-[#575757] dark:text-zinc-400 leading-relaxed line-clamp-3">
                {a.description}
              </div>
              <div class="mt-3 text-xs font-semibold text-[#ea2804] dark:text-[#ff6a3d]">
                {t.common.readArticle} →
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Back to Home / Blog -->
    <footer class="mt-16 pt-8 border-t border-black/10 dark:border-white/10">
      <div class="flex flex-wrap items-center gap-4">
        <a
          href={homeUrl}
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold bg-white/80 dark:bg-zinc-800/80 border border-black/10 dark:border-white/10 text-[#202020] dark:text-[#fcfcfc] hover:bg-white dark:hover:bg-zinc-700 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
          </svg>
          {t.common.backToHome}
        </a>
        {category && (
          <a
            href={blogUrl}
            class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold text-[#ea2804] hover:underline"
          >
            {t.common.allArticles}
          </a>
        )}
      </div>
    </footer>
  </article>
</Layout>
