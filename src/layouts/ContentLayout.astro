---
import Layout from './Layout.astro';
import Icon from '../components/ui/Icon.astro';
import { SITE_CONFIG } from '../lib/config';
import { useTranslation, getLocaleFromUrl, getLocalizedPath } from '../i18n/utils';
import { getBlogArticleBySlug, getBlogArticles } from '../i18n/blog-data';
import type { Locale } from '../i18n/languages';

export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  publishDate?: string;
  updatedDate?: string;
  category?: string;
  keywords?: string;
  locale?: Locale;
  faqItems?: FaqItem[];
}

const { title, description, publishDate, updatedDate, category, keywords, locale, faqItems } = Astro.props;
const currentLocale = locale || getLocaleFromUrl(Astro.url);
const t = useTranslation(currentLocale);

// If this is a blog post, fetch localized title & description if available
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const currentSlug = pathSegments[pathSegments.length - 1] || '';
const localizedArticle = category ? getBlogArticleBySlug(currentSlug, currentLocale) : undefined;
const displayTitle = localizedArticle?.title || title;
const displayDescription = localizedArticle?.description || description;

// Clean displayTitle for headings and breadcrumbs (strip redundant brand suffix if present)
const cleanTitle = displayTitle.replace(/\s*[—–-]\s*TempoEmails.*$/i, '').trim();

// Full title for the <title> tag: ensure brand is included once
const metaTitle = displayTitle.includes('TempoEmails')
  ? displayTitle
  : `${displayTitle} — TempoEmails`;

function getCategoryLabel(cat?: string) {
  if (!cat) return '';
  if (cat === 'Privacy') return t.common.privacy;
  if (cat === 'Security') return t.common.security;
  if (cat === 'Guides') return t.common.guide;
  if (cat === 'Technology') return t.common.architecture;
  return cat;
}
const displayCategory = getCategoryLabel(category);

const siteUrl = Astro.site?.origin || SITE_CONFIG.siteUrl;
// Canonical must always carry a trailing slash so the <link rel="canonical">,
// JSON-LD `mainEntityOfPage`, breadcrumbs and the sitemap agree on one URL.
// (Layout.astro already normalizes; this keeps structured data consistent.)
const canonicalPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalURL = new URL(canonicalPath, siteUrl);
const homeUrl = currentLocale === 'en' ? '/' : `/${currentLocale}/`;
const blogUrl = getLocalizedPath('/blog/', currentLocale);
const aboutUrl = getLocalizedPath('/about/', currentLocale);

// Freshness signals: dateModified must be >= datePublished and reflect the
// last editorial review. Falls back to publishDate when no review happened.
const datePublishedISO = publishDate ? new Date(publishDate).toISOString() : undefined;
const effectiveUpdated = updatedDate || publishDate;
const dateModifiedISO = effectiveUpdated ? new Date(effectiveUpdated).toISOString() : undefined;
const hasFreshUpdate = Boolean(publishDate && updatedDate && updatedDate !== publishDate);

function formatDate(dateStr: string, loc: string) {
  return new Date(dateStr).toLocaleDateString(loc, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    // Dates are UTC midnight; formatting in the build machine's zone shifted them a day.
    timeZone: 'UTC',
  });
}

const formattedDate = publishDate
  ? formatDate(publishDate, currentLocale)
  : null;
const formattedUpdated = hasFreshUpdate && effectiveUpdated
  ? formatDate(effectiveUpdated, currentLocale)
  : null;

// JSON-LD Schema: BreadcrumbList
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t.common.home,
      item: `${canonicalURL.origin}${homeUrl}`,
    },
    ...(category
      ? [
          {
            '@type': 'ListItem',
            position: 2,
            name: t.common.blog,
            item: `${canonicalURL.origin}${blogUrl}`,
          },
          {
            '@type': 'ListItem',
            position: 3,
            name: cleanTitle,
            item: canonicalURL.href,
          },
        ]
      : [
          {
            '@type': 'ListItem',
            position: 2,
            name: cleanTitle,
            item: canonicalURL.href,
          },
        ]),
  ],
};

// JSON-LD Schema: BlogPosting (richer than generic Article — carries the
// E-E-A-T signals Google needs for YMYL-adjacent security/privacy guides:
// explicit author + publisher, distinct datePublished/dateModified, section,
// and stable mainEntityOfPage matching the canonical URL).
const articleSchema = publishDate
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: cleanTitle,
      description: displayDescription,
      inLanguage: currentLocale,
      datePublished: datePublishedISO,
      dateModified: dateModifiedISO,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalURL.href,
      },
      author: {
        '@type': 'Organization',
        name: 'TempoEmails Editorial Team',
        url: `${canonicalURL.origin}${aboutUrl}`,
      },
      editor: {
        '@type': 'Organization',
        name: 'TempoEmails Editorial Team',
        url: `${canonicalURL.origin}${aboutUrl}`,
      },
      publisher: {
        '@type': 'Organization',
        name: 'TempoEmails',
        url: `${canonicalURL.origin}/`,
        logo: {
          '@type': 'ImageObject',
          url: `${canonicalURL.origin}/android-chrome-512x512.png`,
        },
      },
      image: `${canonicalURL.origin}/og-image.png`,
      articleSection: displayCategory || 'Privacy',
    }
  : null;

// JSON-LD Schema: FAQPage (only when the page supplies faqItems)
const faqSchema = faqItems && faqItems.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      inLanguage: currentLocale,
      mainEntity: faqItems.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.answer,
        },
      })),
    }
  : null;

// Related guides: same-category first, then newest others, excluding self.
// This internal-link mesh is deliberate: every article now links out to three
// siblings (and receives inbound links from them), lifting crawl depth and
// PageRank flow for pages Google previously crawled but declined to index.
const allArticles = category ? getBlogArticles(currentLocale) : [];
const normalizedSlug = currentSlug.toLowerCase();
const sameCategory = allArticles.filter(
  (a) => a.slug.toLowerCase().replace(/\/+$/g, '').split('/').pop() !== normalizedSlug &&
    a.category === category
);
const otherCategory = allArticles.filter(
  (a) => a.slug.toLowerCase().replace(/\/+$/g, '').split('/').pop() !== normalizedSlug &&
    a.category !== category
);
const relatedArticles = [...sameCategory, ...otherCategory].slice(0, 3);

// Render the page body once so we can anchor its <h2>s and build a
// server-rendered "On this page" index for long articles and legal pages.
const rawBody = await Astro.slots.render('default');
const toc: { id: string; text: string }[] = [];
const usedIds = new Set<string>();
const bodyHtml = rawBody.replace(/<h2(\s[^>]*)?>([\s\S]*?)<\/h2>/g, (match, attrs = '', inner) => {
  if (/\sid=/.test(attrs)) return match;
  const text = inner.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
  let id =
    text
      .toLowerCase()
      .normalize('NFKD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^\p{L}\p{N}]+/gu, '-')
      .replace(/^-+|-+$/g, '')
      .slice(0, 60) || `section-${toc.length + 1}`;
  while (usedIds.has(id)) id = `${id}-${toc.length + 1}`;
  usedIds.add(id);
  toc.push({ id, text });
  return `<h2${attrs} id="${id}">${inner}</h2>`;
});
const showToc = toc.length >= 3;

const translationNotices: Partial<Record<Locale, string>> = {
  es: 'El contenido del artículo se presenta en su idioma de publicación original mientras completamos la revisión editorial.',
  pt: 'O conteúdo do artigo está no idioma de publicação original enquanto concluímos a revisão editorial.',
  fr: 'Le texte de cet article est conservé en anglais le temps de finaliser notre révision éditoriale.',
  de: 'Der Text wird in der englischen Originalfassung bereitgestellt, während die redaktionelle Übersetzung finalisiert wird.',
  ru: 'Текст статьи представлен на языке оригинала, пока завершается редакционный перевод.',
  zh: '在编辑团队完成全篇本地化审校之前，正文内容保留英文原文供您参考。',
  ja: '翻訳校正が完了するまでの間、記事本文は英語原文のまま掲載しております。',
  ar: 'يتم عرض محتوى المقال بلغته الأصلية ريثما نكتمل من المراجعة التحريرية الشاملة.',
  id: 'Isi artikel ditampilkan dalam bahasa asli sembari tim editorial menyelesaikan ulasan terjemahan.',
};
---

<Layout
  title={metaTitle}
  description={displayDescription}
  keywords={keywords}
  ogType={publishDate ? 'article' : 'website'}
  publishDate={datePublishedISO}
  modifiedDate={dateModifiedISO}
  category={displayCategory}
  locale={currentLocale}
  isApp={false}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <!-- Reading progress -->
  <div class="fixed top-0 inset-x-0 h-[2px] z-50 pointer-events-none" aria-hidden="true">
    <div id="reading-progress" class="h-full bg-gradient-to-r from-brand to-brand-glow origin-left rtl:origin-right scale-x-0"></div>
  </div>

  <div class="px-5 sm:px-8 pt-10 sm:pt-16">
    <!-- Article header -->
    <header class="max-w-3xl mx-auto text-center">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center justify-center gap-1.5 text-[13px] text-subtle">
        <a href={homeUrl} class="hover:text-ink transition-colors">{t.common.home}</a>
        {category && (
          <>
            <svg class="w-3.5 h-3.5 opacity-50 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
            <a href={blogUrl} class="hover:text-ink transition-colors">{t.common.blog}</a>
          </>
        )}
        <svg class="w-3.5 h-3.5 opacity-50 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
        <span class="text-muted truncate max-w-[14rem] sm:max-w-sm" aria-current="page">{cleanTitle}</span>
      </nav>

      {displayCategory && (
        <p class="mt-8 eyebrow justify-center before:hidden">{displayCategory}</p>
      )}

      <h1 class:list={['font-display font-bold text-ink tracking-[-0.04em] leading-[1.04] text-[clamp(2.1rem,1.3rem+3.4vw,3.75rem)] break-words', displayCategory ? 'mt-4' : 'mt-8']}>
        {cleanTitle}
      </h1>

      <!-- E-E-A-T byline: visible author + published/reviewed dates. Security &
           privacy guides are YMYL-adjacent, so showing editorial ownership and
           review freshness is a direct indexing-quality signal. -->
      {formattedDate && (
        <div class="mt-7 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-sm text-muted">
          <span class="inline-flex items-center gap-2">
            <span class="w-7 h-7 rounded-lg bg-gradient-to-br from-brand to-brand-glow text-white grid place-items-center text-xs font-bold select-none" aria-hidden="true">T</span>
            <span class="font-medium text-ink">TempoEmails Editorial Team</span>
          </span>
          <span class="text-subtle" aria-hidden="true">·</span>
          <span>Published <time datetime={datePublishedISO}>{formattedDate}</time></span>
          {formattedUpdated && (
            <span class="chip h-7 text-success! border-success/25!">
              Updated <time datetime={dateModifiedISO}>{formattedUpdated}</time>
            </span>
          )}
        </div>
      )}
    </header>

    <div class:list={['mx-auto mt-12 sm:mt-16', showToc ? 'max-w-6xl grid xl:grid-cols-[minmax(0,1fr)_15rem] gap-16' : 'max-w-3xl']}>
      <article class:list={['min-w-0', showToc && 'max-w-3xl xl:ms-auto w-full']}>
        {currentLocale !== 'en' && category && (
          <aside class="mb-10 flex items-start gap-3 rounded-2xl surface-inset p-4 text-sm" role="note" aria-label="Translation Notice">
            <svg class="w-5 h-5 mt-0.5 shrink-0 text-accent-text" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 8 6 6M4 14l6-6 2-3M2 5h12M7 2h1M22 22l-5-10-5 10M14 18h6"></path></svg>
            <div>
              <p class="font-medium text-ink">{t.common.translationNotice}</p>
              <p class="text-muted mt-0.5">{translationNotices[currentLocale]}</p>
            </div>
          </aside>
        )}

        <div class="content-body" set:html={bodyHtml} />

        {faqItems && faqItems.length > 0 && (
          <section class="mt-16" aria-label={t.pages.blog.faqHeading}>
            <h2 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-ink mb-4">{t.pages.blog.faqHeading}</h2>
            <div class="divide-y divide-line border-y hairline">
              {faqItems.map((f) => (
                <details class="group">
                  <summary class="flex items-start justify-between gap-6 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                    <span class="font-display text-lg font-semibold tracking-tight text-ink group-hover:text-accent-text transition-colors">{f.question}</span>
                    <span class="shrink-0 grid place-items-center w-7 h-7 rounded-full border border-line-strong text-ink-2 transition-transform duration-300 group-open:rotate-45" aria-hidden="true">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
                    </span>
                  </summary>
                  <p class="pb-5 pe-12 text-base text-muted leading-relaxed">{f.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )}

        <div class="mt-14 pt-8 border-t hairline flex flex-wrap items-center gap-3">
          <a href={homeUrl} class="btn btn-secondary">
            <svg class="w-4 h-4 rtl:-scale-x-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6"></path></svg>
            {t.common.backToHome}
          </a>
          {category && (
            <a href={blogUrl} class="btn btn-ghost">
              {t.common.allArticles}
              <Icon name="arrow-right" class="w-4 h-4 rtl:-scale-x-100" strokeWidth={2} />
            </a>
          )}
        </div>
      </article>

      {showToc && (
        <aside class="hidden xl:block" aria-label={t.common.onThisPage}>
          <nav class="sticky top-28">
            <p class="text-xs font-semibold text-ink mb-4">{t.common.onThisPage}</p>
            <ol class="toc-list space-y-1 border-s hairline">
              {toc.map((item) => (
                <li>
                  <a
                    href={`#${item.id}`}
                    data-toc-id={item.id}
                    class="block -ms-px ps-4 py-1.5 border-s-2 border-transparent text-[13px] leading-snug text-muted hover:text-ink transition-colors aria-[current=true]:border-accent aria-[current=true]:text-ink"
                  >
                    {item.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )}
    </div>

    {relatedArticles.length > 0 && (
      <section class="max-w-6xl mx-auto mt-24" aria-label="Related guides">
        <div class="flex items-end justify-between gap-4 mb-8">
          <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-ink">{t.pages.blog.relatedHeading}</h2>
          <a href={blogUrl} class="btn btn-secondary btn-sm shrink-0">
            {t.common.allArticles}
            <Icon name="arrow-right" class="w-4 h-4 rtl:-scale-x-100" strokeWidth={2} />
          </a>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          {relatedArticles.map((a) => (
            <a href={getLocalizedPath(a.slug, currentLocale)} class="group surface card-hover rounded-3xl p-6 flex flex-col">
              <div class="flex items-center gap-2 text-xs text-subtle">
                <span class="font-medium text-accent-text">{getCategoryLabel(a.category)}</span>
                <span aria-hidden="true">·</span>
                <time datetime={a.date}>{formatDate(a.date, currentLocale)}</time>
              </div>
              <h3 class="mt-3 font-display text-lg font-semibold tracking-tight leading-snug text-ink group-hover:text-accent-text transition-colors">{a.title}</h3>
              <span class="mt-auto pt-6 inline-flex items-center gap-1.5 text-sm font-medium text-ink-2">
                {t.common.readArticle}
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1 rtl:-scale-x-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  <!-- Client-side internal link localization for non-default locales -->
  {currentLocale !== 'en' && (
    <script is:inline define:vars={{ currentLocale }}>
      function localizeContentLinks() {
        const links = document.querySelectorAll('.content-body a[href^="/"]');
        links.forEach((a) => {
          const href = a.getAttribute('href');
          if (href && !href.startsWith(`/${currentLocale}/`) && !href.startsWith('/#') && !href.startsWith('//')) {
            a.setAttribute('href', href === '/' ? `/${currentLocale}/` : `/${currentLocale}${href}`);
          }
        });
      }
      localizeContentLinks();
      document.addEventListener('astro:page-load', localizeContentLinks);
    </script>
  )}
</Layout>

<script>
  // Reading progress bar + active "On this page" entry.
  function setupReading() {
    const bar = document.getElementById('reading-progress');
    const body = document.querySelector<HTMLElement>('.content-body');
    if (!bar || !body) return;

    const update = () => {
      const rect = body.getBoundingClientRect();
      const total = rect.height - window.innerHeight * 0.6;
      const progress = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1;
      bar.style.transform = `scaleX(${progress})`;
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });

    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-id]'));
    if (tocLinks.length === 0 || !('IntersectionObserver' in window)) return;
    const headings = tocLinks
      .map((a) => document.getElementById(a.dataset.tocId || ''))
      .filter((h): h is HTMLElement => Boolean(h));
    const setActive = (id: string) => {
      tocLinks.forEach((a) => a.setAttribute('aria-current', String(a.dataset.tocId === id)));
    };
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '0px 0px -70% 0px' }
    );
    headings.forEach((h) => io.observe(h));
  }

  setupReading();
</script>
