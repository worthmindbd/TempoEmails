---
import SectionHeading from '../ui/SectionHeading.astro';
import { useTranslation } from '../../i18n/utils';
import type { Locale } from '../../i18n/languages';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslation(locale);
const digits = '593821'.split('');
const tags = [t.otpShowcase.tag1, t.otpShowcase.tag2, t.otpShowcase.tag3];
---

<section class="px-5 sm:px-8 py-16 sm:py-24">
  <div class="max-w-6xl mx-auto grid lg:grid-cols-[1fr_1.05fr] gap-12 lg:gap-20 items-center">
    <SectionHeading eyebrow={t.otpShowcase.badge} title={t.otpShowcase.title} subtitle={t.otpShowcase.subtitle}>
      <ul class="flex flex-wrap gap-2 mt-8">
        {tags.map((tag) => (
          <li class="chip h-8 px-3.5 text-[13px]">
            <svg class="w-3.5 h-3.5 text-accent-text" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
            {tag}
          </li>
        ))}
      </ul>
    </SectionHeading>

    <!-- Illustrative mock of the reader detecting a code -->
    <div class="relative" data-reveal style="--reveal-delay: 2" aria-hidden="true">
      <div class="absolute -inset-8 bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--brand)_18%,transparent),transparent)] blur-2xl"></div>

      <div class="relative surface-raised rounded-[2rem] p-3 sm:p-4 rotate-[1.5deg]">
        <!-- Incoming message row -->
        <div class="flex items-center gap-3 rounded-2xl surface-inset p-3.5">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand to-brand-glow text-white grid place-items-center font-semibold shrink-0">S</div>
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline justify-between gap-2">
              <span class="text-sm font-semibold text-ink truncate">{t.otpShowcase.previewFrom.replace(/^[^:]*:\s*/, '')}</span>
              <span class="text-[11px] font-mono text-subtle shrink-0">{t.otpShowcase.previewTime}</span>
            </div>
            <p class="text-[13px] text-muted truncate">{t.otpShowcase.previewSubj}</p>
          </div>
          <span class="w-2.5 h-2.5 rounded-full bg-accent shrink-0"></span>
        </div>

        <!-- Extracted code -->
        <div class="mt-3 rounded-2xl p-5 sm:p-6 bg-[radial-gradient(120%_120%_at_0%_0%,color-mix(in_srgb,var(--brand)_12%,var(--surface)),var(--surface)_60%)] border border-accent/20">
          <div class="flex items-center justify-between mb-4">
            <span class="flex items-center gap-1.5 text-xs font-medium text-accent-text">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
              {t.otpShowcase.previewCode}
            </span>
            <span class="chip h-6 px-2 text-[11px] text-success! border-success/25!">
              <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
              {t.otpShowcase.previewDetected}
            </span>
          </div>

          <div class="grid grid-cols-6 gap-1.5 sm:gap-2.5">
            {digits.map((d, i) => (
              <span
                class="otp-digit grid place-items-center aspect-[4/5] rounded-xl surface font-mono text-2xl sm:text-4xl font-semibold text-ink"
                style={`--i: ${i}`}
              >
                {d}
              </span>
            ))}
          </div>

          <div class="mt-5 flex items-center gap-3">
            <span class="btn btn-primary btn-sm pointer-events-none">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2.5"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              {t.otpShowcase.previewCopy}
            </span>
            <span class="h-2 flex-1 rounded-full bg-ink/6 overflow-hidden">
              <span class="block h-full w-2/3 rounded-full bg-gradient-to-r from-brand to-brand-glow"></span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
