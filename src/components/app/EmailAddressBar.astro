---
import { useTranslation } from '../../i18n/utils';
import type { Locale } from '../../i18n/languages';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslation(locale);

const actionBtn = 'btn btn-sm btn-soft w-full sm:w-auto';
---

<div class="relative px-4 sm:px-6 py-4 sm:py-5 border-b hairline bg-surface-2/70">
  <div class="flex flex-col gap-2.5 sm:gap-3">
    <!-- Address -->
    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2 mb-1.5">
        <span class="relative flex w-2 h-2" aria-hidden="true">
          <span class="absolute inset-0 rounded-full bg-success animate-ping opacity-60"></span>
          <span class="relative w-2 h-2 rounded-full bg-success"></span>
        </span>
        <span class="text-[13px] font-medium text-muted">{t.addressBar.tempEmailLabel}</span>
        <button
          type="button"
          id="provider-badge"
          class="chip h-6 px-2 text-[11px] font-mono uppercase tracking-wide"
        >
          {t.addressBar.liveBadge}
        </button>
      </div>
      <button
        type="button"
        id="current-email-display"
        class="block max-w-full truncate text-start font-mono text-[19px] sm:text-2xl lg:text-[26px] font-semibold tracking-tight text-ink cursor-copy hover:text-accent-text transition-colors"
        title={t.addressBar.copyAddress}
      >
        <span class="inline-block w-56 h-7 bg-ink/10 animate-pulse rounded-md align-middle"></span>
      </button>
    </div>

    <!-- Actions -->
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" id="copy-email-btn" class="btn btn-primary w-full sm:w-auto sm:min-w-[10.5rem] sm:me-2" title={t.addressBar.copyAddress}>
        <svg id="copy-icon" class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2.5"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <svg id="check-icon" class="w-4 h-4 hidden shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
        <span id="copy-btn-text" class="truncate">{t.addressBar.copyAddress}</span>
      </button>

      <div class="grid grid-cols-2 gap-2 w-full sm:w-auto sm:flex sm:flex-wrap lg:flex-nowrap">
        <button type="button" id="refresh-inbox-btn" class={actionBtn} title={t.addressBar.refreshTooltip} aria-label={t.addressBar.refreshTooltip}>
          <svg id="refresh-icon" class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12a9 9 0 1 1-2.64-6.36L21 8"></path>
            <path d="M21 3v5h-5"></path>
          </svg>
          <span class="truncate">{t.addressBar.refreshLabel}</span>
        </button>
        <button type="button" id="custom-email-btn" class={actionBtn} title={t.addressBar.customTooltip} aria-label={t.addressBar.customTooltip}>
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9"></path>
            <path d="M16.38 3.62a1 1 0 0 1 3 3L7.37 18.64a2 2 0 0 1-.85.5l-2.87.84a.5.5 0 0 1-.62-.62l.84-2.87a2 2 0 0 1 .5-.85z"></path>
          </svg>
          <span class="truncate">{t.addressBar.customLabel}</span>
        </button>
        <button type="button" id="qr-code-btn" class={actionBtn} title={t.addressBar.qrTooltip} aria-label={t.addressBar.qrTooltip}>
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
            <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
            <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
            <path d="M14 14h3v3M21 14v.01M14 21h7v-4M17 21v.01"></path>
          </svg>
          <span class="truncate">{t.addressBar.qrLabel}</span>
        </button>
        <button type="button" id="access-btn" class={actionBtn} title={t.addressBar.accessTooltip} aria-label={t.addressBar.accessTooltip}>
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"></path>
            <circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle>
          </svg>
          <span class="truncate">{t.addressBar.accessLabel}</span>
        </button>
        <button type="button" id="change-email-btn" class={actionBtn} title={t.addressBar.changeTooltip} aria-label={t.addressBar.changeTooltip}>
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="m18 14 4 4-4 4"></path>
            <path d="m18 2 4 4-4 4"></path>
            <path d="M2 18h1.97a4 4 0 0 0 3.3-1.7l5.45-8.6a4 4 0 0 1 3.3-1.7H22"></path>
            <path d="M2 6h1.97a4 4 0 0 1 3.4 1.9"></path>
            <path d="M22 18h-5.9a4 4 0 0 1-3.4-1.9"></path>
          </svg>
          <span class="truncate">{t.addressBar.changeLabel}</span>
        </button>
        <button type="button" id="delete-inbox-btn" class:list={[actionBtn, 'hover:text-danger! hover:border-danger/30!']} title={t.addressBar.deleteTooltip} aria-label={t.addressBar.deleteTooltip}>
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          </svg>
          <span class="truncate">{t.addressBar.deleteLabel}</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Auto-refresh countdown, drawn as a hairline along the bottom edge -->
  <div class="absolute inset-x-0 bottom-[-1px] h-[2px] overflow-hidden" aria-hidden="true">
    <div
      id="refresh-progress-bar"
      class="h-full w-full bg-gradient-to-r from-brand to-brand-glow origin-left rtl:origin-right scale-x-0 transition-transform duration-1000 ease-linear"
    ></div>
  </div>
</div>
