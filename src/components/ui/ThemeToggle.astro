---
import { useTranslation } from '../../i18n/utils';
import type { Locale } from '../../i18n/languages';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslation(locale);
---

<button
  id="theme-toggle-btn"
  type="button"
  aria-label={t.a11y.toggleTheme}
  class="btn btn-ghost w-9 h-9 p-0"
  title={t.a11y.toggleTheme}
>
  <!-- Sun (shown in dark mode) -->
  <svg id="sun-icon" class="w-[18px] h-[18px] hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2m-7.07-17.07 1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
  <!-- Moon (shown in light mode) -->
  <svg id="moon-icon" class="w-[18px] h-[18px] block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script>
  function setupThemeToggle() {
    if ((window as any).__tempoThemeBound) return;
    (window as any).__tempoThemeBound = true;
    const btn = document.getElementById('theme-toggle-btn');
    if (!btn) return;

    btn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch {}

      // Dispatch event
      window.dispatchEvent(
        new CustomEvent('tempomail:themechange', {
          detail: { isDark },
        })
      );
    });
  }

  // Initialize on load and view transitions
  setupThemeToggle();
  document.addEventListener('astro:page-load', setupThemeToggle);
</script>
