---
import Layout from '../layouts/Layout.astro';
import MailboxManager from '../components/app/MailboxManager.astro';
import OtpShowcase from '../components/sections/OtpShowcase.astro';
import Features from '../components/sections/Features.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Faq from '../components/sections/Faq.astro';
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Can I send emails from TempoEmails?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. TempoEmails is receive-only. Blocking outbound mail keeps our domains off spam blocklists, so your verification emails and activation codes arrive reliably without getting filtered.',
      },
    },
    {
      '@type': 'Question',
      name: 'How fast do verification emails and OTPs arrive?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Most incoming emails and OTP codes arrive within 2 to 5 seconds. The inbox automatically checks for new messages every 10 seconds, so you never need to refresh the page.',
      },
    },
    {
      '@type': 'Question',
      name: 'How long do temporary emails stay active?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Your temporary inbox stays active for your browser session. You can switch between up to 8 recent inboxes from the History drawer, or delete them anytime with one click.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is TempoEmails completely free?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. TempoEmails is 100% free with no limits on how many emails you can receive, no hidden fees, and no paid tiers.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do I need to sign up or provide personal details?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. You get a working disposable address the second you open the website. We never ask for your name, phone number, real email, or password.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I choose my own custom email username?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Click the "Custom" button in the address bar to pick your own username and choose from our available domain names.',
      },
    },
  ],
};
---

<Layout
  title="TempoEmails — Free Disposable Temporary Email & Verification Codes"
  description="Get an instant disposable temporary email address. Grab OTP verification codes, activation links, and confirmation messages with zero spam and zero logs."
  keywords="temp mail, temporary email, disposable email, throwaway email, burner email, fake email generator, 10 minute mail, 24 hour temp mail, temp mail for discord, temporary email for chatgpt, temp mail for telegram, temporary mail for steam, disposable email rest api"
  isApp={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <!-- Hero Section -->
  <section class="relative pt-8 pb-5 sm:pt-12 sm:pb-8 md:pt-16 md:pb-10 px-4 sm:px-6 lg:px-8 text-center max-w-5xl mx-auto space-y-4 sm:space-y-5">
    <!-- Editorial Display Headline (DESIGN.md specification) -->
    <h1 class="font-display text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold text-[#202020] dark:text-[#fcfcfc] tracking-tight leading-[1.08] sm:leading-[1.05]">
      Temporary email. <br class="hidden sm:inline" />
      <span class="bg-gradient-to-r from-[#ea2804] via-[#ff6a3d] to-[#ea2804] bg-clip-text text-transparent">
        Instant privacy.
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="text-sm sm:text-lg text-[#575757] dark:text-zinc-300 max-w-2xl mx-auto leading-relaxed">
      Get a temporary burner inbox in one click. Grab signup verification codes, OTPs, and activation links without exposing your personal email.
    </p>
  </section>

  <!-- Interactive TempMail Box Island -->
  <section id="mailbox-manager" class="px-3 sm:px-6 lg:px-8 pb-12">
    <MailboxManager />
  </section>

  <!-- OTP Feature Showcase -->
  <OtpShowcase />

  <!-- Features Grid -->
  <Features />

  <!-- 4-Step Process Guide -->
  <HowItWorks />

  <!-- FAQ Accordion -->
  <Faq />
</Layout>
