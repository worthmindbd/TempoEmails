---
import SectionHeading from '../ui/SectionHeading.astro';
import { useTranslation } from '../../i18n/utils';
import type { Locale } from '../../i18n/languages';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslation(locale);

const icons = [
  // Spark (AI & SaaS)
  '<path d="M9.94 14.06 4 20M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 3v4M21 5h-4"/>',
  // Gamepad
  '<path d="M6 11h4M8 9v4M15 12h.01M18 10h.01"/><path d="M17.32 5H6.68a4 4 0 0 0-3.98 3.59l-.98 8.62A2.5 2.5 0 0 0 4.2 20c.73 0 1.4-.32 1.87-.87L8 17h8l1.93 2.13c.47.55 1.14.87 1.87.87a2.5 2.5 0 0 0 2.48-2.79l-.98-8.62A4 4 0 0 0 17.32 5z"/>',
  // Message
  '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z"/>',
  // Code
  '<path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/>',
];

const useCases = (t.useCases.items || []).map((item, index) => ({ ...item, icon: icons[index] || icons[0] }));
---

<section id="use-cases" class="px-5 sm:px-8 py-16 sm:py-24">
  <div class="max-w-6xl mx-auto">
    <SectionHeading eyebrow={t.useCases.badge} title={t.useCases.title} subtitle={t.useCases.subtitle} />

    <div class="use-case-tabs mt-12 sm:mt-14 grid lg:grid-cols-[18rem_1fr] gap-4 lg:gap-6" data-reveal>
      <div
        role="tablist"
        aria-orientation="vertical"
        aria-label={t.useCases.title}
        class="flex lg:flex-col gap-2 overflow-x-auto -mx-5 px-5 sm:mx-0 sm:px-0 pb-1 lg:pb-0 [scrollbar-width:none]"
      >
        {useCases.map((u, i) => (
          <button
            type="button"
            role="tab"
            id={`use-case-tab-${i}`}
            aria-controls={`use-case-panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="use-case-tab group shrink-0 flex items-center gap-3 h-14 ps-2 pe-4 rounded-2xl text-start border transition-colors cursor-pointer border-transparent text-muted hover:text-ink hover:bg-ink/4 aria-selected:bg-surface aria-selected:border-line aria-selected:shadow-soft aria-selected:text-ink"
          >
            <span class="grid place-items-center w-10 h-10 rounded-xl bg-ink/5 group-aria-selected:bg-accent/10 group-aria-selected:text-accent-text transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={u.icon} />
            </span>
            <span class="text-[15px] font-medium whitespace-nowrap">{u.badge}</span>
          </button>
        ))}
      </div>

      {useCases.map((u, i) => (
        <div
          role="tabpanel"
          id={`use-case-panel-${i}`}
          aria-labelledby={`use-case-tab-${i}`}
          tabindex="0"
          class:list={['use-case-panel surface-raised rounded-[2rem] p-7 sm:p-10 lg:p-12 relative overflow-hidden min-h-[20rem] flex flex-col', i !== 0 && 'hidden']}
        >
          <div class="absolute -top-24 -end-24 w-72 h-72 rounded-full bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--brand)_16%,transparent),transparent)]" aria-hidden="true"></div>
          <svg class="absolute end-8 top-8 w-16 h-16 text-accent-text/15 hidden sm:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={u.icon} />

          <p class="relative text-sm font-medium text-accent-text">{u.category}</p>
          <h3 class="relative mt-3 font-display text-2xl sm:text-4xl font-semibold tracking-tight text-ink max-w-lg leading-tight">{u.title}</h3>
          <p class="relative mt-4 text-base text-muted leading-relaxed max-w-lg">{u.description}</p>

          <ul class="relative mt-auto pt-8 flex flex-wrap gap-2">
            {u.tags.map((tag) => (
              <li class="chip h-8 px-3.5 text-[13px]">{tag}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Accessible tabs: click, arrow keys, Home/End (WAI-ARIA tabs pattern).
  function setupUseCaseTabs() {
    document.querySelectorAll<HTMLElement>('.use-case-tabs').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.use-case-tab'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('.use-case-panel'));

      const select = (index: number, focus = false) => {
        tabs.forEach((tab, i) => {
          const active = i === index;
          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;
          panels[i]?.classList.toggle('hidden', !active);
          if (active && panels[i]) {
            panels[i].classList.remove('animate-rise-in');
            void panels[i].offsetWidth;
            panels[i].classList.add('animate-rise-in');
          }
        });
        if (focus) tabs[index]?.focus();
        tabs[index]?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      };

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(i));
        tab.addEventListener('keydown', (e) => {
          const last = tabs.length - 1;
          const next: Record<string, number> = {
            ArrowDown: i === last ? 0 : i + 1,
            ArrowRight: i === last ? 0 : i + 1,
            ArrowUp: i === 0 ? last : i - 1,
            ArrowLeft: i === 0 ? last : i - 1,
            Home: 0,
            End: last,
          };
          if (e.key in next) {
            e.preventDefault();
            select(next[e.key], true);
          }
        });
      });
    });
  }

  setupUseCaseTabs();
  document.addEventListener('astro:page-load', setupUseCaseTabs);
</script>
