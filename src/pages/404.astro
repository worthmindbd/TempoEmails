---
import Layout from '../layouts/Layout.astro';
import { useTranslation, getLocaleFromUrl, getLocalizedPath } from '../i18n/utils';

const currentLocale = getLocaleFromUrl(Astro.url);
const t = useTranslation(currentLocale);
const homeUrl = currentLocale === 'en' ? '/' : `/${currentLocale}/`;
const blogUrl = getLocalizedPath('/blog/', currentLocale);
const aboutUrl = getLocalizedPath('/about/', currentLocale);
const contactUrl = getLocalizedPath('/contact/', currentLocale);
const privacyUrl = getLocalizedPath('/privacy-policy/', currentLocale);
---

<Layout
  title={`${t.common.pageNotFoundBadge} — TempoEmails`}
  description={t.common.pageNotFoundDesc}
  locale={currentLocale}
  noindex={true}
>
  <section class="px-5 sm:px-8 py-16 sm:py-28">
    <div class="max-w-2xl mx-auto text-center">
      <!-- An "expired" message card -->
      <div class="relative mx-auto w-full max-w-xs animate-rise-in" aria-hidden="true">
        <div class="absolute inset-x-8 -top-3 h-full rounded-3xl surface-inset rotate-[-4deg]"></div>
        <div class="relative surface-raised rounded-3xl p-5 text-start rotate-[2deg]">
          <div class="flex items-center gap-3">
            <span class="w-10 h-10 rounded-xl bg-ink/6 grid place-items-center font-mono text-sm font-semibold text-muted">404</span>
            <div class="flex-1 space-y-2">
              <span class="block h-2.5 w-2/3 rounded-full bg-ink/12"></span>
              <span class="block h-2 w-full rounded-full bg-ink/7"></span>
            </div>
          </div>
          <div class="mt-4 h-2 rounded-full bg-ink/6 overflow-hidden">
            <span class="block h-full w-full bg-gradient-to-r from-brand to-brand-glow origin-left scale-x-0"></span>
          </div>
          <p class="mt-3 font-mono text-xs text-subtle">00:00 · {t.common.pageExpired}</p>
        </div>
      </div>

      <p class="mt-14 eyebrow justify-center before:hidden">404 · {t.common.pageNotFoundBadge}</p>
      <h1 class="mt-4 font-display font-bold text-ink tracking-[-0.045em] leading-[1] text-[clamp(2.5rem,1.6rem+4vw,4.5rem)]">
        {t.common.pageNotFoundTitle} <span class="text-gradient">{t.common.pageExpired}</span>
      </h1>
      <p class="mt-6 text-lg text-muted leading-relaxed max-w-md mx-auto">{t.common.pageNotFoundDesc}</p>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href={homeUrl} class="btn btn-primary btn-lg w-full sm:w-auto">{t.common.goToHomepage}</a>
        <a href={blogUrl} class="btn btn-secondary btn-lg w-full sm:w-auto">{t.common.readOurBlog}</a>
      </div>

      <nav class="mt-12 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-muted" aria-label="Helpful links">
        <a href={aboutUrl} class="hover:text-ink transition-colors">{t.nav.about}</a>
        <a href={contactUrl} class="hover:text-ink transition-colors">{t.nav.contact}</a>
        <a href={privacyUrl} class="hover:text-ink transition-colors">{t.footer.privacyPolicy}</a>
        <a href={blogUrl} class="hover:text-ink transition-colors">{t.nav.blog}</a>
      </nav>
    </div>
  </section>
</Layout>
