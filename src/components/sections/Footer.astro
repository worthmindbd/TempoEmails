---
import LanguageSelector from '../ui/LanguageSelector.astro';
import Logo from '../ui/Logo.astro';
import { useTranslation, getLocalizedPath } from '../../i18n/utils';
import type { Locale } from '../../i18n/languages';

interface Props {
  currentLocale?: Locale;
}

const { currentLocale = 'en' } = Astro.props;
const t = useTranslation(currentLocale);
const homeUrl = currentLocale === 'en' ? '/' : `/${currentLocale}/`;

const groups = [
  {
    title: t.footer.quickLinks,
    links: [
      { href: `${homeUrl}#mailbox-manager-section`, label: t.footer.instantInbox },
      { href: `${homeUrl}#features`, label: t.nav.features },
      { href: `${homeUrl}#how-it-works`, label: t.nav.howItWorks },
      { href: `${homeUrl}#faq`, label: t.nav.faq },
    ],
  },
  {
    title: t.footer.company,
    links: [
      { href: getLocalizedPath('/about/', currentLocale), label: t.nav.about },
      { href: getLocalizedPath('/contact/', currentLocale), label: t.nav.contact },
      { href: getLocalizedPath('/blog/', currentLocale), label: t.nav.blog },
    ],
  },
  {
    title: t.footer.legal,
    links: [
      { href: getLocalizedPath('/privacy-policy/', currentLocale), label: t.footer.privacyPolicy },
      { href: getLocalizedPath('/terms-of-service/', currentLocale), label: t.footer.termsOfService },
      { href: getLocalizedPath('/disclaimer/', currentLocale), label: t.footer.disclaimer },
    ],
  },
];
---

<footer class="relative z-10 mt-20 sm:mt-28 border-t hairline bg-canvas-2 px-5 sm:px-8">
  <div class="max-w-6xl mx-auto pt-14 sm:pt-16">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_2fr]">
      <div class="space-y-5 max-w-xs">
        <Logo href={homeUrl} />
        <p class="text-sm text-muted leading-relaxed">{t.footer.brandDesc}</p>
        <LanguageSelector currentLocale={currentLocale} variant="footer" />
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-8">
        {groups.map((group) => (
          <div>
            <h2 class="text-sm font-semibold text-ink mb-4">{group.title}</h2>
            <ul class="space-y-3">
              {group.links.map((link) => (
                <li>
                  <a href={link.href} class="text-sm text-muted hover:text-ink transition-colors">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-14 pt-6 border-t hairline flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-[13px] text-subtle">
      <p>© {new Date().getFullYear()} TempoEmails. {t.footer.allRightsReserved}</p>
      <p class="inline-flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-success" aria-hidden="true"></span>
        {t.addressBar.liveBadge}
      </p>
    </div>
  </div>

  <!-- Oversized wordmark, decorative only. The wrapper carries the clipping:
       it crops the wordmark's negative-margin bleed without turning the whole
       footer into a clip container (that used to slice the language
       selector's drop-up panel open from the footer trigger). -->
  <div class="overflow-hidden" aria-hidden="true">
    <div
      class="pointer-events-none select-none font-display font-extrabold leading-[0.8] tracking-[-0.06em] text-center text-ink/[0.05] text-[clamp(3.5rem,14.5vw,12.5rem)] mt-8 -mb-[0.14em] whitespace-nowrap"
    >
      TempoEmails
    </div>
  </div>
</footer>
