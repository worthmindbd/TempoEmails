---
import ThemeToggle from '../ui/ThemeToggle.astro';
import LanguageSelector from '../ui/LanguageSelector.astro';
import Logo from '../ui/Logo.astro';
import { useTranslation, getLocalizedPath } from '../../i18n/utils';
import type { Locale } from '../../i18n/languages';

interface Props {
  currentLocale?: Locale;
  isApp?: boolean;
}

const { currentLocale = 'en', isApp = false } = Astro.props;
const t = useTranslation(currentLocale);
const homeUrl = currentLocale === 'en' ? '/' : `/${currentLocale}/`;
const blogUrl = getLocalizedPath('/blog/', currentLocale);
const aboutUrl = getLocalizedPath('/about/', currentLocale);
const contactUrl = getLocalizedPath('/contact/', currentLocale);

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const navLinks = [
  { href: `${homeUrl}#features`, label: t.nav.features },
  { href: `${homeUrl}#how-it-works`, label: t.nav.howItWorks },
  { href: `${homeUrl}#faq`, label: t.nav.faq },
  { href: blogUrl, label: t.nav.blog, current: path.startsWith(blogUrl) },
  { href: aboutUrl, label: t.nav.about, current: path === aboutUrl, wide: true },
  { href: contactUrl, label: t.nav.contact, current: path === contactUrl, wide: true },
];
---

<header class="sticky top-0 z-40 w-full px-3 sm:px-5 pt-3">
  <div
    id="site-header-bar"
    class="glass mx-auto max-w-6xl h-14 rounded-full ps-3 pe-2 sm:ps-4 flex items-center justify-between gap-2"
  >
    <Logo href={homeUrl} />

    <nav class="hidden md:flex items-center gap-0.5" aria-label="Primary">
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={link.current ? 'page' : undefined}
          class:list={[
            'relative px-3 py-1.5 rounded-full text-sm font-medium transition-colors',
            link.wide && 'hidden lg:inline-flex',
            link.current
              ? 'text-ink bg-ink/6'
              : 'text-muted hover:text-ink hover:bg-ink/5',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-1.5">
      <div class="hidden sm:block">
        <LanguageSelector currentLocale={currentLocale} variant="header" />
      </div>

      <button
        id="sound-toggle-btn"
        type="button"
        class="btn btn-ghost w-9 h-9 p-0"
        title={t.a11y.toggleSound}
        aria-label={t.a11y.toggleSound}
        aria-pressed="true"
      >
        <svg id="sound-on-icon" class="w-[18px] h-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
          <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
        </svg>
        <svg id="sound-off-icon" class="w-[18px] h-[18px] hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8.7 3A6 6 0 0 1 18 8a21.3 21.3 0 0 0 .6 5"></path>
          <path d="M17 17H3s3-2 3-9a4.67 4.67 0 0 1 .3-1.7"></path>
          <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
          <path d="m2 2 20 20"></path>
        </svg>
      </button>

      <ThemeToggle locale={currentLocale} />

      {isApp && (
        <button id="header-history-btn" type="button" class="btn btn-secondary btn-sm hidden sm:inline-flex ms-1">
          <svg class="w-4 h-4 text-accent-text" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path>
            <path d="M3 3v5h5"></path>
            <path d="M12 7v5l3 2"></path>
          </svg>
          <span>{t.nav.history}</span>
        </button>
      )}

      <button
        id="mobile-menu-toggle"
        type="button"
        class="lg:hidden btn btn-ghost w-9 h-9 p-0"
        aria-label={t.a11y.toggleMenu}
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <svg id="hamburger-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round">
          <path d="M4 8h16M4 16h16"></path>
        </svg>
        <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round">
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile/tablet navigation drawer: stays available until lg, because the
       inline nav drops About/Contact (`link.wide`) below that width. -->
  <div
    id="mobile-nav-drawer"
    class="hidden lg:hidden mx-auto max-w-6xl mt-2 surface-raised rounded-3xl p-2 animate-rise-in"
  >
    <nav class="grid grid-cols-2 gap-1" aria-label="Mobile">
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={link.current ? 'page' : undefined}
          class:list={[
            'mobile-nav-link px-4 py-3.5 rounded-2xl text-[15px] font-medium transition-colors',
            link.current ? 'bg-accent/8 text-accent-text' : 'text-ink hover:bg-ink/5',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="mt-2 pt-2 border-t hairline flex flex-col gap-2 p-1">
      <LanguageSelector currentLocale={currentLocale} variant="drawer" />
      {isApp && (
        <button id="mobile-history-btn" type="button" class="btn btn-secondary w-full">
          <svg class="w-4 h-4 text-accent-text" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path>
            <path d="M3 3v5h5"></path>
            <path d="M12 7v5l3 2"></path>
          </svg>
          <span>{t.nav.history}</span>
        </button>
      )}
    </div>
  </div>
</header>

<script>
  import { soundNotifier } from '../../lib/utils/sound';

  function setupHeader() {
    if ((window as any).__tempoHeaderBound) return;
    (window as any).__tempoHeaderBound = true;

    const soundBtn = document.getElementById('sound-toggle-btn');
    const soundOn = document.getElementById('sound-on-icon');
    const soundOff = document.getElementById('sound-off-icon');

    const updateSoundUI = () => {
      const enabled = soundNotifier.isEnabled();
      soundOn?.classList.toggle('hidden', !enabled);
      soundOff?.classList.toggle('hidden', enabled);
      soundBtn?.setAttribute('aria-pressed', String(enabled));
    };

    updateSoundUI();

    soundBtn?.addEventListener('click', () => {
      soundNotifier.toggle();
      updateSoundUI();
      const i18n = (window as any).__TEMPO_I18N__;
      const isEnabled = soundNotifier.isEnabled();
      const soundMsg = isEnabled
        ? (i18n?.toasts?.soundEnabled || '🔔 Sound notifications enabled')
        : (i18n?.toasts?.soundMuted || '🔕 Sound notifications muted');
      window.dispatchEvent(
        new CustomEvent('tempomail:toast', {
          detail: {
            message: soundMsg,
            type: 'success',
          },
        })
      );
    });

    document.getElementById('header-history-btn')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('tempomail:openhistory'));
    });

    // Mobile Navigation Toggle
    const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
    const mobileNavDrawer = document.getElementById('mobile-nav-drawer');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    const toggleMobileMenu = (open?: boolean) => {
      if (!mobileNavDrawer || !mobileMenuToggle) return;
      const isCurrentlyOpen = !mobileNavDrawer.classList.contains('hidden');
      const shouldOpen = open !== undefined ? open : !isCurrentlyOpen;

      mobileNavDrawer.classList.toggle('hidden', !shouldOpen);
      hamburgerIcon?.classList.toggle('hidden', shouldOpen);
      closeIcon?.classList.toggle('hidden', !shouldOpen);
      mobileMenuToggle.setAttribute('aria-expanded', String(shouldOpen));
    };

    mobileMenuToggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMobileMenu();
    });

    // Mobile history button trigger
    document.getElementById('mobile-history-btn')?.addEventListener('click', () => {
      toggleMobileMenu(false);
      window.dispatchEvent(new CustomEvent('tempomail:openhistory'));
    });

    // Close mobile menu when clicking any link
    document.querySelectorAll('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', () => {
        toggleMobileMenu(false);
      });
    });

    // Close mobile menu on click outside
    document.addEventListener('click', (e) => {
      if (!mobileNavDrawer?.classList.contains('hidden')) {
        const header = document.querySelector('header');
        if (header && !header.contains(e.target as Node)) {
          toggleMobileMenu(false);
        }
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileNavDrawer?.classList.contains('hidden')) {
        toggleMobileMenu(false);
      }
    });
  }

  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>
