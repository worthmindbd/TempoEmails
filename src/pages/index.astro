---
import Layout from '../layouts/Layout.astro';
import MailboxManager from '../components/app/MailboxManager.astro';
import OtpShowcase from '../components/sections/OtpShowcase.astro';
import Features from '../components/sections/Features.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Faq from '../components/sections/Faq.astro';
---

<Layout
  title="TempoEmails — Free Disposable Temporary Email & Verification Codes"
  description="Free disposable temporary email generator (10 minute mail, 24h burner inbox). Instant OTP verification for Discord, ChatGPT, Steam, Telegram, Instagram & QA testing. 100% anonymous, zero logs."
  keywords="temp mail for discord sign up, temporary email for chatgpt verification, disposable email address for facebook account, temp mail for instagram verification code, throwaway email for telegram sign up, temporary email for steam registration, temp mail to receive twitter otp, 10 minute temp mail instant, 24 hour temporary email address, free temp mail generator us, temp mail uk free inbox, disposable email rest api free, anonymous temporary inbox no log"
>
  <!-- Hero Section -->
  <section class="relative pt-10 pb-6 md:pt-16 md:pb-10 px-4 sm:px-6 lg:px-8 text-center max-w-5xl mx-auto space-y-5">
    <!-- Editorial Display Headline (DESIGN.md specification) -->
    <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold text-[#202020] dark:text-[#fcfcfc] tracking-tight leading-[1.05]">
      Temporary email. <br class="hidden sm:inline" />
      <span class="bg-gradient-to-r from-[#ea2804] via-[#ff6a3d] to-[#ea2804] bg-clip-text text-transparent">
        Instant privacy.
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="text-base sm:text-lg text-[#575757] dark:text-zinc-300 max-w-2xl mx-auto leading-relaxed">
      Generate a disposable burner inbox in one click. Receive signup verification codes, activation OTPs, and confirmation links without ever exposing your personal email.
    </p>
  </section>

  <!-- Interactive TempMail Box Island -->
  <section id="mailbox-manager" class="px-4 sm:px-6 lg:px-8 pb-12">
    <MailboxManager />
  </section>

  <!-- OTP Feature Showcase -->
  <OtpShowcase />

  <!-- Features Grid -->
  <Features />

  <!-- 4-Step Process Guide -->
  <HowItWorks />

  <!-- FAQ Accordion -->
  <Faq />
</Layout>
