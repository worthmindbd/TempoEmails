---
import ContentLayout from '../layouts/ContentLayout.astro';
import { SITE_CONFIG } from '../lib/config';
import { useTranslation, getLocaleFromUrl, getLocalizedPath } from '../i18n/utils';
import { getContactPageData } from '../i18n/pages-data';
import type { Locale } from '../i18n/languages';

interface Props {
  locale?: Locale;
}

const { locale } = Astro.props;
const currentLocale = locale || getLocaleFromUrl(Astro.url);
const t = useTranslation(currentLocale);
const contact = getContactPageData(currentLocale);

const siteUrl = Astro.site?.origin || SITE_CONFIG.siteUrl;
const contactUrl = `${siteUrl}${getLocalizedPath('/contact/', currentLocale)}`;

// JSON-LD Structured Data: ContactPage + Organization ContactPoints
const contactPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: t.pages.contact.title,
  description: t.pages.contact.description,
  url: contactUrl,
  inLanguage: currentLocale,
  mainEntity: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: 'TempoEmails',
    url: `${siteUrl}/`,
    logo: `${siteUrl}/android-chrome-512x512.png`,
    contactPoint: [
      {
        '@type': 'ContactPoint',
        email: SITE_CONFIG.emails.support,
        contactType: 'technical support',
      },
      {
        '@type': 'ContactPoint',
        email: SITE_CONFIG.emails.contact,
        contactType: 'customer support',
      },
      {
        '@type': 'ContactPoint',
        email: SITE_CONFIG.emails.abuse,
        contactType: 'abuse reports',
      },
      {
        '@type': 'ContactPoint',
        email: SITE_CONFIG.emails.business,
        contactType: 'business inquiries',
      },
    ],
  },
};

// JSON-LD Structured Data: FAQPage Schema
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: currentLocale,
  mainEntity: contact.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a + (f.list ? ' ' + f.list.join(' ') : ''),
    },
  })),
};
---

<ContentLayout
  title={t.pages.contact.title}
  description={t.pages.contact.description}
  locale={currentLocale}
  keywords="contact tempoemails, disposable email support, temp mail customer service, fake email developer api, temporary email support"
>
  <!-- Inject JSON-LD Rich Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <p class="text-base text-[#575757] dark:text-zinc-300 leading-relaxed mb-4">
    {contact.lead}
  </p>

  <blockquote class="border-l-4 border-[#ea2804] pl-4 italic text-[#575757] dark:text-zinc-400 mb-6">
    {contact.responseTime}
  </blockquote>

  <!-- Direct Contact Channels -->
  <h2 class="font-display text-2xl font-bold text-[#202020] dark:text-[#fcfcfc] mb-4 mt-8">
    {contact.channelsHeading}
  </h2>
  <p class="text-base text-[#575757] dark:text-zinc-300 leading-relaxed mb-4">
    {contact.channelsSub}
  </p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
    {contact.channels.map((ch, idx) => (
      <div class="p-5 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 space-y-3">
        <div class="flex items-center gap-2 text-[#ea2804]">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            {idx === 0 && <path d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"></path>}
            {idx === 1 && <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>}
            {idx === 2 && <path d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>}
            {idx === 3 && <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>}
          </svg>
          <h3 class="font-display font-bold text-base text-[#202020] dark:text-[#fcfcfc]">{ch.title}</h3>
        </div>
        <p class="text-xs text-[#575757] dark:text-zinc-400">
          {ch.desc}
        </p>
        <div class="flex items-center justify-between pt-1">
          <a href={`mailto:${ch.email}`} class="text-sm font-mono font-semibold text-[#ea2804] hover:underline break-all">
            {ch.email}
          </a>
          <button
            type="button"
            data-copy-email={ch.email}
            data-copied-text={t.common.copied}
            class="copy-email-btn px-2.5 py-1 text-xs font-mono rounded-lg bg-black/5 dark:bg-white/10 hover:bg-[#ea2804]/10 hover:text-[#ea2804] transition-colors"
            title={t.addressBar.copyAddress}
          >
            {ch.copyLabel}
          </button>
        </div>
      </div>
    ))}
  </div>

  <!-- Frequently Asked Questions -->
  <h2 class="font-display text-2xl font-bold text-[#202020] dark:text-[#fcfcfc] mb-4 mt-8">
    {contact.faqHeading}
  </h2>
  <p class="text-base text-[#575757] dark:text-zinc-300 leading-relaxed mb-4">
    {contact.faqSub}
  </p>

  <div class="space-y-6 mb-8">
    {contact.faqs.map((f) => (
      <div class="p-5 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
        <h3 class="font-display text-lg font-bold text-[#202020] dark:text-[#fcfcfc] mb-2">
          {f.q}
        </h3>
        <p class="text-sm text-[#575757] dark:text-zinc-300 leading-relaxed mb-3">
          {f.a}
        </p>
        {f.list && f.list.length > 0 && (
          <ul class="list-disc pl-5 space-y-1.5 text-sm text-[#575757] dark:text-zinc-300">
            {f.list.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
      </div>
    ))}
  </div>

  <!-- Helpful Guides & Educational Resources -->
  <h2 class="font-display text-2xl font-bold text-[#202020] dark:text-[#fcfcfc] mb-4 mt-8">
    {contact.resourcesHeading}
  </h2>
  <p class="text-base text-[#575757] dark:text-zinc-300 leading-relaxed mb-4">
    {contact.resourcesSub}
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
    {contact.resources.map((r) => (
      <a
        href={getLocalizedPath(r.slug, currentLocale)}
        class="p-4 rounded-xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 hover:border-[#ea2804]/30 hover:bg-[#ea2804]/5 transition-all group"
      >
        <div class="text-xs font-mono text-[#ea2804] font-semibold mb-1">{r.badge}</div>
        <div class="font-display font-bold text-sm text-[#202020] dark:text-[#fcfcfc] group-hover:text-[#ea2804] transition-colors">
          {r.title}
        </div>
        <p class="text-xs text-[#575757] dark:text-zinc-400 mt-1">{r.desc}</p>
      </a>
    ))}
  </div>

  <!-- Tips for Bug Reports -->
  <h2 class="font-display text-2xl font-bold text-[#202020] dark:text-[#fcfcfc] mb-4 mt-8">
    {contact.bugReportHeading}
  </h2>
  <p class="text-base text-[#575757] dark:text-zinc-300 leading-relaxed mb-4">
    {contact.bugReportIntro}
  </p>
  <ul class="list-disc pl-6 space-y-2 text-base text-[#575757] dark:text-zinc-300 mb-6">
    {contact.bugReportPoints.map((pt) => (
      <li>{pt}</li>
    ))}
  </ul>

  <!-- Legal and Compliance Links -->
  <h2 class="font-display text-2xl font-bold text-[#202020] dark:text-[#fcfcfc] mb-4 mt-8">
    {contact.legalHeading}
  </h2>
  <p class="text-base text-[#575757] dark:text-zinc-300 leading-relaxed mb-4">
    {contact.legalIntro}
  </p>
  <ul class="list-disc pl-6 space-y-2 text-base text-[#575757] dark:text-zinc-300 mb-4">
    {contact.legalLinks.map((l) => (
      <li>
        <a href={getLocalizedPath(l.slug, currentLocale)} class="text-[#ea2804] hover:underline font-semibold">
          {l.label}
        </a>
        {' — '}{l.desc}
      </li>
    ))}
  </ul>
</ContentLayout>

<script>
  // Copy email to clipboard with toast notification
  document.querySelectorAll<HTMLButtonElement>('.copy-email-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-copy-email');
      if (!email) return;

      try {
        await navigator.clipboard.writeText(email);
        const originalText = btn.textContent;
        btn.textContent = 'Copied!';
        btn.classList.add('text-[#ea2804]', 'font-bold');

        window.dispatchEvent(
          new CustomEvent('tempomail:toast', {
            detail: {
              type: 'success',
              message: `Copied ${email} to clipboard!`,
              duration: 2500,
            },
          })
        );

        setTimeout(() => {
          btn.textContent = originalText;
          btn.classList.remove('text-[#ea2804]', 'font-bold');
        }, 2000);
      } catch {
        window.dispatchEvent(
          new CustomEvent('tempomail:toast', {
            detail: {
              type: 'error',
              message: 'Failed to copy address',
              duration: 2500,
            },
          })
        );
      }
    });
  });
</script>
