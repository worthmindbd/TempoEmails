---
import DialogHeader from '../ui/DialogHeader.astro';
import { useTranslation } from '../../i18n/utils';
import type { Locale } from '../../i18n/languages';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslation(locale);

const field =
  'w-full h-12 px-4 rounded-xl bg-surface border border-line-strong text-[15px] font-mono text-ink placeholder:text-subtle transition-shadow focus:outline-none focus:border-accent/60 focus:ring-4 focus:ring-accent/12';
---

<div
  id="custom-modal"
  class="dialog-overlay opacity-0 pointer-events-none"
  role="dialog"
  aria-hidden="true"
  inert
  aria-modal="true"
  aria-labelledby="custom-modal-title"
>
  <div id="custom-modal-content" class="dialog-panel max-w-md scale-95">
    <DialogHeader id="custom-modal-title" closeId="custom-modal-close" title={t.customModal.title} closeLabel={t.common.close} />
    <p class="text-sm text-muted mb-6">{t.customModal.desc}</p>

    <form id="custom-inbox-form" class="space-y-4">
      <div>
        <label for="custom-prefix-input" class="block text-sm font-medium text-ink mb-1.5">{t.customModal.usernameLabel}</label>
        <input
          type="text"
          id="custom-prefix-input"
          required
          maxlength="48"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          placeholder={t.customModal.usernamePlaceholder}
          pattern="[a-zA-Z0-9._-]+"
          class:list={[field, 'user-invalid:border-[#c81e3a]/60']}
        />
      </div>

      <div>
        <label for="custom-domain-select" class="block text-sm font-medium text-ink mb-1.5">{t.customModal.domainLabel}</label>
        <select id="custom-domain-select" class={field}>
          <option value="" disabled selected>{t.customModal.loadingDomains}</option>
        </select>
      </div>

      <div class="rounded-xl surface-inset px-4 py-3 text-sm text-muted flex flex-wrap items-baseline gap-x-2">
        <span>{t.customModal.preview}</span>
        <span id="custom-preview-address" class="font-mono font-semibold text-accent-text break-all">yourname@domain</span>
      </div>

      <div class="flex gap-2 pt-2">
        <button type="button" id="custom-modal-cancel" class="btn btn-ghost flex-1">{t.customModal.cancel}</button>
        <button type="submit" id="custom-modal-submit" class="btn btn-primary flex-1">{t.customModal.create}</button>
      </div>
    </form>
  </div>
</div>
