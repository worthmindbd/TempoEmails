---
import Layout from '../../layouts/Layout.astro';
import GlassCard from '../../components/ui/GlassCard.astro';
import Badge from '../../components/ui/Badge.astro';
import { useTranslation, getLocaleFromUrl, getLocalizedPath } from '../../i18n/utils';
import type { Locale } from '../../i18n/languages';

import { getBlogArticles } from '../../i18n/blog-data';
import { SITE_CONFIG } from '../../lib/config';

interface Props {
  locale?: Locale;
}

const { locale } = Astro.props;
const currentLocale = locale || getLocaleFromUrl(Astro.url);
const t = useTranslation(currentLocale);
const homeUrl = currentLocale === 'en' ? '/' : `/${currentLocale}/`;

const siteUrl = Astro.site?.origin || SITE_CONFIG.siteUrl;
let normalizedPath = Astro.url.pathname;
if (!normalizedPath.endsWith('/')) normalizedPath = `${normalizedPath}/`;
const canonicalURL = new URL(normalizedPath, siteUrl);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t.common.home,
      item: `${canonicalURL.origin}${homeUrl}`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t.common.blog,
      item: canonicalURL.href,
    },
  ],
};

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: t.pages.blog.title,
  description: t.pages.blog.description,
  url: canonicalURL.href,
  inLanguage: currentLocale,
  publisher: {
    '@type': 'Organization',
    '@id': `${canonicalURL.origin}/#organization`,
    name: 'TempoEmails',
  },
};

// Localized blog articles data — ordered by publish date (newest first)
const articles = getBlogArticles(currentLocale);

const categories = [...new Set(articles.map(a => a.category))];

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString(currentLocale, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

function getCategoryLabel(cat: string) {
  if (cat === 'Privacy') return t.common.privacy;
  if (cat === 'Security') return t.common.security;
  if (cat === 'Guides') return t.common.guide;
  if (cat === 'Technology') return t.common.architecture;
  return cat;
}

const categoryColors: Record<string, string> = {
  Privacy: 'bg-violet-500/10 text-violet-600 dark:bg-violet-500/20 dark:text-violet-400',
  Security: 'bg-emerald-500/10 text-emerald-600 dark:bg-emerald-500/20 dark:text-emerald-400',
  Guides: 'bg-amber-500/10 text-amber-600 dark:bg-amber-500/20 dark:text-amber-400',
  Technology: 'bg-sky-500/10 text-sky-600 dark:bg-sky-500/20 dark:text-sky-400',
};
---

<Layout
  title={t.pages.blog.title}
  description={t.pages.blog.description}
  locale={currentLocale}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />

  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    <!-- Breadcrumb Navigation -->
    <nav class="mb-8 flex flex-wrap items-center gap-2 text-xs font-mono text-[#8d8d8d] dark:text-zinc-500">
      <a href={homeUrl} class="hover:text-[#ea2804] transition-colors shrink-0">{t.common.home}</a>
      <span>→</span>
      <span class="text-[#575757] dark:text-zinc-300">{t.common.blog}</span>
    </nav>

    <!-- Header -->
    <div class="text-center mb-12 space-y-4">
      <Badge variant="neutral" size="md">
        TempoEmails {t.common.blog}
      </Badge>
      <h1 class="font-display text-4xl sm:text-5xl font-extrabold text-[#202020] dark:text-[#fcfcfc] tracking-tight">
        {t.pages.blog.heading}
      </h1>
      <p class="text-base sm:text-lg text-[#575757] dark:text-zinc-300 max-w-2xl mx-auto leading-relaxed">
        {t.pages.blog.subheading}
      </p>
    </div>

    <!-- Category Filters -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-10">
      <span class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-[#ea2804]/10 text-[#ea2804] dark:bg-[#ea2804]/20 dark:text-[#ff6a3d] border border-[#ea2804]/20">
        {t.common.all} ({articles.length})
      </span>
      {categories.map(cat => (
        <span class={`px-3.5 py-1.5 rounded-full text-xs font-semibold ${categoryColors[cat] || 'bg-zinc-500/10 text-zinc-600 dark:text-zinc-400'}`}>
          {getCategoryLabel(cat)} ({articles.filter(a => a.category === cat).length})
        </span>
      ))}
    </div>

    <!-- Articles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {articles.map((article) => (
        <a href={getLocalizedPath(article.slug, currentLocale)} class="group block">
          <GlassCard variant="card" class="h-full p-6 transition-all duration-200 group-hover:shadow-lg group-hover:border-[#ea2804]/20 dark:group-hover:border-[#ea2804]/30">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class={`inline-block px-2.5 py-0.5 rounded-full text-[10px] font-semibold ${categoryColors[article.category] || 'bg-zinc-500/10 text-zinc-600'}`}>
                  {getCategoryLabel(article.category)}
                </span>
                <time class="text-[10px] font-mono text-[#8d8d8d] dark:text-zinc-500" datetime={article.date}>
                  {formatDate(article.date)}
                </time>
              </div>

              <h2 class="font-display text-base font-bold text-[#202020] dark:text-[#fcfcfc] leading-snug group-hover:text-[#ea2804] dark:group-hover:text-[#ff6a3d] transition-colors">
                {article.title}
              </h2>

              <p class="text-xs text-[#575757] dark:text-zinc-400 leading-relaxed line-clamp-3">
                {article.description}
              </p>

              <div class="flex items-center gap-1.5 text-xs font-semibold text-[#ea2804] dark:text-[#ff6a3d] pt-1">
                <span>{t.common.readArticle}</span>
                <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
              </div>
            </div>
          </GlassCard>
        </a>
      ))}
    </div>

    <!-- Back to Home -->
    <div class="text-center mt-12">
      <a
        href={homeUrl}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-semibold bg-white/80 dark:bg-zinc-800/80 border border-black/10 dark:border-white/10 text-[#202020] dark:text-[#fcfcfc] hover:bg-white dark:hover:bg-zinc-700 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
        {t.common.backToHome}
      </a>
    </div>
  </section>
</Layout>
